---
import AppShell from "@layouts/AppShell.astro";
import MetaRow from "@components/ui/MetaRow.astro";
import SectionHeader from "@components/ui/SectionHeader.astro";
import { getLangFromUrl, useTranslations } from "@i18n/utils";
import type { UIKey } from "@i18n/ui";
import snapshot from "../../content/data/livebench.json";
import { defaultFilters, scoreShades, visibleModels, type Category, type Model } from "./filters";

const data = snapshot as unknown as {
	sourceSha: string;
	syncedAt: string;
	release: string;
	categories: Category[];
	models: Model[];
};
const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
const categoryLabels: Record<string, UIKey> = {
	Reasoning: "benchmarks.cat.reasoning",
	Coding: "benchmarks.cat.coding",
	"Agentic Coding": "benchmarks.cat.agenticCoding",
	Mathematics: "benchmarks.cat.mathematics",
	"Data Analysis": "benchmarks.cat.dataAnalysis",
	Language: "benchmarks.cat.language",
	IF: "benchmarks.cat.if",
};
const categoryName = (category: Category) =>
	categoryLabels[category.id] ? t(categoryLabels[category.id]) : category.name;
const models = visibleModels(data.models, defaultFilters());
const initialShades = scoreShades(models, ["overall", ...data.categories.map((category) => category.id)], []);
const scoreText = (score: number | null | undefined) => score == null ? "—" : score.toFixed(1);
const organizations = [...new Set(data.models.map((model) => model.organization))].sort((a, b) => a.localeCompare(b));
const syncedAt = new Date(data.syncedAt);
const syncedLabel = Number.isNaN(syncedAt.getTime())
	? data.syncedAt
	: new Intl.DateTimeFormat(lang === "zh" ? "zh-CN" : "en-US", {
			dateStyle: "medium", timeStyle: "short", timeZone: "UTC",
		}).format(syncedAt) + " UTC";
const sourceUrl = `https://github.com/LiveBench/new-livebench/commit/${data.sourceSha}`;
const control = "border border-[color:var(--color-hairline)] bg-transparent px-3 py-2 text-sm text-[color:var(--color-ink-primary)] focus-visible:outline-2 focus-visible:outline-offset-2";
---

<AppShell
	title={t("benchmarks.title")}
	description={t("benchmarks.description")}
	eyebrow={t("benchmarks.eyebrow")}
	leftTitle={t("benchmarks.title")}
	leftDescription={t("benchmarks.description")}
	maxContentWidth="none"
>
	<Fragment slot="left-meta">
		<MetaRow label={t("benchmarks.release")} value={data.release} />
		<MetaRow label={t("benchmarks.syncedAt")} value={syncedLabel} />
		<MetaRow label={t("benchmarks.models")} value={models.length} />
	</Fragment>

	<section id="benchmark-panel" data-lang={lang} aria-labelledby="benchmarks-heading" class="py-8 sm:py-12">
		<SectionHeader id="benchmarks-heading" eyebrow="MODEL BENCHMARKS" title={t("benchmarks.table")} count={models.length} />
		<p class="mt-5 text-sm leading-relaxed text-[color:var(--color-ink-secondary)]">{t("benchmarks.overview")}</p>

		<div class="mt-8 flex flex-wrap items-end gap-3">
			<label class="flex min-w-56 flex-1 flex-col gap-2 sm:max-w-sm" for="benchmark-search">
				<span class="font-[var(--font-mono)] text-xs uppercase tracking-wider text-[color:var(--color-ink-secondary)]">{t("benchmarks.search")}</span>
				<input id="benchmark-search" type="search" name="q" autocomplete="off" placeholder={t("benchmarks.searchPlaceholder")} class={control + " w-full"} />
			</label>
			<label class="flex items-center gap-2 py-2 text-sm"><input id="benchmark-open" type="checkbox" />{t("benchmarks.openWeights")}</label>
			<label class="flex flex-col gap-2 text-sm" for="benchmark-ft">
				<span class="font-[var(--font-mono)] text-xs uppercase tracking-wider text-[color:var(--color-ink-secondary)]">{t("benchmarks.finetune")}</span>
				<select id="benchmark-ft" class={control}>
					<option value="hide">{t("benchmarks.ftHide")}</option>
					<option value="all">{t("benchmarks.ftAll")}</option>
					<option value="only">{t("benchmarks.ftOnly")}</option>
				</select>
			</label>
			<label class="flex items-center gap-2 py-2 text-sm"><input id="benchmark-showorg" type="checkbox" checked />{t("benchmarks.showOrg")}</label>
			<label class="flex flex-col gap-2 text-sm" for="benchmark-org">
				<span class="font-[var(--font-mono)] text-xs uppercase tracking-wider text-[color:var(--color-ink-secondary)]">{t("benchmarks.organization")}</span>
				<select id="benchmark-org" class={control}>
					<option value="">{t("benchmarks.allOrganizations")}</option>
					{organizations.map((org) => <option value={org}>{org}</option>)}
				</select>
			</label>
		</div>

		<div class="mt-5 flex flex-wrap items-start gap-3">
			<details id="benchmark-compare" class="relative">
				<summary class={control + " cursor-pointer list-none"}>{t("benchmarks.compare")} <span id="benchmark-compare-count" /></summary>
				<div class="absolute left-0 z-20 mt-1 w-[min(22rem,calc(100vw-3rem))] border border-[color:var(--color-hairline)] bg-[color:var(--color-paper)] p-3 shadow-lg">
					<p class="mb-2 text-xs text-[color:var(--color-ink-secondary)]">{t("benchmarks.compareCount")}</p>
					<div class="max-h-64 space-y-1 overflow-y-auto" role="group" aria-label={t("benchmarks.compare")}>
						{[...data.models].sort((a, b) => a.name.localeCompare(b.name)).map((model) => (
							<label class="flex items-start gap-2 py-1 text-sm"><input type="checkbox" data-compare={model.id} class="mt-1" /><span>{model.name} <small class="text-[color:var(--color-ink-tertiary)]">({model.organization})</small></span></label>
						))}
					</div>
					<div class="mt-3 flex flex-wrap gap-2">
						<button id="benchmark-compare-apply" type="button" class={control}>{t("benchmarks.compareApply")}</button>
						<button id="benchmark-compare-clear" type="button" class={control}>{t("benchmarks.compareClear")}</button>
					</div>
				</div>
			</details>
			<details id="benchmark-columns" class="relative">
				<summary class={control + " cursor-pointer list-none"}>{t("benchmarks.columns")}</summary>
				<div class="absolute left-0 z-20 mt-1 max-h-[60vh] w-[min(23rem,calc(100vw-3rem))] overflow-y-auto border border-[color:var(--color-hairline)] bg-[color:var(--color-paper)] p-3 shadow-lg">
					<p class="mb-2 text-xs text-[color:var(--color-ink-secondary)]">{t("benchmarks.columns")}</p>
					<label class="flex gap-2 py-1 text-sm"><input type="checkbox" data-column="overall" checked />{t("benchmarks.overall")}</label>
					{data.categories.map((category) => (
						<div class="border-t border-[color:var(--color-hairline)] py-2">
							<label class="flex gap-2 text-sm font-medium"><input type="checkbox" data-group={category.id} checked />{categoryName(category)}</label>
							<div class="mt-1 grid grid-cols-1 gap-1 pl-5">
								<label class="flex gap-2 text-sm"><input type="checkbox" data-column={category.id} checked />{categoryName(category)}</label>
								{category.subtasks.map((task) => <label class="flex gap-2 text-sm"><input type="checkbox" data-column={task} checked />{t(`benchmarks.task.${task}` as UIKey)}</label>)}
							</div>
						</div>
					))}
					<button id="benchmark-columns-reset" type="button" class={control}>{t("benchmarks.columnsReset")}</button>
				</div>
			</details>
			<p class="ml-auto self-center font-[var(--font-mono)] text-xs text-[color:var(--color-ink-secondary)]" role="status" aria-live="polite">
				{t("benchmarks.results")}: <span id="benchmark-count">{models.length}</span>
			</p>
		</div>

		<div class="mt-5 flex flex-wrap items-center gap-2" role="group" aria-label={t("benchmarks.categories")}>
			<button type="button" data-cat="all" aria-pressed="true" class={control}>{t("benchmarks.allCategories")}</button>
			{data.categories.map((category) => <button type="button" data-cat={category.id} aria-pressed="false" class={control}>{categoryName(category)}</button>)}
		</div>

		<div class="mt-5 max-w-full overflow-x-auto border-y border-[color:var(--color-hairline)]" tabindex="0" role="region" aria-label={t("benchmarks.table")}>
			<table id="benchmark-table" class="w-full min-w-[760px] border-collapse text-left text-sm">
				<caption class="sr-only">{t("benchmarks.table")} — {data.release}</caption>
				<thead><tr class="border-b border-[color:var(--color-hairline)] bg-[color:var(--color-paper-muted)]/40 font-[var(--font-mono)] text-xs text-[color:var(--color-ink-secondary)]">
					<th scope="col" class="px-3 py-3 font-normal">{t("benchmarks.rank")}</th>
					<th scope="col" class="min-w-52 px-3 py-3 font-normal">{t("benchmarks.model")}</th>
					<th scope="col" class="px-3 py-3 font-normal">{t("benchmarks.organization")}</th>
					{["overall", ...data.categories.map((category) => category.id)].map((column) => <th scope="col" aria-sort={column === "overall" ? "descending" : "none"} class="px-3 py-3 text-right font-normal"><button type="button" data-sort={column} class="whitespace-nowrap underline-offset-4 hover:underline focus-visible:underline">{column === "overall" ? t("benchmarks.overall") : categoryName(data.categories.find((category) => category.id === column)!)} <span aria-hidden="true">↕</span></button></th>)}
				</tr></thead>
				<tbody>{models.map((model, index) => <tr data-model-id={model.id} class="border-b border-dashed border-[color:var(--color-hairline)] last:border-0 hover:bg-[color:var(--color-paper-muted)]/40">
					<td class="px-3 py-3 font-[var(--font-mono)] tabular-nums text-[color:var(--color-ink-tertiary)]">{index + 1}</td>
					<th scope="row" class="px-3 py-3 font-medium text-[color:var(--color-ink-primary)]">{model.name}</th>
					<td class="px-3 py-3 text-[color:var(--color-ink-secondary)]">{model.organization}</td>
					<td style={{ backgroundColor: initialShades.get("overall")?.get(model.id) }} class="px-3 py-3 text-right font-[var(--font-mono)] font-semibold tabular-nums">{scoreText(model.overall)}</td>
					{data.categories.map((category) => <td style={{ backgroundColor: initialShades.get(category.id)?.get(model.id) }} class="px-3 py-3 text-right font-[var(--font-mono)] tabular-nums text-[color:var(--color-ink-secondary)]" title={model.scores[category.id] == null ? t("benchmarks.noScore") : undefined}>{scoreText(model.scores[category.id])}</td>)}
				</tr>)}</tbody>
			</table>
		</div>
		<p id="benchmark-empty" hidden={models.length !== 0} class="py-8 text-center text-sm text-[color:var(--color-ink-secondary)]" role="status">{t("benchmarks.noResults")}</p>
		<p class="mt-6 border-l-2 border-[color:var(--color-hairline)] pl-4 text-sm leading-relaxed text-[color:var(--color-ink-secondary)]">{t("benchmarks.method")}</p>
		<p class="mt-3 text-xs text-[color:var(--color-ink-tertiary)]">{t("benchmarks.source")}: <a href={sourceUrl} target="_blank" rel="noopener noreferrer" class="underline underline-offset-4 hover:text-[color:var(--color-ink-primary)]">LiveBench/new-livebench @ {data.sourceSha.slice(0, 8)}</a></p>
	</section>
</AppShell>

<style>
	button[data-cat] { transition: background-color 120ms, color 120ms, border-color 120ms; }
	button[data-cat][aria-pressed="true"] {
		background-color: var(--color-ink-primary);
		color: var(--color-paper);
		border-color: var(--color-ink-primary);
		font-weight: 600;
	}
	@media (prefers-reduced-motion: reduce) { button[data-cat] { transition: none; } }
</style>

<script>
	import snapshot from "../../content/data/livebench.json";
	import { ui, type UIKey, type Lang } from "@i18n/ui";
	import { cycleSort, modelScore, normalizeFilters, parseFilters, scoreColumns, scoreShades, serializeFilters, visibleModels, type Category, type Model } from "./filters";

	const data = snapshot as unknown as { categories: Category[]; models: Model[] };
	const categoryKeys: Record<string, UIKey> = {
		Reasoning: "benchmarks.cat.reasoning", Coding: "benchmarks.cat.coding", "Agentic Coding": "benchmarks.cat.agenticCoding",
		Mathematics: "benchmarks.cat.mathematics", "Data Analysis": "benchmarks.cat.dataAnalysis", Language: "benchmarks.cat.language", IF: "benchmarks.cat.if",
	};

	function initBenchmarkTable() {
		const panel = document.querySelector<HTMLElement>("#benchmark-panel")!;
		if (!panel || panel.dataset.initialized) return;
		panel.dataset.initialized = "true";
		const lang = panel.dataset.lang as Lang;
		const text = (key: UIKey) => ui[lang][key] ?? ui.zh[key];
		const label = (column: string) => column === "overall" ? text("benchmarks.overall") : categoryKeys[column] ? text(categoryKeys[column]) : ui[lang][`benchmarks.task.${column}` as UIKey] ?? column;
		const table = panel.querySelector<HTMLTableElement>("#benchmark-table")!;
		const search = panel.querySelector<HTMLInputElement>("#benchmark-search")!;
		const open = panel.querySelector<HTMLInputElement>("#benchmark-open")!;
		const ft = panel.querySelector<HTMLSelectElement>("#benchmark-ft")!;
		const showorg = panel.querySelector<HTMLInputElement>("#benchmark-showorg")!;
		const org = panel.querySelector<HTMLSelectElement>("#benchmark-org")!;
		const comparePanel = panel.querySelector<HTMLDetailsElement>("#benchmark-compare")!;
		const columnsPanel = panel.querySelector<HTMLDetailsElement>("#benchmark-columns")!;
		const count = panel.querySelector<HTMLElement>("#benchmark-count")!;
		const empty = panel.querySelector<HTMLElement>("#benchmark-empty")!;
		const abort = new AbortController();
		const listener = { signal: abort.signal };
		let state = parseFilters(new URLSearchParams(location.search), data.categories, data.models);

		function syncControls() {
			search.value = state.q;
			open.checked = state.open;
			ft.value = state.ft;
			showorg.checked = state.showorg;
			org.value = state.org;
			for (const input of comparePanel.querySelectorAll<HTMLInputElement>("input[data-compare]")) input.checked = state.compare.includes(input.dataset.compare!);
			for (const input of columnsPanel.querySelectorAll<HTMLInputElement>("input[data-column]")) input.checked = !state.hide.includes(input.dataset.column!);
			for (const category of data.categories) {
				const group = [...columnsPanel.querySelectorAll<HTMLInputElement>("input[data-group]")].find((input) => input.dataset.group === category.id)!;
				const checked = [category.id, ...category.subtasks].filter((column) => !state.hide.includes(column)).length;
				group.checked = checked === category.subtasks.length + 1;
				group.indeterminate = checked > 0 && !group.checked;
			}
			for (const button of panel.querySelectorAll<HTMLButtonElement>("button[data-cat]")) button.setAttribute("aria-pressed", String(button.dataset.cat === "all" ? !state.cats.length : state.cats.includes(button.dataset.cat!)));
			panel.querySelector<HTMLElement>("#benchmark-compare-count")!.textContent = state.compare.length ? ` (${state.compare.length})` : "";
		}

		function render(updateUrl: boolean) {
			state = normalizeFilters(state, data.categories, data.models);
			const columns = scoreColumns(data.categories, state.cats).filter((column) => !state.hide.includes(column));
			const rows = visibleModels(data.models, state);
			const shades = scoreShades(rows, columns, state.cats);
			const heading = document.createElement("tr");
			heading.className = "border-b border-[color:var(--color-hairline)] bg-[color:var(--color-paper-muted)]/40 font-[var(--font-mono)] text-xs text-[color:var(--color-ink-secondary)]";
			for (const name of [text("benchmarks.rank"), text("benchmarks.model"), ...(state.showorg ? [text("benchmarks.organization")] : [])]) {
				const th = document.createElement("th"); th.scope = "col"; th.className = "px-3 py-3 font-normal"; th.textContent = name; heading.append(th);
			}
			for (const column of columns) {
				const th = document.createElement("th"); th.scope = "col"; th.className = "px-3 py-3 text-right font-normal";
				th.setAttribute("aria-sort", column === state.sort ? (state.dir === "asc" ? "ascending" : "descending") : "none");
				const button = document.createElement("button"); button.type = "button"; button.dataset.sort = column;
				button.className = "whitespace-nowrap underline-offset-4 hover:underline focus-visible:underline";
				button.setAttribute("aria-label", `${text("benchmarks.sortBy")}: ${label(column)}`);
				button.textContent = `${label(column)} ${column === state.sort && state.dir !== "default" ? (state.dir === "asc" ? "↑" : "↓") : "↕"}`;
				th.append(button); heading.append(th);
			}
			table.tHead!.replaceChildren(heading);
			const fragment = document.createDocumentFragment();
			rows.forEach((model, index) => {
				const tr = document.createElement("tr"); tr.dataset.modelId = model.id;
				tr.className = "border-b border-dashed border-[color:var(--color-hairline)] last:border-0 hover:bg-[color:var(--color-paper-muted)]/40";
				const rank = document.createElement("td"); rank.className = "px-3 py-3 font-[var(--font-mono)] tabular-nums text-[color:var(--color-ink-tertiary)]"; rank.textContent = String(index + 1); tr.append(rank);
				const name = document.createElement("th"); name.scope = "row"; name.className = "px-3 py-3 font-medium text-[color:var(--color-ink-primary)]"; name.textContent = model.name; tr.append(name);
				if (state.showorg) { const organization = document.createElement("td"); organization.className = "px-3 py-3 text-[color:var(--color-ink-secondary)]"; organization.textContent = model.organization; tr.append(organization); }
				for (const column of columns) {
					const td = document.createElement("td"); td.className = "px-3 py-3 text-right font-[var(--font-mono)] tabular-nums text-[color:var(--color-ink-secondary)]";
					const score = modelScore(model, column, state.cats); td.textContent = score == null ? "—" : score.toFixed(1);
					td.style.backgroundColor = shades.get(column)?.get(model.id) ?? "";
					if (score == null) td.title = text("benchmarks.noScore");
					tr.append(td);
				}
				fragment.append(tr);
			});
			table.tBodies[0].replaceChildren(fragment);
			count.textContent = String(rows.length);
			empty.hidden = rows.length !== 0;
			syncControls();
			if (updateUrl) {
				const url = new URL(location.href);
				url.search = serializeFilters(url.searchParams, state, data.categories, data.models).toString();
				history.replaceState(history.state, "", url);
			}
			for (const link of document.querySelectorAll<HTMLAnchorElement>(".lang-toggle a[href]")) {
				const target = new URL(link.href); target.search = location.search; target.hash = location.hash; link.href = target.href;
			}
		}

		search.addEventListener("input", () => { state.q = search.value; render(true); }, listener);
		open.addEventListener("change", () => { state.open = open.checked; render(true); }, listener);
		ft.addEventListener("change", () => { state.ft = ft.value as typeof state.ft; render(true); }, listener);
		showorg.addEventListener("change", () => { state.showorg = showorg.checked; render(true); }, listener);
		org.addEventListener("change", () => { state.org = org.value; render(true); }, listener);
		panel.addEventListener("click", (event) => {
			const target = event.target as HTMLElement;
			const cat = target.closest<HTMLButtonElement>("button[data-cat]");
			if (cat) { state.cats = cat.dataset.cat === "all" ? [] : state.cats.includes(cat.dataset.cat!) ? state.cats.filter((id) => id !== cat.dataset.cat) : [...state.cats, cat.dataset.cat!]; state.dir = "default"; render(true); return; }
			const sort = target.closest<HTMLButtonElement>("button[data-sort]");
			if (sort) { state = cycleSort(state, sort.dataset.sort!); render(true); }
		}, listener);
		comparePanel.addEventListener("toggle", () => { if (comparePanel.open) syncControls(); }, listener);
		panel.querySelector("#benchmark-compare-apply")!.addEventListener("click", () => {
			state.compare = [...comparePanel.querySelectorAll<HTMLInputElement>("input[data-compare]:checked")].map((input) => input.dataset.compare!);
			comparePanel.open = false; render(true);
		}, listener);
		panel.querySelector("#benchmark-compare-clear")!.addEventListener("click", () => { state.compare = []; comparePanel.open = false; render(true); }, listener);
		columnsPanel.addEventListener("change", (event) => {
			const input = event.target as HTMLInputElement;
			if (!input.matches("input[data-column], input[data-group]")) return;
			const category = data.categories.find((entry) => entry.id === input.dataset.group);
			const keys = category ? [category.id, ...category.subtasks] : [input.dataset.column!];
			const hidden = new Set(state.hide);
			for (const key of keys) input.checked ? hidden.delete(key) : hidden.add(key);
			state.hide = [...hidden]; render(true);
		}, listener);
		panel.querySelector("#benchmark-columns-reset")!.addEventListener("click", () => { state.hide = []; render(true); }, listener);
		window.addEventListener("popstate", () => { state = parseFilters(new URLSearchParams(location.search), data.categories, data.models); render(false); }, listener);
		document.addEventListener("astro:before-swap", () => abort.abort(), { once: true, signal: abort.signal });
		render(true);
	}
	initBenchmarkTable();
	document.addEventListener("astro:after-swap", initBenchmarkTable);
</script>
