---
/**
 * ============================================================================
 * BenchmarksPage - LiveBench 双语榜单
 * ----------------------------------------------------------------------------
 *   PageHero   超大标题 + CTA          ┌ aside:当前榜首领奖台 ┐
 *              SpecStrip:版本 / 同步 / 模型 / 机构 / 类别 / 来源
 *   01 full    查询控制台 + 全宽表格(一体化仪表盘,表头在表格滚动区内吸顶)
 *   02 full    Bento:总分前五(与表格同色阶)+ 各类别冠军 + 开放权重榜首
 *   03 split   方法与来源(履历条目)
 *
 * 脚本依赖的 id / data-* 钩子(#benchmark-panel 及其内部控件)保持不变。
 * ============================================================================
 */
import AppShell from "@layouts/AppShell.astro";
import PageHero from "@components/layout/PageHero.astro";
import CvSection from "@components/layout/CvSection.astro";
import type { SpecItem } from "@components/layout/SpecStrip.astro";
import { getLangFromUrl, useTranslations } from "@i18n/utils";
import type { UIKey } from "@i18n/ui";
import snapshot from "../../content/data/livebench.json";
import { defaultFilters, scoreShades, visibleModels, type Category, type Model } from "./filters";

const data = snapshot as unknown as {
	sourceSha: string;
	syncedAt: string;
	release: string;
	sourceUrl: string;
	unofficial: boolean;
	categories: Category[];
	models: Model[];
};
const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
const categoryLabels: Record<string, UIKey> = {
	Reasoning: "benchmarks.cat.reasoning",
	Coding: "benchmarks.cat.coding",
	"Agentic Coding": "benchmarks.cat.agenticCoding",
	Mathematics: "benchmarks.cat.mathematics",
	"Data Analysis": "benchmarks.cat.dataAnalysis",
	Language: "benchmarks.cat.language",
	IF: "benchmarks.cat.if",
};
const categoryName = (category: Category) =>
	categoryLabels[category.id] ? t(categoryLabels[category.id]) : category.name;
const models = visibleModels(data.models, defaultFilters());
const initialShades = scoreShades(models, ["overall", ...data.categories.map((category) => category.id)], []);
const scoreText = (score: number | null | undefined) => score == null ? "—" : score.toFixed(1);
const organizations = [...new Set(data.models.map((model) => model.organization))].sort((a, b) => a.localeCompare(b));
const syncedAt = new Date(data.syncedAt);
const syncedValid = !Number.isNaN(syncedAt.getTime());
const syncedLabel = syncedValid
	? new Intl.DateTimeFormat(lang === "zh" ? "zh-CN" : "en-US", {
			dateStyle: "medium", timeStyle: "short", timeZone: "UTC",
		}).format(syncedAt) + " UTC"
	: data.syncedAt;
const syncedDate = syncedValid ? syncedAt.toISOString().slice(0, 10) : data.syncedAt;
const sourceUrl = `https://github.com/LiveBench/new-livebench/commit/${data.sourceSha}`;
const shortSha = data.sourceSha.slice(0, 7);
const zh = lang === "zh";
const overallShades = initialShades.get("overall");
const topTints = [...(overallShades?.values() ?? [])];
const columnIds = ["overall", ...data.categories.map((category) => category.id)];
const chevron = "M6 9l6 6 6-6";
const pct = (score: number) => `${Math.max(0, Math.min(100, score)).toFixed(1)}%`;

/* ---------- 领奖台:默认视图前三 ---------- */
const podium = models.slice(0, 3);
const leader = podium[0];
const leadMargin = leader && podium[1] ? leader.overall - podium[1].overall : null;

/* ---------- Bento:总分前五 / 各类别冠军 / 开放权重榜首 ---------- */
const topFive = models.slice(0, 5);
const categoryLeaders = data.categories.map((category) => {
	let best: { model: Model; score: number } | null = null;
	for (const model of models) {
		const score = model.scores[category.id];
		if (score != null && (!best || score > best.score)) best = { model, score };
	}
	return { category, best };
});
const openLeader = models.find((model) => model.openWeights);
const visibleOrgCount = new Set(models.map((model) => model.organization)).size;

const spec: SpecItem[] = [
	{ label: t("benchmarks.release"), value: data.release },
	{ label: t("benchmarks.syncedAt"), value: syncedDate, live: true },
	{ label: t("benchmarks.models"), count: models.length },
	{ label: t("benchmarks.organization"), count: visibleOrgCount },
	{ label: t("benchmarks.categories"), count: data.categories.length },
	{ label: t("benchmarks.source"), value: `@${shortSha}`, href: sourceUrl },
];

const C = zh
	? {
			jump: "查询榜单",
			podium: "当前榜首",
			podiumSub: "默认视图 · 总分",
			lead: "领先第二名",
			console: "查询控制台",
			top5: "每列前五",
			leadersLabel: "类别冠军",
			leadersNote: "默认视图(隐藏微调、折叠变体)下各类别最高分。点击卡片,在榜单中展开该类别的子任务。",
			top5Title: "总分前五",
			top5Note: "色阶与表格一致:蓝色由深到浅",
			subtasks: "项子任务",
			openTitle: "开放权重榜首",
			openCta: "只看开放权重",
			methodLabel: "方法与来源",
			method: "方法",
			shading: "着色",
			shadingText: "按当前可见结果,每列前五名以蓝色由深到浅标出;缺失成绩不着色。",
			sync: "同步",
			status: "性质",
			statusText: "非官方同步快照,仅展示最新评测版本。",
			noLeader: "暂无成绩",
		}
	: {
			jump: "Query the board",
			podium: "Current leader",
			podiumSub: "Default view · overall",
			lead: "Lead over #2",
			console: "Query console",
			top5: "Top 5 / column",
			leadersLabel: "Category leaders",
			leadersNote: "Highest score per category in the default view (fine-tunes hidden, variants folded). Open a card to expand that category's subtasks in the board.",
			top5Title: "Overall top five",
			top5Note: "Same shading as the table: blue, dark to light",
			subtasks: "subtasks",
			openTitle: "Open-weights leader",
			openCta: "Open weights only",
			methodLabel: "Method & source",
			method: "Method",
			shading: "Shading",
			shadingText: "Within the visible results, each column's top five are shaded blue from dark to light; missing scores stay blank.",
			sync: "Sync",
			status: "Status",
			statusText: "Unofficial synced snapshot showing the latest evaluation release only.",
			noLeader: "No scores",
		};
---

<AppShell title={t("benchmarks.title")} description={t("benchmarks.description")}>
	<PageHero eyebrow={t("benchmarks.eyebrow")} description={t("benchmarks.description")} spec={spec}>
		<Fragment slot="title">
			{zh ? <>AI 模型<span class="text-signal">能力</span>榜</> : <>AI Model <span class="serif-accent">Benchmarks</span></>}
		</Fragment>

		<Fragment slot="actions">
			<a href="#leaderboard" class="btn btn-primary group">
				{C.jump}
				<svg aria-hidden="true" width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="bm-nudge"><path d="M12 5v14M5 12l7 7 7-7" /></svg>
			</a>
			<a href={data.sourceUrl} target="_blank" rel="noopener noreferrer" class="btn btn-ghost">LiveBench ↗</a>
		</Fragment>

		{leader && (
			<aside slot="aside" class="bm-podium surface-card crop-marks spotlight" data-spotlight aria-labelledby="bm-podium-title">
				<div class="bm-podium__head">
					<span id="bm-podium-title" class="mono-label">{C.podium}</span>
					<span aria-hidden="true" class="bm-rule"></span>
					<span class="chip chip-signal">#01</span>
				</div>
				<div class="px-5 pt-5">
					<p class="mono-label text-[10.5px] text-[color:var(--color-ink-muted)]">{C.podiumSub}</p>
					<p class="bm-podium__score mt-2">{leader.overall.toFixed(1)}</p>
					<p class="mt-3 text-[17px] font-semibold leading-snug tracking-[-0.02em]">{leader.name}</p>
					<p class="mt-0.5 font-[var(--font-mono)] text-[11.5px] text-[color:var(--color-ink-tertiary)]">{leader.organization}</p>
					<div class="meter mt-4" aria-hidden="true"><span data-animate style={{ width: pct(leader.overall) }} /></div>
				</div>
				<ol class="bm-podium__list" start="2" aria-label={zh ? "第二、三名" : "Runners-up"}>
					{podium.slice(1).map((model, index) => (
						<li>
							<span class="bm-podium__rank">{String(index + 2).padStart(2, "0")}</span>
							<span class="min-w-0">
								<span class="block truncate text-[13.5px] font-medium text-[color:var(--color-ink-primary)]">{model.name}</span>
								<span class="block truncate font-[var(--font-mono)] text-[11px] text-[color:var(--color-ink-tertiary)]">{model.organization}</span>
							</span>
							<span class="bm-podium__num">{model.overall.toFixed(1)}</span>
						</li>
					))}
				</ol>
				{leadMargin != null && (
					<p class="bm-podium__foot">
						<span>{C.lead}</span>
						<span class="text-[color:var(--color-signal)]">+{leadMargin.toFixed(2)}</span>
					</p>
				)}
			</aside>
		)}
	</PageHero>

	{/* ================= 01 · 查询控制台 + 全宽榜单 ================= */}
	<CvSection
		id="leaderboard"
		index="01"
		label={t("benchmarks.table")}
		sublabel={`LiveBench · ${data.release}`}
		note={t("benchmarks.overview")}
		layout="full"
		class="bm-anchor"
	>
		<div id="benchmark-panel" data-lang={lang}>
			<div class="bm-deck reveal-scroll">
				{/* 顶栏:终端提示符 + 实时匹配计数 */}
				<div class="bm-deck__bar">
					<span class="font-[var(--font-mono)] text-[12px] text-[color:var(--color-ink-tertiary)]">
						<span aria-hidden="true" class="text-[color:var(--color-signal)]">$ </span>livebench query <span class="text-[color:var(--color-ink-muted)]">--release {data.release}</span>
					</span>
					<span aria-hidden="true" class="bm-rule hidden sm:block"></span>
					<p class="bm-status" role="status" aria-live="polite">
						<span class="dot-live" aria-hidden="true"></span>
						<span>{t("benchmarks.results")}</span>
						<span id="benchmark-count" class="bm-status__num">{models.length}</span>
					</p>
				</div>

				{/* 查询行:搜索跨宽,筛选紧随 */}
				<div class="bm-deck__query">
					<label class="flex min-w-0 flex-col gap-1.5" for="benchmark-search">
						<span class="bm-label">{t("benchmarks.search")}</span>
						<span class="bm-field">
							<svg aria-hidden="true" class="bm-field__icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><circle cx="11" cy="11" r="7" /><path d="m20 20-3.5-3.5" /></svg>
							<input id="benchmark-search" type="search" name="q" autocomplete="off" spellcheck="false" placeholder={t("benchmarks.searchPlaceholder")} class="bm-control bm-control--search w-full" />
						</span>
					</label>
					<label class="flex min-w-0 flex-col gap-1.5" for="benchmark-ft">
						<span class="bm-label">{t("benchmarks.finetune")}</span>
						<span class="bm-field">
							<select id="benchmark-ft" class="bm-control bm-control--select w-full">
								<option value="hide">{t("benchmarks.ftHide")}</option>
								<option value="all">{t("benchmarks.ftAll")}</option>
								<option value="only">{t("benchmarks.ftOnly")}</option>
							</select>
							<svg aria-hidden="true" class="bm-field__chevron" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d={chevron} /></svg>
						</span>
					</label>
					<label class="flex min-w-0 flex-col gap-1.5" for="benchmark-org">
						<span class="bm-label">{t("benchmarks.organization")}</span>
						<span class="bm-field">
							<select id="benchmark-org" class="bm-control bm-control--select w-full">
								<option value="">{t("benchmarks.allOrganizations")}</option>
								{organizations.map((org) => <option value={org}>{org}</option>)}
							</select>
							<svg aria-hidden="true" class="bm-field__chevron" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d={chevron} /></svg>
						</span>
					</label>
					<div class="flex flex-wrap items-end gap-2">
						<label class="bm-toggle"><input id="benchmark-open" type="checkbox" />{t("benchmarks.openWeights")}</label>
						<label class="bm-toggle"><input id="benchmark-showorg" type="checkbox" checked />{t("benchmarks.showOrg")}</label>
					</div>
				</div>

				{/* 类别:选中 = 反色 + 加粗,无底线 */}
				<div class="bm-deck__cats">
					<span class="bm-label" aria-hidden="true">{t("benchmarks.categories")}</span>
					<div class="flex flex-wrap items-center gap-1.5" role="group" aria-label={t("benchmarks.categories")}>
						<button type="button" data-cat="all" aria-pressed="true" class="bm-cat">{t("benchmarks.allCategories")}</button>
						{data.categories.map((category) => <button type="button" data-cat={category.id} aria-pressed="false" class="bm-cat">{categoryName(category)}</button>)}
					</div>
				</div>

				{/* 工具:对比 / 列 + 色阶图例 */}
				<div class="bm-deck__tools">
					<details id="benchmark-compare" class="bm-pop-host">
						<summary class="bm-control bm-summary">{t("benchmarks.compare")}<span id="benchmark-compare-count" class="bm-summary__count" /><svg aria-hidden="true" class="bm-summary__chevron" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d={chevron} /></svg></summary>
						<div class="bm-pop w-[min(22rem,calc(100vw-3rem))]">
							<p class="bm-label mb-2">{t("benchmarks.compareCount")}</p>
							<div class="scroll-thin max-h-64 space-y-0.5 overflow-y-auto pr-1" role="group" aria-label={t("benchmarks.compare")}>
								{[...data.models].sort((a, b) => a.name.localeCompare(b.name)).map((model) => (
									<label class="bm-option"><input type="checkbox" data-compare={model.id} /><span>{model.name} <small class="text-[color:var(--color-ink-tertiary)]">({model.organization})</small></span></label>
								))}
							</div>
							<div class="mt-3 flex flex-wrap gap-2 border-t border-[color:var(--color-hairline)] pt-3">
								<button id="benchmark-compare-apply" type="button" class="btn btn-primary btn-sm">{t("benchmarks.compareApply")}</button>
								<button id="benchmark-compare-clear" type="button" class="btn btn-ghost btn-sm">{t("benchmarks.compareClear")}</button>
							</div>
						</div>
					</details>
					<details id="benchmark-columns" class="bm-pop-host">
						<summary class="bm-control bm-summary">{t("benchmarks.columns")}<svg aria-hidden="true" class="bm-summary__chevron" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d={chevron} /></svg></summary>
						<div class="bm-pop scroll-thin max-h-[60vh] w-[min(23rem,calc(100vw-3rem))] overflow-y-auto">
							<p class="bm-label mb-2">{t("benchmarks.columns")}</p>
							<label class="bm-option"><input type="checkbox" data-column="overall" checked />{t("benchmarks.overall")}</label>
							{data.categories.map((category) => (
								<div class="mt-1 border-t border-[color:var(--color-hairline)] pt-2 pb-1">
									<label class="bm-option font-semibold text-[color:var(--color-ink-primary)]"><input type="checkbox" data-group={category.id} checked />{categoryName(category)}</label>
									<div class="ml-2 grid grid-cols-1 border-l border-[color:var(--color-hairline)] pl-3">
										<label class="bm-option"><input type="checkbox" data-column={category.id} checked />{categoryName(category)}</label>
										{category.subtasks.map((task) => <label class="bm-option"><input type="checkbox" data-column={task} checked />{t(`benchmarks.task.${task}` as UIKey)}</label>)}
									</div>
								</div>
							))}
							<div class="mt-2 border-t border-[color:var(--color-hairline)] pt-3">
								<button id="benchmark-columns-reset" type="button" class="btn btn-ghost btn-sm">{t("benchmarks.columnsReset")}</button>
							</div>
						</div>
					</details>
					<span class="bm-legend ml-auto">
						<span>{C.top5}</span>
						<span class="bm-legend__swatches" aria-hidden="true">
							{topTints.map((tint) => <span style={{ backgroundColor: tint }} />)}
						</span>
					</span>
				</div>

				{/* 全宽数据表:滚动区内表头吸顶,排名/模型列吸左 */}
				<div class="bm-scroll scroll-thin" tabindex="0" role="region" aria-label={t("benchmarks.table")}>
					<table id="benchmark-table" class="bm-table">
						<caption class="sr-only">{t("benchmarks.table")} — {data.release}</caption>
						<thead><tr>
							<th scope="col" class="bt-th bt-th--rank">{t("benchmarks.rank")}</th>
							<th scope="col" class="bt-th bt-th--name">{t("benchmarks.model")}</th>
							<th scope="col" class="bt-th">{t("benchmarks.organization")}</th>
							{columnIds.map((column) => {
								const name = column === "overall" ? t("benchmarks.overall") : categoryName(data.categories.find((category) => category.id === column)!);
								return <th scope="col" aria-sort={column === "overall" ? "descending" : "none"} class="bt-th bt-th--num"><button type="button" data-sort={column} class="bt-sort" aria-label={`${t("benchmarks.sortBy")}: ${name}`}>{name}<span class="bt-sort__icon" aria-hidden="true">↕</span></button></th>;
							})}
						</tr></thead>
						<tbody>{models.map((model, index) => <tr data-model-id={model.id}>
							<td class="bt-rank">{String(index + 1).padStart(2, "0")}</td>
							<th scope="row" class="bt-name">{model.name}</th>
							<td class="bt-org">{model.organization}</td>
							<td style={{ backgroundColor: overallShades?.get(model.id) }} class:list={["bt-score bt-score--lead", { "is-empty": model.overall == null }]}>{scoreText(model.overall)}</td>
							{data.categories.map((category) => <td style={{ backgroundColor: initialShades.get(category.id)?.get(model.id) }} class:list={["bt-score", { "is-empty": model.scores[category.id] == null }]} title={model.scores[category.id] == null ? t("benchmarks.noScore") : undefined}>{scoreText(model.scores[category.id])}</td>)}
						</tr>)}</tbody>
					</table>
				</div>
				<p id="benchmark-empty" hidden={models.length !== 0} class="bm-empty" role="status"><span class="mono-label mb-2 block text-[color:var(--color-ink-muted)]">0 rows · no match</span>{t("benchmarks.noResults")}</p>
			</div>
		</div>
	</CvSection>

	{/* ================= 02 · 类别冠军 Bento ================= */}
	<CvSection index="02" label={C.leadersLabel} sublabel="Category leaders · default view" note={C.leadersNote} layout="full">
		<div class="bm-bento">
			{/* 大格:总分前五,色阶与表格一致 */}
			<section class="bm-cell bm-cell--hero surface-card reveal-scroll" aria-labelledby="bm-top5-title">
				<div class="flex items-baseline justify-between gap-4">
					<h3 id="bm-top5-title" class="text-[20px] font-semibold tracking-[-0.03em]">{C.top5Title}</h3>
					<span class="mono-label text-[10.5px] text-[color:var(--color-ink-muted)]">{t("benchmarks.overall")}</span>
				</div>
				<p class="mt-1 text-[13px] text-[color:var(--color-ink-tertiary)]">{C.top5Note}</p>
				<ol class="bm-top5 mt-6">
					{topFive.map((model, index) => (
						<li style={{ backgroundColor: overallShades?.get(model.id) }}>
							<span class="bm-top5__rank">{String(index + 1).padStart(2, "0")}</span>
							<span class="min-w-0">
								<span class="block truncate text-[14px] font-semibold tracking-[-0.01em]">{model.name}</span>
								<span class="block truncate font-[var(--font-mono)] text-[11px] text-[color:var(--color-ink-tertiary)]">{model.organization}</span>
							</span>
							<span class="bm-top5__score">{model.overall.toFixed(1)}</span>
						</li>
					))}
				</ol>
			</section>

			{categoryLeaders.map(({ category, best }, index) => (
				<a
					href={`?cats=${encodeURIComponent(category.id)}#leaderboard`}
					class="bm-cell surface-card spotlight reveal-scroll"
					data-spotlight
					style={`--i: ${index}`}
				>
					<span class="flex items-center justify-between gap-3 font-[var(--font-mono)] text-[10.5px] uppercase tracking-[var(--tracking-wider)] text-[color:var(--color-ink-muted)]">
						<span><span class="text-[color:var(--color-signal)]">C{index + 1}</span> · {category.subtasks.length} {C.subtasks}</span>
						<svg aria-hidden="true" width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" class="bm-cell__arrow"><path d="M5 12h14M12 5l7 7-7 7" /></svg>
					</span>
					<span class="mt-3 block text-[18px] font-semibold tracking-[-0.025em]">{categoryName(category)}</span>
					{best ? (
						<>
							<span class="bm-cell__score">{best.score.toFixed(1)}</span>
							<span class="block truncate text-[13px] font-medium text-[color:var(--color-ink-secondary)]">{best.model.name}</span>
							<span class="block truncate font-[var(--font-mono)] text-[11px] text-[color:var(--color-ink-tertiary)]">{best.model.organization}</span>
							<span class="meter mt-4 block" aria-hidden="true"><span data-animate style={{ width: pct(best.score) }} /></span>
						</>
					) : (
						<span class="mt-auto block pt-6 text-[13px] text-[color:var(--color-ink-muted)]">{C.noLeader}</span>
					)}
				</a>
			))}

			{openLeader && (
				<a href="?open=1#leaderboard" class="bm-cell bm-cell--open surface-card spotlight reveal-scroll" data-spotlight>
					<span class="flex items-center justify-between gap-3 font-[var(--font-mono)] text-[10.5px] uppercase tracking-[var(--tracking-wider)] text-[color:var(--color-ink-muted)]">
						<span class="text-[color:var(--color-live)]">● {t("benchmarks.openWeights")}</span>
						<svg aria-hidden="true" width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" class="bm-cell__arrow"><path d="M5 12h14M12 5l7 7-7 7" /></svg>
					</span>
					<span class="mt-3 block text-[18px] font-semibold tracking-[-0.025em]">{C.openTitle}</span>
					<span class="bm-cell__score">{openLeader.overall.toFixed(1)}</span>
					<span class="block truncate text-[13px] font-medium text-[color:var(--color-ink-secondary)]">{openLeader.name}</span>
					<span class="block truncate font-[var(--font-mono)] text-[11px] text-[color:var(--color-ink-tertiary)]">{openLeader.organization} · {C.openCta} →</span>
				</a>
			)}
		</div>
	</CvSection>

	{/* ================= 03 · 方法与来源 ================= */}
	<CvSection
		index="03"
		label={C.methodLabel}
		sublabel="Method / provenance"
		linkText={`LiveBench @ ${shortSha}`}
		linkHref={sourceUrl}
	>
		<dl class="bm-method">
			<div>
				<dt>{C.method}</dt>
				<dd>{t("benchmarks.method")}</dd>
			</div>
			<div>
				<dt>{C.shading}</dt>
				<dd>
					<span class="bm-legend__swatches bm-legend__swatches--lg mb-3" aria-hidden="true">
						{topTints.map((tint, index) => <span style={{ backgroundColor: tint }}>{index + 1}</span>)}
					</span>
					<span class="block">{C.shadingText}</span>
				</dd>
			</div>
			<div>
				<dt>{t("benchmarks.source")}</dt>
				<dd>
					<a href={sourceUrl} target="_blank" rel="noopener noreferrer" class="link-underline font-[var(--font-mono)] text-[13px] text-[color:var(--color-ink-primary)]">LiveBench/new-livebench @ {data.sourceSha.slice(0, 8)} ↗</a>
				</dd>
			</div>
			<div>
				<dt>{C.sync}</dt>
				<dd class="font-[var(--font-mono)] text-[13px]">
					<time datetime={data.syncedAt}>{syncedLabel}</time>
					<span class="text-[color:var(--color-ink-muted)]"> · {t("benchmarks.release")} {data.release}</span>
				</dd>
			</div>
			{data.unofficial && (
				<div>
					<dt>{C.status}</dt>
					<dd>{C.statusText}</dd>
				</div>
			)}
		</dl>
	</CvSection>
</AppShell>

<style>
