		display: grid;
		gap: 0.5rem 2rem;
		padding-block: 1.25rem;
		border-top: 1px solid var(--color-hairline);
	}
	.bm-method > div:first-child { border-top: 0; padding-top: 0; }
	@media (min-width: 768px) {
		.bm-method > div { grid-template-columns: 9rem minmax(0, 1fr); }
	}
	.bm-method dt {
		padding-top: 0.2rem;
		font-family: var(--font-mono);
		font-size: 10.5px;
		letter-spacing: 0.06em;
		text-transform: uppercase;
		color: var(--color-ink-tertiary);
	}
	.bm-method dd {
		margin: 0;
		max-width: 64ch;
		font-size: 15px;
		line-height: 1.7;
		color: var(--color-ink-secondary);
	}

	@media (prefers-reduced-motion: reduce) {
		.bm-pop { animation: none; }
	}
</style>

<script>
	import snapshot from "../../content/data/livebench.json";
	import { ui, type UIKey, type Lang } from "@i18n/ui";
	import { cycleSort, modelScore, normalizeFilters, parseFilters, scoreColumns, scoreShades, serializeFilters, visibleModels, type Category, type Model } from "./filters";

	const data = snapshot as unknown as { categories: Category[]; models: Model[] };
	const categoryKeys: Record<string, UIKey> = {
		Reasoning: "benchmarks.cat.reasoning", Coding: "benchmarks.cat.coding", "Agentic Coding": "benchmarks.cat.agenticCoding",
		Mathematics: "benchmarks.cat.mathematics", "Data Analysis": "benchmarks.cat.dataAnalysis", Language: "benchmarks.cat.language", IF: "benchmarks.cat.if",
	};

	function initBenchmarkTable() {
		const panel = document.querySelector<HTMLElement>("#benchmark-panel")!;
		if (!panel || panel.dataset.initialized) return;
		panel.dataset.initialized = "true";
		const lang = panel.dataset.lang as Lang;
		const text = (key: UIKey) => ui[lang][key] ?? ui.zh[key];
		const label = (column: string) => column === "overall" ? text("benchmarks.overall") : categoryKeys[column] ? text(categoryKeys[column]) : ui[lang][`benchmarks.task.${column}` as UIKey] ?? column;
		const table = panel.querySelector<HTMLTableElement>("#benchmark-table")!;
		const search = panel.querySelector<HTMLInputElement>("#benchmark-search")!;
		const open = panel.querySelector<HTMLInputElement>("#benchmark-open")!;
		const ft = panel.querySelector<HTMLSelectElement>("#benchmark-ft")!;
		const showorg = panel.querySelector<HTMLInputElement>("#benchmark-showorg")!;
		const org = panel.querySelector<HTMLSelectElement>("#benchmark-org")!;
		const comparePanel = panel.querySelector<HTMLDetailsElement>("#benchmark-compare")!;
		const columnsPanel = panel.querySelector<HTMLDetailsElement>("#benchmark-columns")!;
		const count = panel.querySelector<HTMLElement>("#benchmark-count")!;
		const empty = panel.querySelector<HTMLElement>("#benchmark-empty")!;
		const abort = new AbortController();
		const listener = { signal: abort.signal };
		let state = parseFilters(new URLSearchParams(location.search), data.categories, data.models);

		function syncControls() {
			search.value = state.q;
			open.checked = state.open;
			ft.value = state.ft;
			showorg.checked = state.showorg;
			org.value = state.org;
			for (const input of comparePanel.querySelectorAll<HTMLInputElement>("input[data-compare]")) input.checked = state.compare.includes(input.dataset.compare!);
			for (const input of columnsPanel.querySelectorAll<HTMLInputElement>("input[data-column]")) input.checked = !state.hide.includes(input.dataset.column!);
			for (const category of data.categories) {
				const group = [...columnsPanel.querySelectorAll<HTMLInputElement>("input[data-group]")].find((input) => input.dataset.group === category.id)!;
				const checked = [category.id, ...category.subtasks].filter((column) => !state.hide.includes(column)).length;
				group.checked = checked === category.subtasks.length + 1;
				group.indeterminate = checked > 0 && !group.checked;
			}
			for (const button of panel.querySelectorAll<HTMLButtonElement>("button[data-cat]")) button.setAttribute("aria-pressed", String(button.dataset.cat === "all" ? !state.cats.length : state.cats.includes(button.dataset.cat!)));
			panel.querySelector<HTMLElement>("#benchmark-compare-count")!.textContent = state.compare.length ? ` (${state.compare.length})` : "";
		}

		function render(updateUrl: boolean) {
			state = normalizeFilters(state, data.categories, data.models);
			const columns = scoreColumns(data.categories, state.cats).filter((column) => !state.hide.includes(column));
			const rows = visibleModels(data.models, state);
			const shades = scoreShades(rows, columns, state.cats);
			const heading = document.createElement("tr");
			const fixed: [string, string][] = [[text("benchmarks.rank"), "bt-th bt-th--rank"], [text("benchmarks.model"), "bt-th bt-th--name"], ...(state.showorg ? [[text("benchmarks.organization"), "bt-th"] as [string, string]] : [])];
			for (const [name, className] of fixed) {
				const th = document.createElement("th"); th.scope = "col"; th.className = className; th.textContent = name; heading.append(th);
			}
			for (const column of columns) {
				const th = document.createElement("th"); th.scope = "col"; th.className = "bt-th bt-th--num";
				th.setAttribute("aria-sort", column === state.sort ? (state.dir === "asc" ? "ascending" : "descending") : "none");
				const button = document.createElement("button"); button.type = "button"; button.dataset.sort = column;
				button.className = "bt-sort";
				button.setAttribute("aria-label", `${text("benchmarks.sortBy")}: ${label(column)}`);
				const icon = document.createElement("span"); icon.className = "bt-sort__icon"; icon.setAttribute("aria-hidden", "true");
				icon.textContent = column === state.sort && state.dir !== "default" ? (state.dir === "asc" ? "↑" : "↓") : "↕";
				button.append(label(column), icon);
				th.append(button); heading.append(th);
			}
			table.tHead!.replaceChildren(heading);
			const fragment = document.createDocumentFragment();
			rows.forEach((model, index) => {
				const tr = document.createElement("tr"); tr.dataset.modelId = model.id;
				const rank = document.createElement("td"); rank.className = "bt-rank"; rank.textContent = String(index + 1).padStart(2, "0"); tr.append(rank);
				const name = document.createElement("th"); name.scope = "row"; name.className = "bt-name"; name.textContent = model.name; tr.append(name);
				if (state.showorg) { const organization = document.createElement("td"); organization.className = "bt-org"; organization.textContent = model.organization; tr.append(organization); }
				columns.forEach((column, columnIndex) => {
					const td = document.createElement("td");
					const score = modelScore(model, column, state.cats); td.textContent = score == null ? "—" : score.toFixed(1);
					td.className = `bt-score${columnIndex === 0 ? " bt-score--lead" : ""}${score == null ? " is-empty" : ""}`;
					td.style.backgroundColor = shades.get(column)?.get(model.id) ?? "";
					if (score == null) td.title = text("benchmarks.noScore");
					tr.append(td);
				});
				fragment.append(tr);
			});
			table.tBodies[0].replaceChildren(fragment);
			count.textContent = String(rows.length);
			empty.hidden = rows.length !== 0;
			syncControls();
			if (updateUrl) {
				const url = new URL(location.href);
				url.search = serializeFilters(url.searchParams, state, data.categories, data.models).toString();
				history.replaceState(history.state, "", url);
			}
			for (const link of document.querySelectorAll<HTMLAnchorElement>(".lang-toggle a[href]")) {
				const target = new URL(link.href); target.search = location.search; target.hash = location.hash; link.href = target.href;
			}
		}

		search.addEventListener("input", () => { state.q = search.value; render(true); }, listener);
		open.addEventListener("change", () => { state.open = open.checked; render(true); }, listener);
		ft.addEventListener("change", () => { state.ft = ft.value as typeof state.ft; render(true); }, listener);
		showorg.addEventListener("change", () => { state.showorg = showorg.checked; render(true); }, listener);
		org.addEventListener("change", () => { state.org = org.value; render(true); }, listener);
		panel.addEventListener("click", (event) => {
			const target = event.target as HTMLElement;
			const cat = target.closest<HTMLButtonElement>("button[data-cat]");
			if (cat) { state.cats = cat.dataset.cat === "all" ? [] : state.cats.includes(cat.dataset.cat!) ? state.cats.filter((id) => id !== cat.dataset.cat) : [...state.cats, cat.dataset.cat!]; state.dir = "default"; render(true); return; }
			const sort = target.closest<HTMLButtonElement>("button[data-sort]");
			if (sort) { state = cycleSort(state, sort.dataset.sort!); render(true); }
		}, listener);
		comparePanel.addEventListener("toggle", () => { if (comparePanel.open) syncControls(); }, listener);
		panel.querySelector("#benchmark-compare-apply")!.addEventListener("click", () => {
			state.compare = [...comparePanel.querySelectorAll<HTMLInputElement>("input[data-compare]:checked")].map((input) => input.dataset.compare!);
			comparePanel.open = false; render(true);
		}, listener);
		panel.querySelector("#benchmark-compare-clear")!.addEventListener("click", () => { state.compare = []; comparePanel.open = false; render(true); }, listener);
		columnsPanel.addEventListener("change", (event) => {
			const input = event.target as HTMLInputElement;
			if (!input.matches("input[data-column], input[data-group]")) return;
			const category = data.categories.find((entry) => entry.id === input.dataset.group);
			const keys = category ? [category.id, ...category.subtasks] : [input.dataset.column!];
			const hidden = new Set(state.hide);
			for (const key of keys) input.checked ? hidden.delete(key) : hidden.add(key);
			state.hide = [...hidden]; render(true);
		}, listener);
		panel.querySelector("#benchmark-columns-reset")!.addEventListener("click", () => { state.hide = []; render(true); }, listener);
		window.addEventListener("popstate", () => { state = parseFilters(new URLSearchParams(location.search), data.categories, data.models); render(false); }, listener);
		document.addEventListener("astro:before-swap", () => abort.abort(), { once: true, signal: abort.signal });
		render(true);
	}
	initBenchmarkTable();
	document.addEventListener("astro:after-swap", initBenchmarkTable);
</script>
