---
/**
 * ============================================================================
 * PostCard - 博客文章卡片(两种形态)
 * ----------------------------------------------------------------------------
 * variant="row"(默认):写作履历时间线的一行。月份由外层分组栏给出,
 * 本行只负责"日"与正文:
 *
 *   ┌──────┬──────────────────────────────────────────┬──────────┐
 *   │  22  │ ENGINEERING                              │   6 MIN  │
 *   │  TUE │ 文章标题(hover 下划线生长)               │      ↗   │
 *   │      │ 一句话摘要,两行截断…                      │          │
 *   │      │ #astro #bun                              │          │
 *   └──────┴──────────────────────────────────────────┴──────────┘
 *
 * variant="feature":封面式大卡(精选 / 最新),用于第 1 页顶部 Bento。
 *   - layout="stack":封面在上、文字在下,封面在 lg 起吃掉剩余高度(Bento 等高)
 *   - layout="split":lg 起左 7/12 封面 + 右 5/12 文字(单张全宽时使用)
 *   - 无图时用 coverLabel 做排版化封面:点阵 + Signal 光晕 + 超大标签
 *
 * 约束:整个卡片是一个 <a>,内部不嵌套链接;动效只动 transform / opacity。
 * ============================================================================
 */

import { getLangFromUrl, useTranslations, formatDateCompact } from "@i18n/utils";
import type { Lang } from "@i18n/ui";

/** 标签数据结构(与 PostVM.tags 的单项一致) */
export interface PostCardTag {
	/** URL slug */
	slug: string;
	/** 展示名(调用方负责 pickLang 解包) */
	name: string;
}

interface Props {
	/** 文章详情页 URL */
	href: string;
	/** 文章标题(纯文本,也用于 aria-label / 封面 alt) */
	title: string;
	/** 简介 */
	excerpt?: string;
	/** 封面图 URL(仅 feature 形态展示;优先级高于 coverLabel) */
	cover?: string | null;
	/** 封面图 alt 文本 */
	coverAlt?: string;
	/** 排版化封面上的大字标签 */
	coverLabel?: string;
	/** 作者姓名(feature 形态展示) */
	authorName?: string;
	/** 发布日期(ISO 8601 字符串或 Date) */
	date: string | Date;
	/** 标签列表 */
	tags?: readonly PostCardTag[];
	/** 分类名 */
	categoryName?: string;
	/** 阅读时长(分钟) */
	readingTime?: number;
	/** 形态 */
	variant?: "row" | "feature";
	/** feature 形态的版式 */
	layout?: "stack" | "split";
	/** feature 形态左上角徽标(如"精选" / "最新") */
	badge?: string;
	/** 徽标是否用 Signal 强调(精选) */
	badgeSignal?: boolean;
	/** 额外类名 */
	class?: string;
	/** 额外内联样式(如 reveal 的 --i) */
	style?: string;
	/** 最多显示多少个标签,超出以 +N 表示(默认 3) */
	maxTags?: number;
}

const {
	href,
	title,
	excerpt,
	cover,
	coverAlt,
	coverLabel,
	authorName,
	date,
	tags = [],
	categoryName,
	readingTime,
	variant = "row",
	layout = "stack",
	badge,
	badgeSignal = false,
	class: className = "",
	style,
	maxTags = 3,
} = Astro.props;

const lang = getLangFromUrl(Astro.url) as Lang;
const t = useTranslations(lang);

const compact = formatDateCompact(date); // YYYY-MM-DD(与全站日期同一时区口径)
const dottedDate = compact.replaceAll("-", ".");
const day = compact.slice(8, 10);
const isoDate = new Date(date).toISOString();

const WEEKDAYS = {
	zh: ["周日", "周一", "周二", "周三", "周四", "周五", "周六"],
	en: ["SUN", "MON", "TUE", "WED", "THU", "FRI", "SAT"],
} as const;
const weekday = WEEKDAYS[lang][new Date(date).getDay()] ?? "";

const visibleTags = tags.slice(0, maxTags);
const hiddenTagCount = Math.max(0, tags.length - maxTags);
const moreTagsLabel =
	lang === "zh" ? `另有 ${hiddenTagCount} 个标签` : `${hiddenTagCount} more tags`;

const hasReadingTime = typeof readingTime === "number" && readingTime > 0;
const readLabel = lang === "zh" ? "阅读全文" : "Read";

const isSplit = layout === "split";
const placeholderLabel = coverLabel || title;
---

{
	variant === "feature" ? (
		<a
			href={href}
			aria-label={title}
			data-spotlight
			style={style}
			class:list={[
				"post-card post-card--feature",
				"surface-card spotlight",
				"group flex h-full flex-col overflow-hidden no-underline",
				isSplit && "lg:grid lg:grid-cols-12",
				className,
			]}
		>
			{/* ---------------- 封面 ---------------- */}
			<div
				class:list={[
					"post-card__cover relative overflow-hidden",
					"bg-[color:var(--color-paper-muted)]",
					"border-b border-[color:var(--color-hairline)]",
					isSplit
						? "aspect-[16/10] lg:col-span-7 lg:aspect-auto lg:min-h-[380px] lg:border-b-0 lg:border-r"
						: "aspect-[16/10] lg:aspect-auto lg:min-h-[220px] lg:flex-1",
				]}
			>
				{cover ? (
					<img
						src={cover}
						alt={coverAlt ?? title}
						loading="lazy"
						decoding="async"
						class="post-card__img absolute inset-0 h-full w-full object-cover"
					/>
				) : (
					<div aria-hidden="true" class="absolute inset-0">
						<span class="dot-grid absolute inset-0 opacity-70" />
						<span class="post-card__glow absolute" />
						<div class="relative flex h-full flex-col justify-end gap-4 p-6 lg:p-8">
							<span
								class:list={[
									"post-card__label display line-clamp-3 max-w-[18ch]",
									isSplit
										? "text-[34px] sm:text-[44px] lg:text-[56px]"
										: "text-[28px] sm:text-[36px] lg:text-[44px]",
								]}
							>
								{placeholderLabel}
							</span>
							<span class="block h-[2px] w-12 rounded-full bg-[image:var(--gradient-signal)]" />
						</div>
					</div>
				)}

				{/* 左上:徽标;右上:mono 刻度 */}
				<div class="absolute inset-x-4 top-4 z-10 flex items-center justify-between gap-3">
					{badge ? (
						<span
							class:list={[
								"chip uppercase tracking-[var(--tracking-wide)]",
								badgeSignal && "chip-signal",
							]}
						>
							<span
								aria-hidden="true"
								class:list={[
									"h-[5px] w-[5px] rounded-[1px]",
									badgeSignal
										? "bg-[color:var(--color-signal)]"
										: "bg-[color:var(--color-ink-muted)]",
								]}
							/>
							{badge}
						</span>
					) : (
						<span />
					)}
					<span aria-hidden="true" class="mono-num text-[10.5px] text-[color:var(--color-ink-muted)]">
						ZX / {dottedDate}
					</span>
				</div>
			</div>

			{/* ---------------- 文字 ---------------- */}
			<div
				class:list={[
					"flex min-w-0 flex-col gap-3 p-6 lg:p-7",
					isSplit && "lg:col-span-5 lg:justify-end lg:p-9",
				]}
			>
				<div
					class:list={[
						"flex flex-wrap items-center gap-x-2 gap-y-1",
						"font-[var(--font-mono)] text-[11px] uppercase leading-none",
						"tracking-[var(--tracking-wide)] tabular-nums",
						"text-[color:var(--color-ink-tertiary)]",
					]}
				>
					<time datetime={isoDate} class="text-[color:var(--color-ink-secondary)]">
						{dottedDate}
					</time>
					{categoryName && (
						<>
							<span aria-hidden="true" class="text-[color:var(--color-ink-faint)]">/</span>
							<span>{categoryName}</span>
						</>
					)}
					{hasReadingTime && (
						<>
							<span aria-hidden="true" class="text-[color:var(--color-ink-faint)]">/</span>
							<span>
								{readingTime} {t("blog.minutes")}
							</span>
						</>
					)}
				</div>

				<h3
					class:list={[
						"post-card__heading clamp-3 font-semibold",
						"text-[color:var(--color-ink-primary)]",
						isSplit
							? "text-[26px] sm:text-[30px] lg:text-[34px] leading-[1.1] tracking-[-0.035em]"
							: "text-[22px] sm:text-[24px] lg:text-[26px] leading-[1.16] tracking-[-0.03em]",
					]}
				>
					<span class="post-card__title">{title}</span>
				</h3>

				{excerpt && (
					<p class="clamp-3 max-w-[60ch] text-[14.5px] leading-[1.65] text-[color:var(--color-ink-secondary)]">
						{excerpt}
					</p>
				)}

				<div class="mt-auto flex flex-wrap items-center gap-2 pt-4">
					{authorName && (
						<span class="mr-1 font-[var(--font-mono)] text-[11px] tracking-[var(--tracking-wide)] text-[color:var(--color-ink-tertiary)]">
							@{authorName}
						</span>
					)}
					{visibleTags.length > 0 && (
						<ul class="m-0 flex list-none flex-wrap items-center gap-1.5 p-0">
							{visibleTags.map((tag) => (
								<li class="chip">
									<span aria-hidden="true" class="text-[color:var(--color-ink-muted)]">#</span>
									{tag.name}
								</li>
							))}
							{hiddenTagCount > 0 && (
								<li class="chip tabular-nums" aria-label={moreTagsLabel}>
									+{hiddenTagCount}
								</li>
							)}
						</ul>
					)}
					<span
						aria-hidden="true"
						class="ml-auto inline-flex items-center gap-1.5 font-[var(--font-mono)] text-[11px] uppercase leading-none tracking-[var(--tracking-wider)] text-[color:var(--color-ink-primary)]"
					>
						{readLabel}
						<svg class="post-card__arrow" width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
							<path d="M5 12h14" />
							<path d="m12 5 7 7-7 7" />
						</svg>
					</span>
				</div>
			</div>
		</a>
	) : (
		<a
			href={href}
			aria-label={title}
			style={style}
			class:list={[
				"post-card post-card--row",
				"group relative isolate grid no-underline",
				"grid-cols-[3.25rem_minmax(0,1fr)] sm:grid-cols-[4rem_minmax(0,1fr)_6.5rem]",
				"gap-x-5 sm:gap-x-8 gap-y-2",
				"py-6 lg:py-7",
				className,
			]}
		>
			{/* ---------------- 日 ---------------- */}
			<div class="flex flex-col items-start gap-1.5 pt-[2px]">
				<time
					datetime={isoDate}
					class="post-card__day text-[28px] font-semibold leading-none tracking-[-0.04em] tabular-nums lg:text-[32px]"
				>
					<span class="sr-only">{dottedDate}</span>
					<span aria-hidden="true">{day}</span>
				</time>
				<span aria-hidden="true" class="mono-label text-[10px] leading-none text-[color:var(--color-ink-muted)]">
					{weekday}
				</span>
			</div>

			{/* ---------------- 正文 ---------------- */}
			<div class="flex min-w-0 flex-col gap-2">
				{categoryName && (
					<span class="mono-label text-[10.5px] leading-none text-[color:var(--color-ink-tertiary)]">
						{categoryName}
					</span>
				)}
				<h3 class="post-card__heading clamp-2 pr-8 text-[18px] font-semibold leading-[1.3] tracking-[-0.022em] text-[color:var(--color-ink-primary)] sm:pr-0 lg:text-[20px]">
					<span class="post-card__title">{title}</span>
				</h3>
				{excerpt && (
					<p class="clamp-2 max-w-[68ch] text-[14px] leading-[1.6] text-[color:var(--color-ink-tertiary)]">
						{excerpt}
					</p>
				)}
				{visibleTags.length > 0 && (
					<ul class="m-0 mt-1.5 flex list-none flex-wrap items-center gap-1.5 p-0">
						{visibleTags.map((tag) => (
							<li class="chip">
								<span aria-hidden="true" class="text-[color:var(--color-ink-muted)]">#</span>
								{tag.name}
							</li>
						))}
						{hiddenTagCount > 0 && (
							<li class="chip tabular-nums" aria-label={moreTagsLabel}>
								+{hiddenTagCount}
							</li>
						)}
					</ul>
				)}
				{hasReadingTime && (
					<span class="mt-1 font-[var(--font-mono)] text-[10.5px] uppercase leading-none tracking-[var(--tracking-wide)] tabular-nums text-[color:var(--color-ink-tertiary)] sm:hidden">
						{readingTime} {t("blog.minutes")}
					</span>
				)}
			</div>

			{/* ---------------- 右列:时长 + 箭头 ---------------- */}
			<div class="hidden flex-col items-end justify-between gap-4 pt-[3px] sm:flex">
				{hasReadingTime && (
					<span class="font-[var(--font-mono)] text-[10.5px] uppercase leading-none tracking-[var(--tracking-wide)] tabular-nums text-[color:var(--color-ink-tertiary)]">
						{readingTime} {t("blog.minutes")}
					</span>
				)}
				<span aria-hidden="true" class="post-card__go inline-flex h-7 w-7 items-center justify-center text-[color:var(--color-ink-primary)]">
					<svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
						<path d="M7 17 17 7" />
						<path d="M8 7h9v9" />
					</svg>
				</span>
			</div>
		</a>
	)
}

<style>
	/* ---------------- 截断 ---------------- */
	.clamp-2,
	.clamp-3 {
		display: -webkit-box;
		-webkit-box-orient: vertical;
		overflow: hidden;
	}
	.clamp-2 {
		-webkit-line-clamp: 2;
	}
	.clamp-3 {
		-webkit-line-clamp: 3;
	}

	/* ---------------- 标题下划线生长(整卡 hover / 聚焦时触发) ---------------- */
	.post-card__title {
		background-image: linear-gradient(currentColor, currentColor);
		background-size: 0% 1px;
		background-position: 0 100%;
		background-repeat: no-repeat;
		transition: background-size var(--duration-slow) var(--ease-out-expo);
	}
	.post-card:hover .post-card__title,
	.post-card:focus-visible .post-card__title {
		background-size: 100% 1px;
	}

	/* ================= 时间线行 ================= */

	/* hover 底色:伪元素 opacity 淡入,略微外扩,不影响排版 */
	.post-card--row::before {
		content: "";
		position: absolute;
		inset: 0.375rem -0.875rem;
		z-index: -1;
		border-radius: var(--radius-md);
		background-color: var(--color-surface);
		box-shadow: 0 0 0 1px var(--color-hairline);
		opacity: 0;
		transform: scale(0.985);
		transition:
			opacity var(--duration-base) var(--ease-standard),
			transform var(--duration-slow) var(--ease-out-expo);
	}
	.post-card--row:hover::before,
	.post-card--row:focus-visible::before {
		opacity: 1;
		transform: none;
	}
	.post-card--row:focus-visible {
		outline-offset: 4px;
		border-radius: var(--radius-md);
	}

	.post-card__day {
		color: var(--color-ink-secondary);
		transition: color var(--duration-fast) var(--ease-standard);
	}
	.post-card--row:hover .post-card__day,
	.post-card--row:focus-visible .post-card__day {
		color: var(--color-signal);
	}

	.post-card__go {
		opacity: 0;
		transform: translate3d(-6px, 6px, 0);
		transition:
			opacity var(--duration-base) var(--ease-standard),
			transform var(--duration-slow) var(--ease-out-expo);
	}
	.post-card--row:hover .post-card__go,
	.post-card--row:focus-visible .post-card__go {
		opacity: 1;
		transform: none;
	}

	/* ================= 封面大卡 ================= */

	.post-card__img,
	.post-card__label {
		transition: transform var(--duration-reveal) var(--ease-out-expo);
	}
	.post-card--feature:hover .post-card__img {
		transform: scale(1.03);
	}
	.post-card--feature:hover .post-card__label {
		transform: translate3d(0, -4px, 0);
	}

	/* 排版化封面右上角的 Signal 光晕:静态渐变,hover 只动 transform / opacity */
	.post-card__glow {
		top: -40%;
		right: -20%;
		width: 80%;
		aspect-ratio: 1;
		border-radius: 999px;
		background: radial-gradient(
			closest-side,
			color-mix(in oklab, var(--color-signal) 22%, transparent),
			color-mix(in oklab, var(--color-signal-2) 8%, transparent) 55%,
			transparent
		);
		opacity: 0.8;
		transition:
			opacity var(--duration-slow) var(--ease-standard),
			transform var(--duration-reveal) var(--ease-out-expo);
	}
	.post-card--feature:hover .post-card__glow {
		opacity: 1;
		transform: translate3d(-4%, 4%, 0) scale(1.08);
	}

	.post-card__arrow {
		transition: transform var(--duration-base) var(--ease-out-expo);
	}
	.post-card--feature:hover .post-card__arrow {
		transform: translate3d(3px, 0, 0);
	}
</style>
