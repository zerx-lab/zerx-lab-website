---
/**
 * ============================================================================
 * Logo - ZerxLab 品牌标识
 * ----------------------------------------------------------------------------
 * 标记:墨色圆角方块内反白一笔 "Z",右上角一枚 Signal 信号点(在线 / 智能)。
 * 字标:Mono 大写 "ZERX" + 淡色 "LAB",中间以细竖线分隔,像终端里的主机名。
 *
 *   <Logo />               当前语言首页链接
 *   <Logo size="sm" />
 *   <Logo href={false} />  父级已是链接时渲染为 span,避免嵌套 <a>
 * ============================================================================
 */

import { getLangFromUrl, useTranslatedPath, useTranslations } from "@i18n/utils";

interface Props {
	/** 尺寸档位 */
	size?: "sm" | "md" | "lg";
	/** 链接地址;false 表示不包成链接 */
	href?: string | false;
	/** 根元素类型 */
	as?: "a" | "span" | "div";
	/** 额外类名 */
	class?: string;
}

const { size = "md", href, as, class: className = "" } = Astro.props;

const lang = getLangFromUrl(Astro.url);
const tp = useTranslatedPath(lang);
const t = useTranslations(lang);

const resolvedHref =
	href === false ? null : typeof href === "string" ? href : tp("/");

const Tag = as ?? (resolvedHref ? "a" : "span");

const sizeMap = {
	sm: { mark: "h-[18px] w-[18px]", text: "text-[11.5px]", gap: "gap-2" },
	md: { mark: "h-[22px] w-[22px]", text: "text-[12.5px]", gap: "gap-2.5" },
	lg: { mark: "h-7 w-7", text: "text-[15px]", gap: "gap-3" },
} as const;

const sizes = sizeMap[size as keyof typeof sizeMap];

// "ZERX-LAB" → ["ZERX", "LAB"]
const brandName = t("brand.name");
const [brandHead, brandTail] = brandName.split("-");
---

<Tag
	href={Tag === "a" ? resolvedHref : undefined}
	aria-label={brandName}
	class:list={[
		"logo group inline-flex items-center select-none",
		sizes.gap,
		"text-[color:var(--color-ink-primary)]",
		className,
	]}
>
	<span aria-hidden="true" class:list={["relative inline-block shrink-0", sizes.mark]}>
		<svg viewBox="0 0 24 24" fill="none" class="h-full w-full overflow-visible">
			<rect x="0" y="0" width="24" height="24" rx="6" fill="currentColor"></rect>
			<path
				d="M7.5 8h9l-9 8h9"
				stroke="var(--color-paper)"
				stroke-width="2.1"
				stroke-linecap="round"
				stroke-linejoin="round"
			></path>
			<circle class="logo__signal" cx="21.5" cy="2.5" r="3.4" fill="var(--color-signal)" stroke="var(--color-paper)" stroke-width="1.6"></circle>
		</svg>
	</span>

	<span
		class:list={[
			"inline-flex items-center gap-1.5 whitespace-nowrap leading-none",
			"font-[var(--font-mono)] font-semibold uppercase tracking-[0.12em]",
			sizes.text,
		]}
	>
		<span>{brandHead}</span>
		{brandTail && (
			<>
				<span aria-hidden="true" class="h-[0.9em] w-px bg-[color:var(--color-hairline-strong)]"></span>
				<span class="font-medium text-[color:var(--color-ink-tertiary)] transition-colors duration-[var(--duration-base)] group-hover:text-[color:var(--color-signal)]">
					{brandTail}
				</span>
			</>
		)}
	</span>
</Tag>

<style>
	.logo__signal {
		transform-box: fill-box;
		transform-origin: center;
		transition: transform var(--duration-slow) var(--ease-spring);
	}
	.logo:hover .logo__signal {
		transform: scale(1.25);
	}
</style>
