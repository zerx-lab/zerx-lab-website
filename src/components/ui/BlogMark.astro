---
/**
 * ============================================================================
 * BlogMark - 博客 PageHero aside 装置(写作分布)
 * ----------------------------------------------------------------------------
 *   ┌ ■ 写作分布 ─────────────────── ZERX-LAB/BLOG ┐
 *   │ 01  工程            ▬▬▬▬▬▬▬▬▬▬▬▬▬▬   32 · 65% │
 *   │ 02  发布            ▬▬▬▬▭▭▭▭▭▭▭▭▭▭    9 · 18% │
 *   │ …                                              │
 *   ├────────────────────────────────────────────────┤
 *   │ 4 个分类                        ■ 49 篇文章     │
 *   └────────────────────────────────────────────────┘
 *
 * - 最多的一类用 Signal 强调;当前正在浏览的分类(activeSlug)行高亮并标注
 * - 条长按"相对最大类"计算,进场时 scaleX 分段展开;纯静态,零 JS
 *
 * 数据契约:
 *   categories: { slug, name, count }[](调用方已排序、已截断)
 *   total:      全部已发布文章数(可能大于各分类之和:未分类文章)
 * ============================================================================
 */

import { getLangFromUrl } from "@i18n/utils";
import type { Lang } from "@i18n/ui";

interface BlogMarkCategory {
	/** 分类 slug */
	readonly slug: string;
	/** 分类显示名(已按当前 lang 解包) */
	readonly name: string;
	/** 该分类下已发布文章数 */
	readonly count: number;
}

interface Props {
	/** 分类列表(调用方已排序,通常按 count 降序) */
	categories: readonly BlogMarkCategory[];
	/** 全部已发布文章数 */
	total: number;
	/** 当前浏览的分类 slug;空串表示全部 */
	activeSlug?: string;
	/** 头部右侧 tag,默认 "ZERX-LAB/BLOG" */
	tagLabel?: string;
	/** 额外类名 */
	class?: string;
}

const {
	categories,
	total,
	activeSlug = "",
	tagLabel = "ZERX-LAB/BLOG",
	class: className = "",
} = Astro.props;

const lang = getLangFromUrl(Astro.url) as Lang;

const COPY = {
	zh: {
		caption: "写作分布",
		empty: "暂无分类",
		categories: "个分类",
		posts: "篇文章",
		viewing: "当前",
		rowLabel: (name: string, count: number, pct: number) =>
			`${name}:${count} 篇,占 ${pct}%`,
	},
	en: {
		caption: "Distribution",
		empty: "No categories",
		categories: "categories",
		posts: "posts",
		viewing: "Viewing",
		rowLabel: (name: string, count: number, pct: number) =>
			`${name}: ${count} posts, ${pct}%`,
	},
} as const;
const C = COPY[lang] ?? COPY.zh;

const maxCount = categories.reduce((acc, c) => Math.max(acc, c.count), 0);

const rows = categories.map((c, i) => {
	const pct = total > 0 ? Math.round((c.count / total) * 100) : 0;
	// 非零至少露出 4%,避免极小分类完全不可见
	const width =
		maxCount > 0 && c.count > 0 ? Math.max(4, (c.count / maxCount) * 100) : 0;
	return {
		...c,
		index: String(i + 1).padStart(2, "0"),
		pct,
		width: `${width.toFixed(1)}%`,
		lead: i === 0 && c.count > 0,
		active: activeSlug !== "" && c.slug === activeSlug,
	};
});
---

<figure
	class:list={[
		"blog-mark surface-card crop-marks",
		"relative m-0 p-5 lg:p-6",
		className,
	]}
>
	<figcaption class="mb-5 flex items-center justify-between gap-3">
		<span class="eyebrow">{C.caption}</span>
		<span class="mono-num text-[10px] uppercase text-[color:var(--color-ink-muted)]">
			{tagLabel}
		</span>
	</figcaption>

	{
		rows.length > 0 ? (
			<ol class="m-0 flex list-none flex-col gap-3.5 p-0">
				{rows.map((r, i) => (
					<li style={`--i: ${i}`} class:list={["bm-row", r.active && "is-active"]}>
						<span class="sr-only">
							{C.rowLabel(r.name, r.count, r.pct)}
							{r.active && ` (${C.viewing})`}
						</span>
						<div aria-hidden="true" class="mb-1.5 flex items-baseline gap-2">
							<span class="mono-num text-[10px] text-[color:var(--color-ink-faint)]">
								{r.index}
							</span>
							<span class="bm-name min-w-0 flex-1 truncate text-[13px] leading-none">
								{r.name}
							</span>
							<span
								class:list={[
									"font-[var(--font-mono)] text-[12px] leading-none tabular-nums",
									r.lead || r.active
										? "text-[color:var(--color-signal)]"
										: "text-[color:var(--color-ink-primary)]",
								]}
							>
								{r.count}
							</span>
							<span class="w-[3.5ch] text-right font-[var(--font-mono)] text-[10px] leading-none tabular-nums text-[color:var(--color-ink-muted)]">
								{r.pct}%
							</span>
						</div>
						<div aria-hidden="true" class="meter">
							<span class="bm-bar" style={`width: ${r.width}`} />
						</div>
					</li>
				))}
			</ol>
		) : (
			<p class="py-3 text-center font-[var(--font-mono)] text-[11px] uppercase tracking-[var(--tracking-wide)] text-[color:var(--color-ink-muted)]">
				{C.empty}
			</p>
		)
	}

	<div
		class:list={[
			"mt-6 flex items-center justify-between border-t pt-3.5",
			"border-[color:var(--color-hairline)]",
			"font-[var(--font-mono)] text-[10px] uppercase leading-none",
			"tracking-[var(--tracking-wide)] tabular-nums",
			"text-[color:var(--color-ink-tertiary)]",
		]}
	>
		<span>
			<span class="text-[color:var(--color-ink-primary)]">{categories.length}</span>
			{" "}{C.categories}
		</span>
		<span class="inline-flex items-center gap-1.5">
			<span aria-hidden="true" class="h-[5px] w-[5px] rounded-[1px] bg-[image:var(--gradient-signal)]" />
			<span class="text-[color:var(--color-ink-primary)]">{total}</span>
			{C.posts}
		</span>
	</div>
</figure>

<style>
	.bm-name {
		color: var(--color-ink-secondary);
	}
	.bm-row.is-active .bm-name {
		color: var(--color-ink-primary);
		font-weight: 600;
	}

	/* 非当前分类在分类视图下退后一层 */
	.blog-mark:has(.is-active) .bm-row:not(.is-active) {
		opacity: 0.55;
	}

	/* 条形进场:按行分段 scaleX 展开(首屏装置,不依赖滚动时间线) */
	.bm-bar {
		animation: bm-grow var(--duration-reveal) var(--ease-out-expo) both;
		animation-delay: calc(var(--i, 0) * 70ms + 320ms);
	}
	@keyframes bm-grow {
		from {
			transform: scaleX(0);
		}
		to {
			transform: scaleX(1);
		}
	}
</style>
