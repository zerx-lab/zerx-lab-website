---
/**
 * ============================================================================
 * Pagination - 通用分页组件
 * ----------------------------------------------------------------------------
 * 履历末尾的"翻页带":三栏
 *
 *   ┌──────────────────┬───────────────────────────┬──────────────────┐
 *   │ ← 上一页          │  01 02 [03] … 12          │          下一页 → │
 *   │ PREV · 02        │  PAGE 03 / 12 · 118 POSTS │        NEXT · 04 │
 *   └──────────────────┴───────────────────────────┴──────────────────┘
 *
 * 前后页是大号可点区块(触控友好),中间 mono 页码,当前页 ink 实底(带
 * view-transition-name,跨页时实底块"滑"到新页码)。移动端页码行在上、
 * 前后页并排在下。
 *
 * URL 约定(路径式分页):
 *   - 第 1 页  → `${basePath}/`
 *   - 第 N 页  → `${basePath}/page/${N}/`
 *   basePath 不带结尾斜杠(如 "/blog" / "/en/blog/cat/news")。
 *
 * 纯静态,无 JS;单页时不渲染;总页数 ≤ 7 全部展开,否则首尾 + 邻近页省略。
 * ============================================================================
 */

import { getLangFromUrl } from "@i18n/utils";

interface Props {
	/** 当前页码(1-indexed) */
	currentPage: number;
	/** 总页数 */
	totalPages: number;
	/** 总条目数(可选,在底部元信息里显示) */
	totalItems?: number;
	/**
	 * 列表页基础路径,不带结尾斜杠,如 "/blog" / "/en/blog" / "/blog/cat/news"。
	 * 第 1 页链接到 `${basePath}/`,第 N 页链接到 `${basePath}/page/${N}/`。
	 */
	basePath: string;
	/** 在两侧显示的边缘页数,默认 1(首尾各 1 页) */
	boundaryCount?: number;
	/** 当前页两侧的邻近页数,默认 1(总共 1 + 1 + 1 = 3 个紧邻页) */
	siblingCount?: number;
	/** 是否显示页码下方的元信息行(Page X of Y) */
	showMeta?: boolean;
	/** 额外类名 */
	class?: string;
}

const {
	currentPage,
	totalPages,
	totalItems,
	basePath,
	boundaryCount = 1,
	siblingCount = 1,
	showMeta = true,
	class: className = "",
} = Astro.props;

// ----------------------------------------------------------------------------
// 参数校验:单页直接不渲染,避免页面冗余
// ----------------------------------------------------------------------------

const shouldRender = totalPages > 1 && currentPage >= 1 && currentPage <= totalPages;

// ----------------------------------------------------------------------------
// i18n
// ----------------------------------------------------------------------------

const lang = getLangFromUrl(Astro.url);

// 本组件专用的短语(不放在全局字典,避免污染)
const LABELS = {
	zh: {
		previous: "上一页",
		next: "下一页",
		pageOf: "第 {current} 页,共 {total} 页",
		items: "篇",
		page: "页码",
		ellipsis: "更多页",
		currentPage: "当前页,第 {n} 页",
		gotoPage: "跳转到第 {n} 页",
		prevShort: "PREV",
		nextShort: "NEXT",
		none: "没有了",
	},
	en: {
		previous: "Previous",
		next: "Next",
		pageOf: "Page {current} of {total}",
		items: "posts",
		page: "Page",
		ellipsis: "More pages",
		currentPage: "Current page, page {n}",
		gotoPage: "Go to page {n}",
		prevShort: "PREV",
		nextShort: "NEXT",
		none: "End",
	},
} as const;

const L = LABELS[lang] ?? LABELS.zh;

// ----------------------------------------------------------------------------
// URL 构造
// ----------------------------------------------------------------------------

/** 根据页码生成路径式链接:第 1 页干净路径,其余页挂 /page/N/ */
function urlForPage(page: number): string {
	return page === 1 ? `${basePath}/` : `${basePath}/page/${page}/`;
}

// ----------------------------------------------------------------------------
// 页码列表生成(含智能省略)
// ----------------------------------------------------------------------------

/**
 * 生成要显示的页码数组,使用 "ellipsis" 字符串标记省略位置。
 *
 * 规则(以 currentPage=6, totalPages=12, boundary=1, sibling=1 为例):
 *   结果: [1, 'ellipsis', 5, 6, 7, 'ellipsis', 12]
 *
 * 边界情况:
 *   - 若 totalPages ≤ boundary*2 + sibling*2 + 3, 直接展示所有页码
 *   - 首尾省略号的出现条件分别独立判断
 */
type PageItem = number | "ellipsis-left" | "ellipsis-right";

function buildPageList(
	current: number,
	total: number,
	boundary: number,
	sibling: number,
): readonly PageItem[] {
	// 窗口总长度: 首边界 + 左省略 + 左兄弟 + 当前 + 右兄弟 + 右省略 + 尾边界
	const windowSize = boundary * 2 + sibling * 2 + 3;

	// 总页数不够支持省略,直接全展开
	if (total <= windowSize) {
		return Array.from({ length: total }, (_, i) => i + 1);
	}

	const leftSiblingStart = Math.max(current - sibling, boundary + 1);
	const rightSiblingEnd = Math.min(current + sibling, total - boundary);

	// 是否需要显示左侧省略号(左兄弟起点距离首边界超过 1)
	const showLeftEllipsis = leftSiblingStart > boundary + 2;
	// 是否需要显示右侧省略号
	const showRightEllipsis = rightSiblingEnd < total - boundary - 1;

	const items: PageItem[] = [];

	// 首边界 (1..boundary)
	for (let i = 1; i <= boundary; i++) {
		items.push(i);
	}

	if (showLeftEllipsis) {
		items.push("ellipsis-left");
	} else {
		// 不省略则把首边界到兄弟起点之间的页码铺满
		for (let i = boundary + 1; i < leftSiblingStart; i++) {
			items.push(i);
		}
	}

	// 兄弟 + 当前 (leftSiblingStart..rightSiblingEnd)
	for (let i = leftSiblingStart; i <= rightSiblingEnd; i++) {
		items.push(i);
	}

	if (showRightEllipsis) {
		items.push("ellipsis-right");
	} else {
		for (let i = rightSiblingEnd + 1; i <= total - boundary; i++) {
			items.push(i);
		}
	}

	// 尾边界 (total-boundary+1..total)
	for (let i = total - boundary + 1; i <= total; i++) {
		items.push(i);
	}

	return items;
}

const pageItems = shouldRender
	? buildPageList(currentPage, totalPages, boundaryCount, siblingCount)
	: [];

// ----------------------------------------------------------------------------
// 前/后页
// ----------------------------------------------------------------------------

const hasPrevious = currentPage > 1;
const hasNext = currentPage < totalPages;
const previousUrl = hasPrevious ? urlForPage(currentPage - 1) : null;
const nextUrl = hasNext ? urlForPage(currentPage + 1) : null;

// ----------------------------------------------------------------------------
// 元信息文案渲染
// ----------------------------------------------------------------------------

const metaText = L.pageOf
	.replace("{current}", String(currentPage))
	.replace("{total}", String(totalPages));

const itemsText =
	typeof totalItems === "number" ? `${totalItems} ${L.items}` : null;

// 格式化页码(两位零填充:01/02/.../99,超过 99 保持原样)
function formatPageNumber(n: number): string {
	return n < 100 ? String(n).padStart(2, "0") : String(n);
}
---

{
	shouldRender && (
		<nav
			aria-label={lang === "zh" ? "分页导航" : "Pagination"}
			class:list={[
				"pagination",
				"grid grid-cols-2 border-t border-[color:var(--color-hairline-strong)]",
				"lg:grid-cols-[minmax(0,1fr)_auto_minmax(0,1fr)]",
				className,
			]}
		>
			{/* 上一页 */}
			<a
				href={previousUrl ?? undefined}
				aria-disabled={hasPrevious ? undefined : "true"}
				aria-label={L.previous}
				tabindex={hasPrevious ? undefined : -1}
				class="pager-block pager-block--prev group order-2 lg:order-none"
			>
				<span class="pager-block__title">
					<svg aria-hidden="true" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="pager-block__icon">
						<path d="m12 19-7-7 7-7" />
						<path d="M19 12H5" />
					</svg>
					{L.previous}
				</span>
				<span aria-hidden="true" class="pager-block__meta">
					{L.prevShort} · {hasPrevious ? formatPageNumber(currentPage - 1) : L.none}
				</span>
			</a>

			{/* 页码 + 进度 */}
			<div class="col-span-2 order-1 flex flex-col items-center justify-center gap-3 border-b border-[color:var(--color-hairline)] px-4 py-6 lg:col-span-1 lg:order-none lg:border-b-0 lg:border-x lg:px-10">
				<ol class="m-0 flex list-none flex-wrap items-center justify-center gap-1 p-0">
					{pageItems.map((item) => {
						if (item === "ellipsis-left" || item === "ellipsis-right") {
							return (
								<li
									aria-hidden="true"
									title={L.ellipsis}
									class="inline-flex h-9 min-w-6 select-none items-center justify-center font-[var(--font-mono)] text-[11px] text-[color:var(--color-ink-muted)]"
								>
									…
								</li>
							);
						}

						const isCurrent = item === currentPage;
						return (
							<li class="inline-flex">
								<a
									href={isCurrent ? undefined : urlForPage(item)}
									aria-current={isCurrent ? "page" : undefined}
									aria-label={
										isCurrent
											? L.currentPage.replace("{n}", String(item))
											: L.gotoPage.replace("{n}", String(item))
									}
									tabindex={isCurrent ? -1 : undefined}
									class="page-item"
								>
									{formatPageNumber(item)}
								</a>
							</li>
						);
					})}
				</ol>

				{showMeta && (
					<p class="m-0 font-[var(--font-mono)] text-[10.5px] uppercase leading-none tracking-[var(--tracking-wide)] tabular-nums text-[color:var(--color-ink-tertiary)]">
						<span class="sr-only">
							{metaText}
							{itemsText && `, ${itemsText}`}
						</span>
						<span aria-hidden="true" class="inline-flex items-center gap-2">
							<span>{L.page}</span>
							<span>
								<span class="text-[color:var(--color-ink-primary)]">
									{formatPageNumber(currentPage)}
								</span>
								<span class="text-[color:var(--color-ink-faint)]"> / </span>
								{formatPageNumber(totalPages)}
							</span>
							{itemsText && (
								<>
									<span class="text-[color:var(--color-ink-faint)]">·</span>
									<span>{itemsText}</span>
								</>
							)}
						</span>
					</p>
				)}
			</div>

			{/* 下一页 */}
			<a
				href={nextUrl ?? undefined}
				aria-disabled={hasNext ? undefined : "true"}
				aria-label={L.next}
				tabindex={hasNext ? undefined : -1}
				class="pager-block pager-block--next group order-3 lg:order-none"
			>
				<span class="pager-block__title">
					{L.next}
					<svg aria-hidden="true" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="pager-block__icon">
						<path d="M5 12h14" />
						<path d="m12 5 7 7-7 7" />
					</svg>
				</span>
				<span aria-hidden="true" class="pager-block__meta">
					{L.nextShort} · {hasNext ? formatPageNumber(currentPage + 1) : L.none}
				</span>
			</a>
		</nav>
	)
}

<style>
	/* ---------------- 前 / 后页区块 ---------------- */
	.pager-block {
		position: relative;
		isolation: isolate;
		display: flex;
		flex-direction: column;
		justify-content: center;
		gap: 0.625rem;
		min-height: 6.5rem;
		padding: 1.5rem 0.25rem;
		user-select: none;
	}
	.pager-block--next {
		align-items: flex-end;
		text-align: right;
	}
	.pager-block::before {
		content: "";
		position: absolute;
		inset: 0.5rem 0.5rem 0.5rem -0.875rem;
		z-index: -1;
		border-radius: var(--radius-md);
		background-color: var(--color-surface);
		box-shadow: 0 0 0 1px var(--color-hairline);
		opacity: 0;
		transition: opacity var(--duration-base) var(--ease-standard);
	}
	.pager-block--next::before {
		inset: 0.5rem -0.875rem 0.5rem 0.5rem;
	}
	.pager-block:hover::before,
	.pager-block:focus-visible::before {
		opacity: 1;
	}

	.pager-block__title {
		display: inline-flex;
		align-items: center;
		gap: 0.625rem;
		font-size: 20px;
		font-weight: 600;
		line-height: 1;
		letter-spacing: -0.03em;
		color: var(--color-ink-primary);
	}
	@media (min-width: 1024px) {
		.pager-block__title {
			font-size: 24px;
		}
	}
	.pager-block__meta {
		font-family: var(--font-mono);
		font-size: 10.5px;
		line-height: 1;
		text-transform: uppercase;
		letter-spacing: var(--tracking-wider);
		font-variant-numeric: tabular-nums;
		color: var(--color-ink-muted);
	}

	.pager-block__icon {
		flex-shrink: 0;
		color: var(--color-signal);
		transition: transform var(--duration-base) var(--ease-out-expo);
	}
	.pager-block--prev:hover .pager-block__icon {
		transform: translate3d(-4px, 0, 0);
	}
	.pager-block--next:hover .pager-block__icon {
		transform: translate3d(4px, 0, 0);
	}

	.pager-block[aria-disabled="true"] {
		pointer-events: none;
	}
	.pager-block[aria-disabled="true"] .pager-block__title,
	.pager-block[aria-disabled="true"] .pager-block__icon {
		color: var(--color-ink-faint);
	}

	/* ---------------- 页码 ---------------- */
	.page-item {
		display: inline-flex;
		align-items: center;
		justify-content: center;
		min-width: 2.25rem;
		height: 2.25rem;
		padding-inline: 0.375rem;
		font-family: var(--font-mono);
		font-size: 12px;
		line-height: 1;
		letter-spacing: var(--tracking-wide);
		font-variant-numeric: tabular-nums;
		color: var(--color-ink-tertiary);
		border-radius: var(--radius-sm);
		user-select: none;
		transition:
			color var(--duration-fast) var(--ease-standard),
			background-color var(--duration-fast) var(--ease-standard);
	}
	.page-item:not([aria-current="page"]):hover {
		color: var(--color-ink-primary);
		background-color: var(--color-paper-muted);
	}
	.page-item[aria-current="page"] {
		color: var(--color-paper);
		background-color: var(--color-ink-primary);
		font-weight: 600;
		cursor: default;
		/* 跨文档 View Transition:当前页实底块在翻页间形变移动 */
		view-transition-name: vt-page-current;
	}
</style>
