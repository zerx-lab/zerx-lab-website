---
/**
 * ============================================================================
 * LanguageToggle - 语言切换器
 * ----------------------------------------------------------------------------
 * 视觉: [ZH|EN] 分段控件,与 ThemeToggle 同款底座,激活项为抬起的小底片
 * 行为: 保留当前页面位置(stripLangFromPath + 语言前缀重组),纯静态链接,零 JS
 * ============================================================================
 */

import { getLangFromUrl, listLanguageLinks } from "@i18n/utils";
import type { Lang } from "@i18n/ui";

interface Props {
	/** 额外类名 */
	class?: string;
}

const { class: className = "" } = Astro.props;

const currentLang = getLangFromUrl(Astro.url);
const links = listLanguageLinks(Astro.url);

const shortLabel: Record<Lang, string> = {
	zh: "ZH",
	en: "EN",
};
---

<div
	role="group"
	aria-label={currentLang === "zh" ? "语言切换" : "Language switcher"}
	class:list={[
		"lang-toggle inline-flex items-center p-0.5 gap-0.5",
		"rounded-[var(--radius-md)] bg-[color:var(--color-paper-muted)]",
		"select-none",
		className,
	]}
>
	{
		links.map((link) => (
			<a
				href={link.href}
				hreflang={link.code === "zh" ? "zh-CN" : "en-US"}
				aria-current={link.isActive ? "true" : undefined}
				aria-label={currentLang === "zh" ? `切换到 ${link.label}` : `Switch to ${link.label}`}
				data-lang={link.code}
				class:list={[
					"inline-flex items-center justify-center h-7 min-w-8 px-2 rounded-[6px]",
					"font-[var(--font-mono)] text-[10.5px] font-medium leading-none tracking-[var(--tracking-wider)]",
					"transition-[color,background-color,box-shadow] duration-[var(--duration-base)] ease-[var(--ease-standard)]",
					link.isActive
						? "lang-toggle__active text-[color:var(--color-ink-primary)]"
						: "text-[color:var(--color-ink-muted)] hover:text-[color:var(--color-ink-primary)]",
				]}
			>
				{shortLabel[link.code]}
			</a>
		))
	}
</div>

<style>
	.lang-toggle__active {
		background-color: var(--color-surface-raised);
		box-shadow:
			0 0 0 1px var(--color-hairline),
			0 1px 2px rgba(0, 0, 0, 0.08);
	}
</style>
