---
/**
 * ============================================================================
 * AboutPage - 关于页(/about 与 /en/about 共享)
 * ----------------------------------------------------------------------------
 * 实验室的完整简历:
 *   PageHero  超大开场句(serif 强调词)+ 描述 + 社交 CTA
 *             aside:档案卡(站名 / 标语 / 方向 / 主力语言)
 *             spec :STARS / REPOS / CONTRIBUTORS / SINCE / LOCATION / LICENSE
 *   01 概述   引导段 + 叙述 + 三栏工程原则(超大键名)
 *   02 数据   全宽 Bento:Stars 巨型格(2×2)+ 仓库 / AUR / 贡献者
 *   03 社区   不对称平台卡片(4/2 · 2/4)+ 联络规格条(邮箱 / GitHub / 回复时效)
 *   04 技术栈 全宽:首位语言超大百分比 + 堆叠色条 + 双列图例
 *
 * 联系 CTA 统一由全站页脚提供,本页不重复。
 * 数据:站点设置 / 实时计数 / 语言占比均在构建期读取。
 * ============================================================================
 */

import AppShell from "@layouts/AppShell.astro";
import PageHero from "@components/layout/PageHero.astro";
import CvSection from "@components/layout/CvSection.astro";
import SpecStrip, { type SpecItem } from "@components/layout/SpecStrip.astro";
import {
	getLangFromUrl,
	useTranslations,
	useTranslatedPath,
} from "@i18n/utils";
import type { Lang } from "@i18n/ui";
import { loadLanguageStats } from "@lib/content";
import { loadLiveCounts } from "@lib/queries/projects";
import { loadSiteSettings } from "@lib/queries/site-settings";

/* ----------------------------------------------------------------------------
 * 当前语言 / 翻译工具
 * -------------------------------------------------------------------------- */

const lang = getLangFromUrl(Astro.url) as Lang;
const t = useTranslations(lang);
const tp = useTranslatedPath(lang);

// RSS feed URL 按当前语言走:zh → /rss.xml,en → /en/rss.xml
const rssHref = tp("/rss.xml");

/* ----------------------------------------------------------------------------
 * 数据
 * ----------------------------------------------------------------------------
 *   - settings       loadSiteSettings(lang):已按语言解包 tagline / description /
 *                    location / social_* 等字段。
 *   - counts         loadLiveCounts():文章 / 分类取内容仓库,projects /
 *                    totalStars / totalForks 用 GitHub 实时清单覆盖,与首页、
 *                    /projects 同源同数。
 *   - languageStats  loadLanguageStats(),按占比降序。
 * -------------------------------------------------------------------------- */

const settings = await loadSiteSettings(lang);
const [counts, languageStats] = await Promise.all([
	loadLiveCounts(),
	loadLanguageStats(),
]);

const tagline = settings.tagline;
const description = settings.description;
const location = settings.location;
const githubUrl = settings.socialGithub ?? "https://github.com/zerx-lab";
const emailHref = settings.socialEmail ? `mailto:${settings.socialEmail}` : null;

/* ----------------------------------------------------------------------------
 * 格式化辅助
 * -------------------------------------------------------------------------- */

function formatCount(n: number): string {
	if (n < 1000) return String(n);
	if (n < 10000) return `${(n / 1000).toFixed(1)}k`;
	return `${Math.round(n / 1000)}k`;
}

function formatLarge(n: number): string {
	// 超出 count-up 合理位数时的静态大号展示,保留一位小数
	if (n < 1000) return String(n);
	if (n < 1_000_000) return `${(n / 1000).toFixed(n < 10000 ? 2 : 1)}K`;
	return `${(n / 1_000_000).toFixed(1)}M`;
}

const pad2 = (n: number) => String(n).padStart(2, "0");

/** count-up 的合理上限;超过则以静态文本展示 */
const COUNT_UP_MAX = 100_000;

