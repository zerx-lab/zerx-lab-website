} as const;

const C = COPY[lang] ?? COPY.zh;

/* ----------------------------------------------------------------------------
 * 图标(内联 SVG 片段,24×24 视口)
 * -------------------------------------------------------------------------- */

type IconKey =
	| "github"
	| "email"
	| "rss"
	| "star"
	| "repo"
	| "package"
	| "users"
	| "blog";

const GITHUB_PATH =
	'<path d="M12 .3a12 12 0 0 0-3.8 23.4c.6.1.8-.3.8-.6v-2c-3.3.7-4-1.6-4-1.6-.6-1.4-1.4-1.8-1.4-1.8-1-.7.1-.7.1-.7 1.2 0 1.9 1.2 1.9 1.2 1 1.8 2.8 1.3 3.5 1 0-.8.4-1.3.7-1.6-2.7-.3-5.5-1.3-5.5-6 0-1.2.5-2.3 1.3-3.1-.1-.4-.6-1.6.1-3.2 0 0 1-.3 3.3 1.2a11.5 11.5 0 0 1 6 0C17.3 4.7 18.3 5 18.3 5c.7 1.6.2 2.8.1 3.2.8.8 1.3 1.9 1.3 3.1 0 4.6-2.8 5.6-5.5 5.9.5.4.8 1.1.8 2.2v3.3c0 .3.2.7.8.6A12 12 0 0 0 12 .3"/>';

/** filled = 实心图标(fill=currentColor),否则为 2px 描边图标 */
const ICONS: Record<IconKey, { filled: boolean; svg: string }> = {
	github: { filled: true, svg: GITHUB_PATH },
	star: {
		filled: true,
		svg: '<path d="M12 .587l3.668 7.568 8.332 1.151-6.064 5.828 1.48 8.279L12 19.446l-7.416 3.967 1.48-8.279L0 9.306l8.332-1.151z"/>',
	},
	email: {
		filled: false,
		svg: '<path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"/><polyline points="22,6 12,13 2,6"/>',
	},
	rss: {
		filled: false,
		svg: '<path d="M4 11a9 9 0 0 1 9 9"/><path d="M4 4a16 16 0 0 1 16 16"/><circle cx="5" cy="19" r="1"/>',
	},
	repo: {
		filled: false,
		svg: '<path d="M4 19.5A2.5 2.5 0 0 1 6.5 17H20"/><path d="M6.5 2H20v20H6.5A2.5 2.5 0 0 1 4 19.5v-15A2.5 2.5 0 0 1 6.5 2z"/>',
	},
	package: {
		filled: false,
		svg: '<path d="M21 16V8a2 2 0 0 0-1-1.73l-7-4a2 2 0 0 0-2 0l-7 4A2 2 0 0 0 3 8v8a2 2 0 0 0 1 1.73l7 4a2 2 0 0 0 2 0l7-4A2 2 0 0 0 21 16z"/><polyline points="3.27 6.96 12 12.01 20.73 6.96"/><line x1="12" y1="22.08" x2="12" y2="12"/>',
	},
	users: {
		filled: false,
		svg: '<path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M23 21v-2a4 4 0 0 0-3-3.87"/><path d="M16 3.13a4 4 0 0 1 0 7.75"/>',
	},
	blog: {
		filled: false,
		svg: '<path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><polyline points="14 2 14 8 20 8"/><line x1="16" y1="13" x2="8" y2="13"/><line x1="16" y1="17" x2="8" y2="17"/>',
	},
};

function iconAttrs(key: IconKey): astroHTML.JSX.SVGAttributes {
	const icon = ICONS[key];
	return icon.filled
		? { fill: "currentColor" }
		: {
				fill: "none",
				stroke: "currentColor",
				"stroke-width": "2",
				"stroke-linecap": "round",
				"stroke-linejoin": "round",
			};
}

/* ----------------------------------------------------------------------------
 * PageHero 规格条(原左栏 meta)
 * -------------------------------------------------------------------------- */

const spec: SpecItem[] = [
	counts.totalStars < COUNT_UP_MAX
		? { label: C.metaStars, count: counts.totalStars }
		: { label: C.metaStars, value: formatCount(counts.totalStars) },
	{ label: C.metaRepos, count: counts.projects, href: tp("/projects") },
	settings.contributors !== null
		? { label: C.metaContributors, count: settings.contributors }
		: { label: C.metaContributors, value: "—" },
	{ label: C.metaSince, value: settings.establishedYear ?? "—" },
	{ label: t("meta.location"), value: location },
	{ label: C.metaLicense, value: "MIT" },
];

/* ----------------------------------------------------------------------------
 * 03 社区:平台卡片数据
 * ----------------------------------------------------------------------------
 *   span  sm 起 6 列网格中的跨度,4/2 · 2/4 交错形成不对称 Bento
 * -------------------------------------------------------------------------- */

interface JoinPlatform {
	key: "github" | "aur" | "blog" | "email";
	eyebrow: string;
	description: string;
	cta: string;
	ctaHref: string;
	external: boolean;
	metricLabel: string;
	metricValue: string;
	icon: IconKey;
	span: string;
}

const joinPlatforms: readonly JoinPlatform[] = [
	{
		key: "github",
		eyebrow: C.joinGithub,
		description: C.joinGithubDesc,
		cta: C.joinGithubCta,
		ctaHref: githubUrl,
		external: true,
		metricLabel: C.joinGithubLabel,
		metricValue: "zerx-lab",
		icon: "github",
		span: "sm:col-span-4",
	},
	{
		key: "aur",
		eyebrow: C.joinAur,
		description: C.joinAurDesc,
		cta: C.joinAurCta,
		ctaHref: lang === "zh" ? "/aur" : "/en/aur",
		external: false,
		metricLabel: C.joinAurLabel,
		metricValue: String(counts.aurPackages),
		icon: "package",
		span: "sm:col-span-2",
	},
	{
		key: "blog",
		eyebrow: C.joinBlog,
		description: C.joinBlogDesc,
		cta: C.joinBlogCta,
		ctaHref: lang === "zh" ? "/blog" : "/en/blog",
		external: false,
		metricLabel: C.joinBlogLabel,
		metricValue: String(counts.posts),
		icon: "blog",
		span: "sm:col-span-2",
	},
	{
		key: "email",
		eyebrow: C.joinEmail,
		description: C.joinEmailDesc,
		cta: C.joinEmailCta,
		ctaHref: emailHref ?? "#",
		external: false,
		metricLabel: C.joinEmailLabel,
		metricValue: C.joinEmailLabelValue,
		icon: "email",
		span: "sm:col-span-4",
	},
] as const;

const githubHandle = githubUrl
	.replace(/^https?:\/\//i, "")
	.replace(/\/$/, "");

/** 社区节底部联络规格条:原"联系"节的独有信息 */
const contactSpec: SpecItem[] = [
	...(settings.socialEmail && emailHref
		? [{ label: "EMAIL", value: settings.socialEmail, href: emailHref }]
		: []),
	{ label: "GITHUB", value: githubHandle, href: githubUrl },
	{ label: C.joinEmailLabel, value: C.contactReply, live: true },
];

/* ----------------------------------------------------------------------------
 * 02 数据:数字条目
 * ----------------------------------------------------------------------------
 *   raw   原始整数,驱动 CSS count-up 与 sr-only 真值(缺失为 null)
 *   value 缺失或超过 count-up 合理位数(≥100k)时的静态展示文本
 *   cell  Bento 格位:hero = 2×2 巨型格
 * -------------------------------------------------------------------------- */

interface NumberStat {
	label: string;
	raw: number | null;
	value: string;
	sub: string;
	icon: IconKey;
	cell: "hero" | "half" | "wide";
}

const numberStats: readonly NumberStat[] = [
	{
		label: C.numberGithubStars,
		raw: counts.totalStars,
		value: formatLarge(counts.totalStars),
		sub: C.numberLabelWeek,
		icon: "star",
		cell: "hero",
	},
	{
		label: C.numberRepos,
		raw: counts.projects,
		value: String(counts.projects),
		sub: C.numberLabelOpenSource,
		icon: "repo",
		cell: "half",
	},
	{
		label: C.numberAurPkgs,
		raw: counts.aurPackages,
		value: String(counts.aurPackages),
		sub: C.numberLabelMaintained,
		icon: "package",
		cell: "half",
	},
	{
		label: C.numberContributors,
		raw: settings.contributors,
		value: settings.contributors !== null ? String(settings.contributors) : "—",
		sub: C.numberLabelCommunity,
		icon: "users",
		cell: "wide",
	},
] as const;

const CELL_CLASS: Record<NumberStat["cell"], string> = {
	hero: "col-span-2 lg:col-span-6 lg:row-span-2 min-h-[260px] lg:min-h-[420px]",
	half: "col-span-1 lg:col-span-3 min-h-[170px] lg:min-h-[200px]",
	wide: "col-span-2 lg:col-span-6 min-h-[170px] lg:min-h-[200px]",
};

const NUMBER_SIZE: Record<NumberStat["cell"], string> = {
	hero: "text-[clamp(88px,14vw,200px)] tracking-[-0.06em]",
	half: "text-[48px] sm:text-[56px] lg:text-[64px] tracking-[-0.045em]",
	wide: "text-[48px] sm:text-[56px] lg:text-[64px] tracking-[-0.045em]",
};

/* ----------------------------------------------------------------------------
 * 04 技术栈
 * -------------------------------------------------------------------------- */

const stackAriaLabel = `${C.stackBarLabel}: ${languageStats
	.map((lg) => `${lg.name} ${lg.percent.toFixed(1)}%`)
	.join(", ")}`;

const leadLanguage = languageStats[0] ?? null;
const topLanguages = languageStats.slice(0, 3);
---

<AppShell title={C.title} description={C.description}>
	{/* ================= PageHero ================= */}
	<PageHero eyebrow={C.eyebrow} description={description} spec={spec}>
		<Fragment slot="title">
			{C.heroPre}{lang === "en" && " "}<span class="serif-accent">{C.heroAccent}</span>{lang === "en" && " "}{C.heroPost}
		</Fragment>

		<Fragment slot="actions">
			<a href={githubUrl} target="_blank" rel="noopener noreferrer" class="btn btn-primary">
				<svg aria-hidden="true" width="14" height="14" viewBox="0 0 24 24" {...iconAttrs("github")} set:html={ICONS.github.svg} />
				{C.actionGithub}
			</a>
			{emailHref && (
				<a href={emailHref} class="btn btn-ghost">
					<svg aria-hidden="true" width="13" height="13" viewBox="0 0 24 24" {...iconAttrs("email")} set:html={ICONS.email.svg} />
					{C.actionEmail}
				</a>
			)}
			<a href={rssHref} class="btn btn-ghost">
				<svg aria-hidden="true" width="13" height="13" viewBox="0 0 24 24" {...iconAttrs("rss")} set:html={ICONS.rss.svg} />
				{C.actionRss}
			</a>
		</Fragment>

		{/* aside:实验室档案卡 */}
		<aside slot="aside" aria-label={C.profileLabel} class="surface-card crop-marks relative overflow-hidden p-6 lg:p-7">
			<div aria-hidden="true" class="about-profile-grid dot-grid pointer-events-none absolute inset-0"></div>
			<div class="relative">
				<div class="flex items-center justify-between gap-3">
					<span class="mono-label text-[10.5px]">{C.profileLabel}</span>
					<span class="mono-num text-[10.5px]">EST. {settings.establishedYear ?? "—"}</span>
				</div>

				<p class="mt-6 text-[26px] font-semibold leading-none tracking-[-0.035em] text-[color:var(--color-ink-primary)]">
					{settings.siteName}
				</p>
				<p class="mt-2 text-[13.5px] leading-[1.55] text-[color:var(--color-ink-tertiary)]">
					{C.profileKind} · {tagline}
				</p>

				<dl class="mt-6 m-0 border-t border-[color:var(--color-hairline)]">
					{settings.focus && (
						<div class="flex items-baseline justify-between gap-4 py-3 border-b border-[color:var(--color-hairline)]">
							<dt class="mono-label text-[10px]">{C.profileFocus}</dt>
							<dd class="m-0 text-right font-[var(--font-mono)] text-[11.5px] text-[color:var(--color-ink-primary)]">{settings.focus}</dd>
						</div>
					)}
					{topLanguages.length > 0 && (
						<div class="py-3 border-b border-[color:var(--color-hairline)]">
							<dt class="mono-label text-[10px]">{C.profileStack}</dt>
							<dd class="m-0 mt-3 space-y-2">
								{topLanguages.map((lg) => (
									<div class="grid grid-cols-[minmax(0,6.5rem)_minmax(0,1fr)_3rem] items-center gap-x-3">
										<span class="flex min-w-0 items-center gap-2">
											<span aria-hidden="true" class="h-1.5 w-1.5 shrink-0 rounded-full" style={`background-color: ${lg.color};`}></span>
											<span class="truncate font-[var(--font-mono)] text-[11.5px] text-[color:var(--color-ink-primary)]">{lg.name}</span>
										</span>
										<span class="meter" aria-hidden="true">
											<span data-animate style={`width: ${lg.percent}%; background: ${lg.color};`}></span>
										</span>
										<span class="text-right font-[var(--font-mono)] text-[11px] tabular-nums text-[color:var(--color-ink-secondary)]">
											{lg.percent.toFixed(1)}%
										</span>
									</div>
								))}
							</dd>
						</div>
					)}
				</dl>

				<p class="mt-5 flex items-center gap-2 font-[var(--font-mono)] text-[11px] uppercase tracking-[var(--tracking-wider)] text-[color:var(--color-ink-secondary)]">
					<span class="dot-live" aria-hidden="true"></span>
					{C.profileStatus}
				</p>
			</div>
		</aside>
	</PageHero>

	{/* ================= 01 概述 ================= */}
	<CvSection index="01" label={C.sectionAbout} sublabel={C.sectionAboutSub} note={C.sectionAboutNote}>
		<div class="reveal-scroll">
			<p class="max-w-[34ch] text-[22px] lg:text-[28px] font-medium leading-[1.4] tracking-[-0.02em] text-[color:var(--color-ink-primary)] text-balance">
				<span class="font-semibold">{settings.siteName}</span>
				<span class="text-[color:var(--color-ink-tertiary)]">{" — "}{tagline}.</span>
			</p>

			<div class="mt-8 grid gap-6 lg:gap-10 md:grid-cols-2 text-[15px] lg:text-[15.5px] leading-[1.8] text-[color:var(--color-ink-secondary)]">
				<p>{C.aboutBody1}</p>
				<div class="space-y-4">
					<p>{C.aboutBody2}</p>
					<p>{C.aboutBody3}</p>
				</div>
			</div>
		</div>

		{/* 工程原则:三栏,超大键名 */}
		<div class="mt-14 lg:mt-20">
			<p class="mono-label text-[10.5px]">{C.principlesLabel}</p>
			<ol class="mt-4 list-none m-0 p-0 grid grid-cols-1 sm:grid-cols-3 border-t border-[color:var(--color-hairline-strong)]">
				{C.principles.map((p, idx) => (
					<li
						class="reveal-scroll group py-6 sm:py-8 sm:pr-6 border-b sm:border-b-0 sm:[&:not(:first-child)]:pl-6 sm:[&:not(:first-child)]:border-l border-[color:var(--color-hairline)]"
						style={`--i: ${idx}`}
					>
						<span class="mono-num transition-colors duration-[var(--duration-fast)] group-hover:text-[color:var(--color-signal)]">
							{pad2(idx + 1)} / {p.key}
						</span>
						<p class="display mt-5 text-[32px] lg:text-[40px] leading-none text-[color:var(--color-ink-primary)]">
							{p.title}
						</p>
						<p class="mt-3 text-[13.5px] leading-[1.6] text-[color:var(--color-ink-tertiary)]">
							{p.text}
						</p>
					</li>
				))}
			</ol>
		</div>
	</CvSection>

	{/* ================= 02 数据:全宽 Bento ================= */}
	<CvSection
		index="02"
		label={C.sectionNumbers}
		sublabel={`${C.sectionNumbersSub} · ${pad2(numberStats.length)}`}
		note={C.sectionNumbersNote}
		layout="full"
	>
		<ul
			class:list={[
				"about-stats reveal-scroll",
				"list-none m-0 p-0",
				"grid grid-cols-2 lg:grid-cols-12 gap-px",
				"overflow-hidden rounded-[var(--radius-lg)]",
				"border border-[color:var(--color-hairline)]",
				"bg-[color:var(--color-hairline)]",
			]}
		>
			{numberStats.map((stat, idx) => (
				<li
					class:list={[
						"group relative flex flex-col bg-[color:var(--color-surface)] p-5 sm:p-6 lg:p-8",
						CELL_CLASS[stat.cell],
					]}
				>
					{stat.cell === "hero" && (
						<div aria-hidden="true" class="about-stats-glow pointer-events-none absolute inset-0"></div>
					)}
					<div class="relative flex items-center justify-between gap-3">
						<span class="mono-num text-[10.5px]" aria-hidden="true">N.{pad2(idx + 1)}</span>
						<svg
							width={stat.cell === "hero" ? 16 : 13}
							height={stat.cell === "hero" ? 16 : 13}
							viewBox="0 0 24 24"
							aria-hidden="true"
							class:list={[
								"transition-colors duration-[var(--duration-base)] group-hover:text-[color:var(--color-signal)]",
								stat.cell === "hero" ? "text-[color:var(--color-signal)]" : "text-[color:var(--color-ink-faint)]",
							]}
							{...iconAttrs(stat.icon)}
							set:html={ICONS[stat.icon].svg}
						/>
					</div>

					<p
						class:list={[
							"relative m-0 mt-auto pt-8 font-semibold leading-[0.85] tabular-nums text-[color:var(--color-ink-primary)]",
							NUMBER_SIZE[stat.cell],
						]}
					>
						{stat.raw !== null && stat.raw < COUNT_UP_MAX ? (
							<>
								<span class="count-up" aria-hidden="true" style={`--to: ${stat.raw}; --i: ${idx}`}></span>
								<span class="sr-only">{stat.raw}</span>
							</>
						) : (
							stat.value
						)}
					</p>

					<p class="relative m-0 mt-4 flex flex-wrap items-baseline gap-x-2 gap-y-1">
						<span class="mono-label text-[10.5px] text-[color:var(--color-ink-secondary)]">{stat.label}</span>
						<span class="font-[var(--font-mono)] text-[10.5px] text-[color:var(--color-ink-muted)]">/ {stat.sub}</span>
					</p>
				</li>
			))}
		</ul>
	</CvSection>

	{/* ================= 03 社区 ================= */}
	<CvSection
		index="03"
		label={C.sectionJoin}
		sublabel={`${C.sectionJoinSub} · ${pad2(joinPlatforms.length)}`}
		note={C.sectionJoinNote}
		linkText={C.sectionJoinLink}
		linkHref={`${githubUrl}/zerx-lab-website/discussions`}
	>
		<ul class="list-none m-0 p-0 grid grid-cols-1 sm:grid-cols-6 gap-3 lg:gap-4">
			{joinPlatforms.map((platform, idx) => (
				<li class:list={["reveal-scroll", platform.span]} style={`--i: ${idx}`}>
					<a
						href={platform.ctaHref}
						target={platform.external ? "_blank" : undefined}
						rel={platform.external ? "noopener noreferrer" : undefined}
						data-spotlight
						class="surface-card spotlight group flex h-full flex-col p-5 sm:p-6 min-h-[210px] focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-[color:var(--color-signal)] focus-visible:ring-offset-2 focus-visible:ring-offset-[color:var(--color-paper)]"
					>
						<div class="flex items-start gap-3">
							<span
								aria-hidden="true"
								class="inline-flex h-9 w-9 shrink-0 items-center justify-center rounded-[var(--radius-md)] border border-[color:var(--color-hairline)] bg-[color:var(--color-surface-raised)] text-[color:var(--color-ink-primary)] transition-colors duration-[var(--duration-base)] group-hover:border-[color:var(--signal-line)] group-hover:text-[color:var(--color-signal)]"
							>
								<svg width="15" height="15" viewBox="0 0 24 24" {...iconAttrs(platform.icon)} set:html={ICONS[platform.icon].svg} />
							</span>
							<span class="ml-auto flex flex-col items-end gap-1.5 text-right">
								<span class="mono-label text-[9.5px] leading-none text-[color:var(--color-ink-muted)]">{platform.metricLabel}</span>
								<span class="max-w-[14ch] truncate font-[var(--font-mono)] text-[18px] font-semibold leading-none tabular-nums tracking-[-0.02em] text-[color:var(--color-ink-primary)]">
									{platform.metricValue}
								</span>
							</span>
						</div>

						<p class="mt-6 text-[22px] font-semibold leading-none tracking-[-0.03em] text-[color:var(--color-ink-primary)]">
							{platform.eyebrow}
						</p>
						<p class="mt-3 flex-1 max-w-[46ch] text-[14px] leading-[1.6] text-[color:var(--color-ink-secondary)]">
							{platform.description}
						</p>

						<span class="mt-5 flex items-center justify-between border-t border-[color:var(--color-hairline)] pt-4">
							<span class="font-[var(--font-mono)] text-[11px] uppercase tracking-[var(--tracking-wider)] text-[color:var(--color-ink-primary)]">
								{platform.cta}
							</span>
							<svg
								aria-hidden="true"
								width="12"
								height="12"
								viewBox="0 0 24 24"
								fill="none"
								stroke="currentColor"
								stroke-width="2.25"
								stroke-linecap="round"
								stroke-linejoin="round"
								class:list={[
									"shrink-0 text-[color:var(--color-ink-tertiary)]",
									"transition-transform duration-[var(--duration-base)] ease-[var(--ease-out-expo)]",
									"group-hover:text-[color:var(--color-signal)]",
									platform.external
										? "group-hover:translate-x-[2px] group-hover:-translate-y-[2px]"
										: "group-hover:translate-x-[3px]",
								]}
							>
								{platform.external ? (
									<>
										<path d="M7 17L17 7" />
										<path d="M8 7h9v9" />
									</>
								) : (
									<>
										<path d="M5 12h14" />
										<path d="m12 5 7 7-7 7" />
									</>
								)}
							</svg>
						</span>
					</a>
				</li>
			))}
		</ul>

		{/* 联络规格:邮箱 / GitHub / 回复时效(mono,便于复制) */}
		<div class="reveal-scroll mt-6 lg:mt-8">
			<SpecStrip items={contactSpec} />
		</div>
	</CvSection>

	{/* ================= 04 技术栈:全宽 ================= */}
	<CvSection
		index="04"
		label={C.sectionStack}
		sublabel={`STACK · ${pad2(languageStats.length)} ${C.stackLanguages}`}
		description={C.stackBody}
		layout="full"
		class="mb-8 lg:mb-16"
	>
		<div class="reveal-scroll grid gap-10 lg:gap-12 lg:grid-cols-12 lg:items-end">
			{leadLanguage && (
				<div class="lg:col-span-4">
					<p class="mono-label text-[10.5px]">{C.stackLead}</p>
					<p class="m-0 mt-4 font-semibold leading-[0.85] tracking-[-0.06em] tabular-nums text-[clamp(80px,11vw,160px)] text-[color:var(--color-ink-primary)]">
						{leadLanguage.percent.toFixed(0)}<span class="text-[0.4em] tracking-[-0.03em] text-[color:var(--color-ink-tertiary)]">%</span>
					</p>
					<p class="mt-4 flex items-center gap-2 font-[var(--font-mono)] text-[13px] text-[color:var(--color-ink-primary)]">
						<span aria-hidden="true" class="h-2.5 w-2.5 rounded-full" style={`background-color: ${leadLanguage.color};`}></span>
						{leadLanguage.name}
					</p>
				</div>
			)}

			<div class:list={[leadLanguage ? "lg:col-span-8" : "lg:col-span-12"]}>
				{/* 堆叠色条:linguist 颜色,flex-grow 按占比分配,段间 2px 呼吸 */}
				<div
					class="about-stackbar flex h-4 w-full gap-[2px] overflow-hidden rounded-full bg-[color:var(--color-paper-subtle)]"
					role="img"
					aria-label={stackAriaLabel}
				>
					{languageStats.map((lg) => (
						<span
							class="h-full min-w-[3px] first:rounded-l-full last:rounded-r-full transition-opacity duration-[var(--duration-fast)] hover:opacity-80"
							style={`flex: ${lg.percent} 1 0%; background-color: ${lg.color};`}
							title={`${lg.name}: ${lg.percent.toFixed(1)}%`}
						></span>
					))}
				</div>

				{/* 图例:逐行编号 + 名称 + meter + 百分比 */}
				<ol class="mt-6 list-none m-0 p-0 grid grid-cols-1 md:grid-cols-2 gap-x-10 border-t border-[color:var(--color-hairline)]">
					{languageStats.map((lg, idx) => (
						<li class="grid grid-cols-[2rem_minmax(0,9rem)_minmax(0,1fr)_3.75rem] items-center gap-x-3 py-3 border-b border-[color:var(--color-hairline)]">
							<span class="mono-num">{pad2(idx + 1)}</span>
							<span class="flex min-w-0 items-center gap-2">
								<span aria-hidden="true" class="h-2 w-2 shrink-0 rounded-full" style={`background-color: ${lg.color};`}></span>
								<span class="truncate font-[var(--font-mono)] text-[12px] text-[color:var(--color-ink-primary)]">{lg.name}</span>
							</span>
							<span class="meter" aria-hidden="true">
								<span data-animate style={`width: ${lg.percent}%; background: ${lg.color};`}></span>
							</span>
							<span class="text-right font-[var(--font-mono)] text-[12px] tabular-nums text-[color:var(--color-ink-secondary)]">
								{lg.percent.toFixed(1)}%
							</span>
						</li>
					))}
				</ol>
			</div>
		</div>
	</CvSection>
</AppShell>

<style>
	/* 档案卡点阵只在右上角淡出 */
	.about-profile-grid {
		opacity: 0.55;
		mask-image: radial-gradient(90% 70% at 100% 0%, #000 0%, transparent 60%);
		-webkit-mask-image: radial-gradient(90% 70% at 100% 0%, #000 0%, transparent 60%);
	}

	/* Stars 巨型格:Signal 柔光,只作少量强调 */
	.about-stats-glow {
		background: radial-gradient(80% 60% at 0% 100%, var(--signal-soft), transparent 70%);
	}

	.about-stackbar {
		transform-origin: left center;
	}

	/* 02 数据 / 04 色条:滚动进入视口时才开始计数与生长 */
	@supports (animation-timeline: view()) {
		.about-stats .count-up {
			animation-timeline: view();
			animation-range: entry 10% cover 35%;
			animation-delay: 0s;
			animation-duration: auto;
		}

		.about-stackbar {
			animation: bar-grow linear both;
			animation-timeline: view();
			animation-range: entry 10% cover 35%;
		}
	}
</style>
