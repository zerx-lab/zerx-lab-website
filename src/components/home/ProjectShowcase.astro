---
/**
 * ============================================================================
 * ProjectShowcase - 首页「精选作品」Bento 网格
 * ----------------------------------------------------------------------------
 *   ┌──────────────────────────┬────────────┐
 *   │ 01 · Go                  │ 02         │
 *   │                          │ PenBridge  │
 *   │ ★ 670      (超大数字)     ├────────────┤
 *   │ wordZero                 │ 03         │
 *   │ 描述 / 亮点 / chips       │ …          │
 *   ├────────────┬─────────────┼────────────┤
 *   │ 04         │ 05          │ 06         │
 *   └────────────┴─────────────┴────────────┘
 *
 * 数据:@lib/queries/projects 的 loadLiveProjects({ includeUnlisted: true }),
 *   账号全部公开仓库按 stars 降序取前 N(与 /projects 同一查询层),GitHub 不可达
 *   时回落 projects.json 快照;fork / archived 如实标注。
 * 语言色:language-stats.json 的 linguist 配色,未知语言用中性灰。
 * ============================================================================
 */

import { loadLanguageStats, pickLang } from "@lib/content";
import { loadLiveProjects } from "@lib/queries/projects";
import { useTranslations } from "@i18n/utils";
import type { Lang } from "@i18n/ui";

interface Props {
	lang: Lang;
	/** 展示条数(Bento 版式按 6 设计) */
	limit?: number;
}

const { lang, limit = 6 } = Astro.props;
const t = useTranslations(lang);

const [{ items }, languageStats] = await Promise.all([
	loadLiveProjects({ includeUnlisted: true }),
	loadLanguageStats(),
]);
const entries = items.slice(0, limit);
const languageColor = new Map(languageStats.map((s) => [s.name, s.color]));

function formatCount(n: number): string {
	return n >= 1000 ? `${(n / 1000).toFixed(1)}k` : String(n);
}

const C = lang === "zh" ? { archived: "已归档", forks: "派生" } : { archived: "Archived", forks: "forks" };
---

<ol class="bento list-none m-0 p-0 grid gap-3 sm:grid-cols-2 lg:grid-cols-6">
	{
		entries.map((p, i) => {
			const lead = i === 0;
			const description = pickLang(p.description, lang);
			const highlights = pickLang(p.highlights, lang);
			const color = languageColor.get(p.language) ?? "var(--color-ink-muted)";
			return (
				<li
					class:list={[
						"reveal-scroll",
						lead ? "sm:col-span-2 lg:col-span-4 lg:row-span-2" : "lg:col-span-2",
					]}
				>
					<a
						href={p.githubUrl}
						target="_blank"
						rel="noopener noreferrer"
						data-spotlight
						class:list={[
							"bento__tile surface-card spotlight group flex h-full flex-col overflow-hidden",
							lead ? "p-7 lg:p-9 min-h-[22rem]" : "p-6 min-h-[13rem]",
						]}
					>
						{lead && <span aria-hidden="true" class="bento__grid dot-grid absolute inset-0 pointer-events-none" />}

						<div class="relative flex items-center justify-between gap-3 font-[var(--font-mono)] text-[11px]">
							<span class="inline-flex items-center gap-2 text-[color:var(--color-ink-tertiary)]">
								<span class="tabular-nums text-[color:var(--color-signal)]">{String(i + 1).padStart(2, "0")}</span>
								{p.language !== "Unknown" && (
									<>
										<span aria-hidden="true" class="h-px w-3 bg-[color:var(--color-hairline-strong)]" />
										<span aria-hidden="true" class="h-2 w-2 rounded-full" style={`background-color: ${color}`} />
										{p.language}
									</>
								)}
							</span>
							<svg
								aria-hidden="true"
								width="14"
								height="14"
								viewBox="0 0 24 24"
								fill="none"
								stroke="currentColor"
								stroke-width="2"
								stroke-linecap="round"
								stroke-linejoin="round"
								class="text-[color:var(--color-ink-muted)] transition-transform duration-[var(--duration-slow)] ease-[var(--ease-out-expo)] group-hover:translate-x-[2px] group-hover:-translate-y-[2px] group-hover:text-[color:var(--color-signal)]"
							>
								<path d="M7 17L17 7" />
								<path d="M8 7h9v9" />
							</svg>
						</div>

						{lead && (
							<p class="relative mt-auto pt-10 font-semibold leading-none tracking-[-0.06em] text-[clamp(4.5rem,9vw,8rem)] tabular-nums">
								<span class="text-signal">★</span>
								{formatCount(p.stars)}
							</p>
						)}

						<div class:list={["relative", lead ? "mt-6" : "mt-auto pt-8"]}>
							<div class="flex flex-wrap items-center gap-2">
								<h3 class:list={["font-semibold tracking-[-0.03em] leading-tight", lead ? "text-[28px] lg:text-[34px]" : "text-[19px]"]}>
									{p.name}
								</h3>
								{p.fork && <span class="chip">Fork</span>}
								{p.archived && <span class="chip">{C.archived}</span>}
							</div>
							{description && (
								<p class:list={["mt-2 text-[color:var(--color-ink-secondary)]", lead ? "text-[15px] leading-[1.65] max-w-[52ch]" : "text-[13px] leading-[1.6] line-clamp-2"]}>
									{description}
								</p>
							)}
							{lead && highlights && (
								<p class="mt-3 font-[var(--font-mono)] text-[11.5px] text-[color:var(--color-ink-tertiary)]">
									<span aria-hidden="true" class="text-[color:var(--color-signal)]">›</span> {highlights}
								</p>
							)}
							<div class="mt-4 flex flex-wrap items-center gap-1.5">
								{!lead && (
									<span class="chip">
										<span aria-hidden="true" class="text-[color:var(--color-signal)]">★</span>
										{formatCount(p.stars)}
									</span>
								)}
								{lead && (
									<span class="chip">
										{formatCount(p.forks)} {C.forks}
									</span>
								)}
								{p.techStack.slice(0, lead ? 5 : 2).map((tag) => (
									<span class="chip">{tag}</span>
								))}
							</div>
						</div>
						<span class="sr-only">{t("action.viewOnGithub")}</span>
					</a>
				</li>
			);
		})
	}
</ol>

<style>
	.bento__tile {
		position: relative;
	}

	.bento__grid {
		opacity: 0.7;
		mask-image: radial-gradient(ellipse 70% 70% at 100% 0%, #000, transparent 70%);
		-webkit-mask-image: radial-gradient(ellipse 70% 70% at 100% 0%, #000, transparent 70%);
	}
</style>
