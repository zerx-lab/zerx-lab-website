---
/**
 * ============================================================================
 * BlogCategoryTabs - 博客分类分段控件
 * ----------------------------------------------------------------------------
 * 分段控件(segmented control):放在博客列表页吸顶工具条(dock)里,
 * 轨道本身无边框无底色(由 dock 提供表面),一排 mono 胶囊,激活项 ink 实底,
 * 右侧附该分类的文章数。实底块带 view-transition-name,在分类页之间跳转时
 * 由跨文档 View Transition 形变滑动到新位置(零 JS)。超出宽度横向滚动,
 * 右缘渐隐提示可滚动。
 *
 * URL(路径式):ALL → `${listBase}/`;分类 → `${listBase}/cat/<slug>/`
 * counts:key = slug,"__all__" 为 ALL 计数;缺失则不显示数字。
 * ============================================================================
 */

import { getLangFromUrl } from "@i18n/utils";
import type { Lang } from "@i18n/ui";

/**
 * 分类展示形态:slug + 已本地化的 name。
 * 本组件只关心最小渲染所需字段,上游传入 listCategories(lang) 的结果即可。
 */
export interface CategoryTabItem {
	readonly slug: string;
	readonly name: string;
}

interface Props {
	/** 列表页根路径(已做 lang 前缀处理,不带结尾斜杠,例如 "/blog" 或 "/en/blog") */
	listBase: string;
	/** 分类列表(顺序即展示顺序,已按 lang 解包 name) */
	categories: readonly CategoryTabItem[];
	/** 当前激活的分类 slug;空串视为 ALL */
	activeSlug: string;
	/**
	 * 每分类文章数。key = category.slug;"ALL" 计数用特殊键 "__all__"。
	 * 未提供某 slug → 不显示数字(分类存在但可能聚合查询失败)。
	 */
	counts?: Readonly<Record<string, number>> | undefined;
	/** 额外类名 */
	class?: string;
}

const {
	listBase,
	categories,
	activeSlug,
	counts,
	class: className = "",
} = Astro.props;

const lang = getLangFromUrl(Astro.url) as Lang;

/* ----------------------------------------------------------------------------
 * 文案(本组件专属,未进 i18n 字典)
 * -------------------------------------------------------------------------- */
const COPY = {
	zh: {
		all: "全部",
		ariaLabel: "按分类筛选文章",
	},
	en: {
		all: "All",
		ariaLabel: "Filter posts by category",
	},
} as const;
const C = COPY[lang] ?? COPY.zh;

/* ----------------------------------------------------------------------------
 * URL 构造(路径式,不再拼 query string)
 * ----------------------------------------------------------------------------
 *   - ALL   → `${listBase}/`
 *   - 分类  → `${listBase}/cat/<slug>/`
 * -------------------------------------------------------------------------- */
function buildHref(slug: string): string {
	return slug ? `${listBase}/cat/${slug}/` : `${listBase}/`;
}

/* ----------------------------------------------------------------------------
 * 归一化激活态
 * ----------------------------------------------------------------------------
 * 上游传入的 activeSlug 可能是 "" / 实际 slug,这里一次性转成
 * "" 表示 ALL,其余保留。
 * -------------------------------------------------------------------------- */
const normalizedActive = (activeSlug || "").toLowerCase();

/* ----------------------------------------------------------------------------
 * 渲染用的标签列表(ALL + 所有分类)
 * -------------------------------------------------------------------------- */
interface TabItem {
	readonly slug: string; // "" 表示 ALL
	readonly label: string;
	readonly count: number | null;
	readonly href: string;
	readonly active: boolean;
}

const ALL_KEY = "__all__";

const items: readonly TabItem[] = [
	{
		slug: "",
		label: C.all,
		count: counts && ALL_KEY in counts ? counts[ALL_KEY]! : null,
		href: buildHref(""),
		active: normalizedActive === "",
	},
	...categories.map((cat: CategoryTabItem): TabItem => ({
		slug: cat.slug,
		label: cat.name,
		count: counts && cat.slug in counts ? counts[cat.slug]! : null,
		href: buildHref(cat.slug),
		active: normalizedActive === cat.slug,
	})),
];
---

<nav
	aria-label={C.ariaLabel}
	class:list={["blog-category-tabs", "min-w-0 overflow-x-auto", className]}
>
	<ul
		class:list={[
			"cat-track",
			"m-0 inline-flex list-none items-center gap-1 p-0",
			"flex-nowrap whitespace-nowrap",
		]}
	>
		{
			items.map((item) => (
				<li class="inline-flex">
					<a
						href={item.href}
						aria-current={item.active ? "page" : undefined}
						class:list={["cat-tab", item.active && "is-active"]}
					>
						<span class="uppercase">{item.label}</span>
						{item.count !== null && (
							<span aria-hidden="true" class="cat-tab__count">
								{item.count}
							</span>
						)}
					</a>
				</li>
			))
		}
	</ul>
</nav>

<style>
	.blog-category-tabs {
		scrollbar-width: none;
		/* 仅右缘渐隐:提示可横向滚动;内容不溢出时落在空白处,无视觉影响 */
		mask-image: linear-gradient(to right, #000 calc(100% - 20px), transparent 100%);
	}
	.blog-category-tabs::-webkit-scrollbar {
		display: none;
	}

	.cat-tab {
		position: relative;
		display: inline-flex;
		align-items: center;
		gap: 0.4rem;
		height: 2.125rem;
		padding-inline: 0.75rem;
		font-family: var(--font-mono);
		font-size: 11px;
		font-weight: 500;
		line-height: 1;
		letter-spacing: var(--tracking-wide);
		color: var(--color-ink-tertiary);
		border-radius: var(--radius-md);
		transition:
			color var(--duration-fast) var(--ease-standard),
			background-color var(--duration-fast) var(--ease-standard);
	}
	.cat-tab:not(.is-active):hover {
		color: var(--color-ink-primary);
		background-color: var(--color-paper-muted);
	}
	.cat-tab:focus-visible {
		outline-offset: 0;
	}

	.cat-tab__count {
		font-size: 10px;
		font-variant-numeric: tabular-nums;
		color: var(--color-ink-muted);
		transition: color var(--duration-fast) var(--ease-standard);
	}

	.cat-tab.is-active {
		color: var(--color-paper);
		background-color: var(--color-ink-primary);
		box-shadow:
			0 1px 0 rgba(255, 255, 255, 0.14) inset,
			0 1px 2px rgba(0, 0, 0, 0.18);
		view-transition-name: vt-blog-cat;
	}
	.cat-tab.is-active .cat-tab__count {
		color: color-mix(in oklab, var(--color-paper) 62%, transparent);
	}
</style>

<style is:global>
	::view-transition-group(vt-blog-cat) {
		animation-duration: 420ms;
		animation-timing-function: var(--ease-out-expo);
	}
</style>
