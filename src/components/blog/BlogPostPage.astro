---
/**
 * ============================================================================
 * BlogPostPage - 博客详情页共享组件(/blog/[slug] 与 /en/blog/[slug] 共用)
 * ----------------------------------------------------------------------------
 * 消费页面层已查好的 PostVM,render() 出正文与 TOC headings。
 *
 * 布局("长文阅读"):
 *
 *   PageHero  分类眉标 / 超大标题 / 摘要        ┌ aside:作者卡 + 标签 ┐
 *             SpecStrip:发布 / 更新 / 阅读时长 / 字数 / 分类
 *   ───────────────────────────────────────────────────────────────────
 *   正文网格(.wrap,12 列)
 *     xl:  左轨 2/12(吸顶:返回 / 档案日期 / 章节数 / 回到顶部)
 *          正文 7/12(版心 68ch)
 *          TOC 3/12(吸顶)
 *     lg:  左轨横排在上;正文 8/12 + TOC 4/12
 *     <lg: 单列:左轨横排 → 折叠 TOC → 正文
 *   ───────────────────────────────────────────────────────────────────
 *   01 继续阅读(CvSection full):上一篇 / 下一篇 大卡片
 *   02 评论(Comments → CvSection;未配置 giscus 时静默跳过)
 *
 * 客户端脚本:正文图片灯箱 + 标题 "#" 锚点(纯增强,幂等)。
 * ============================================================================
 */

import { render } from "astro:content";
import AppShell from "@layouts/AppShell.astro";
import PageHero from "@components/layout/PageHero.astro";
import CvSection from "@components/layout/CvSection.astro";
import type { SpecItem } from "@components/layout/SpecStrip.astro";
import TableOfContents from "@components/blog/TableOfContents.astro";
import Comments from "@components/blog/Comments.astro";
import { getLangFromUrl, useTranslatedPath, formatDateCompact } from "@i18n/utils";
import type { Lang } from "@i18n/ui";
import type { MarkdownHeading } from "astro";
import { loadAdjacentPosts, type PostVM } from "@lib/queries/posts";
import { readingStats } from "@lib/reading-time";
import "@styles/prose.css";

interface Props {
	/** 页面层已查好的文章 ViewModel(避免组件内再查一次 Content Collection) */
	post: PostVM;
}

const { post } = Astro.props;

const lang = getLangFromUrl(Astro.url) as Lang;
const tp = useTranslatedPath(lang);

/* 相邻文章(上一篇 / 下一篇) */
const { previous: prevVM, next: nextVM } = await loadAdjacentPosts(
	post.slug,
	lang,
);

/* ----------------------------------------------------------------------------
 * 正文渲染(Astro 6 Content Layer)
 * ----------------------------------------------------------------------------
 * render() 跑 remark/rehype 管线(含 Shiki 双主题高亮),渲染失败会在构建期
 * 直接报错。阅读时长沿用查询层的 post.readingTime(与列表页同口径),
 * 字数额外算一次仅用于规格条展示。
 * -------------------------------------------------------------------------- */

const { Content, headings } = await render(post.entry);
const { wordCount } = readingStats(post.content);
const readingTimeMin = post.readingTime;

/* ----------------------------------------------------------------------------
 * 页面级文案
 * -------------------------------------------------------------------------- */

const COPY = {
	zh: {
		blogBreadcrumb: "博客",
		backToList: "返回博客",
		postInfo: "文章信息",
		entry: "档案",
		sections: "章节",
		backToTop: "回到顶部",
		continueReading: "继续阅读",
		continueSub: "Continue reading",
		postNav: "文章导航",
		prev: "上一篇",
		next: "下一篇",
		wordCount: "字数",
		author: "作者",
		published: "发布",
		updated: "更新",
		category: "分类",
		readingTime: "阅读时长",
		tags: "标签",
		minutes: " 分钟",
		viewAuthor: "查看作者主页",
		anchor: "链接到此标题",
		imageViewer: "图片查看器",
		close: "关闭",
	},
	en: {
		blogBreadcrumb: "Blog",
		backToList: "All posts",
		postInfo: "Post info",
		entry: "Entry",
		sections: "Sections",
		backToTop: "Back to top",
		continueReading: "Continue reading",
		continueSub: "Prev · Next",
		postNav: "Post navigation",
		prev: "Previous",
		next: "Next",
		wordCount: "Words",
		author: "Author",
		published: "Published",
		updated: "Updated",
		category: "Category",
		readingTime: "Reading time",
		tags: "Tags",
		minutes: " min",
		viewAuthor: "View author",
		anchor: "Link to this heading",
		imageViewer: "Image viewer",
		close: "Close",
	},
} as const;

const C = COPY[lang] ?? COPY.zh;

const postDateCompact = formatDateCompact(post.date);
/* 左轨大日期:年份小字 + 月.日大字 */
const [dateYear, dateMonth, dateDay] = postDateCompact.split("-");

/* 页头规格条 */
const spec: SpecItem[] = [
	{ label: C.published, value: postDateCompact },
	...(post.updatedDate
		? [{ label: C.updated, value: formatDateCompact(post.updatedDate) }]
		: []),
	{ label: C.readingTime, count: readingTimeMin, suffix: C.minutes },
	{ label: C.wordCount, count: wordCount },
	...(post.categoryName
		? [
				{
					label: C.category,
					value: post.categoryName,
					href: post.categorySlug
						? tp(`/blog/cat/${post.categorySlug}/`)
						: undefined,
				},
			]
		: []),
];

/* 章节数(H2),左轨展示 */
const sectionCount = headings.filter((h: MarkdownHeading) => h.depth === 2 && h.slug).length;

/* 作者卡:有 GitHub 时整卡可点 */
const AuthorTag = post.authorGithub ? "a" : "div";
const hasAside = Boolean(post.authorName) || post.tags.length > 0;

/* 章节编号:有上/下一篇时评论为 02,否则顺延为 01 */
const hasAdjacent = Boolean(prevVM || nextVM);
const commentsIndex = hasAdjacent ? "02" : "01";

/* ----------------------------------------------------------------------------
 * 结构化数据(JSON-LD)—— BlogPosting
 * -------------------------------------------------------------------------- */

const siteUrl = (Astro.site?.toString() ?? "https://zerx.dev").replace(
	/\/$/,
	"",
);
const canonical = `${siteUrl}${Astro.url.pathname}`;

const jsonLd = JSON.stringify({
	"@context": "https://schema.org",
	"@type": "BlogPosting",
	headline: post.title,
	description: post.excerpt,
	url: canonical,
	datePublished: post.date,
	dateModified: post.updatedDate ?? post.date,
	author: post.authorName
		? {
				"@type": "Person",
				name: post.authorName,
				url: post.authorGithub ?? undefined,
			}
		: undefined,
	publisher: {
		"@type": "Organization",
		name: "ZerxLab",
		url: siteUrl,
	},
	mainEntityOfPage: {
		"@type": "WebPage",
		"@id": canonical,
	},
	inLanguage: lang === "zh" ? "zh-CN" : "en-US",
	wordCount,
});
---

<AppShell
	title={post.seoTitle ?? post.title}
	description={post.seoDescription ?? post.excerpt}
	ogType="article"
	articlePublishedTime={post.date}
	articleModifiedTime={post.updatedDate ?? undefined}
	articleAuthor={post.authorName ?? undefined}
>
	<Fragment slot="head">
		<script
			type="application/ld+json"
			is:inline
			set:html={jsonLd}
		/>
	</Fragment>

	{/* ======================= 文章头 ======================= */}
	<PageHero
		size="md"
		eyebrow={post.categoryName ?? C.blogBreadcrumb}
		title={post.title}
		description={post.excerpt || undefined}
		spec={spec}
	>
		{hasAside && (
			<div slot="aside" class="flex flex-col gap-6">
				{post.authorName && (
					<AuthorTag
						href={post.authorGithub ?? undefined}
						target={post.authorGithub ? "_blank" : undefined}
						rel={post.authorGithub ? "noopener noreferrer" : undefined}
						aria-label={
							post.authorGithub
								? `${C.viewAuthor}: ${post.authorName}`
								: undefined
						}
						class="post-author surface-card group flex items-center gap-4 p-4 pr-5"
					>
						{post.authorAvatar ? (
							<img
								src={post.authorAvatar}
								alt=""
								loading="lazy"
								decoding="async"
								width="48"
								height="48"
								class:list={[
									"shrink-0 h-12 w-12 rounded-full",
									"ring-1 ring-[color:var(--color-hairline-strong)]",
									"bg-[color:var(--color-paper-subtle)]",
								]}
							/>
						) : (
							<span
								aria-hidden="true"
								class:list={[
									"shrink-0 inline-flex items-center justify-center",
									"h-12 w-12 rounded-full",
									"bg-[color:var(--color-ink-primary)] text-[color:var(--color-paper)]",
									"font-[var(--font-mono)] text-[13px] font-semibold uppercase",
								]}
							>
								{post.authorName.slice(0, 2)}
							</span>
						)}
						<span class="flex flex-col min-w-0 flex-1 gap-2">
							<span class="mono-label text-[10px] leading-none">{C.author}</span>
							<span class="text-[16px] leading-none font-semibold tracking-[-0.02em] text-[color:var(--color-ink-primary)] truncate">
								{post.authorName}
							</span>
						</span>
						{post.authorGithub && (
							<svg
								aria-hidden="true"
								width="13"
								height="13"
								viewBox="0 0 24 24"
								fill="none"
								stroke="currentColor"
								stroke-width="2"
								stroke-linecap="round"
								stroke-linejoin="round"
								class:list={[
									"shrink-0 text-[color:var(--color-ink-muted)]",
									"transition-transform duration-[var(--duration-base)] ease-[var(--ease-out-expo)]",
									"group-hover:translate-x-[2px] group-hover:-translate-y-[2px]",
									"group-hover:text-[color:var(--color-signal)]",
								]}
							>
								<path d="M7 17 17 7"></path>
								<path d="M7 7h10v10"></path>
							</svg>
						)}
					</AuthorTag>
				)}

				{post.tags.length > 0 && (
					<div>
						<span class="mono-label text-[10px] leading-none block">{C.tags}</span>
						<ul class="mt-3 flex flex-wrap gap-1.5 list-none m-0 p-0" aria-label={C.tags}>
							{post.tags.map((tag: PostVM["tags"][number]) => (
								<li class="inline-flex">
									<span class="chip">
										<span aria-hidden="true" class="text-[color:var(--color-ink-muted)]">#</span>
										{tag.name}
									</span>
								</li>
							))}
						</ul>
					</div>
				)}
			</div>
		)}
	</PageHero>

	{/* ======================= 正文网格 ======================= */}
	<div class="wrap mt-4 lg:mt-10 grid grid-cols-1 lg:grid-cols-12 gap-x-10 xl:gap-x-12 gap-y-8">
		{/* ---- 左轨:<xl 横排一行;xl 起竖排吸顶 ---- */}
		<aside
			aria-label={C.postInfo}
			class:list={[
				"order-1 lg:col-span-12 xl:col-span-2",
				"flex items-center justify-between gap-4",
				"xl:flex-col xl:items-start xl:justify-start xl:gap-10",
				"xl:sticky xl:self-start xl:top-[calc(var(--layout-top-nav-height)+1rem)]",
			]}
		>
			<a
				href={tp("/blog")}
				class:list={[
					"group w-fit inline-flex items-center gap-2",
					"font-[var(--font-mono)] text-[10.5px] leading-none uppercase",
					"tracking-[var(--tracking-wider)]",
					"text-[color:var(--color-ink-tertiary)]",
					"hover:text-[color:var(--color-ink-primary)]",
				]}
			>
				<span
					aria-hidden="true"
					class:list={[
						"inline-flex items-center justify-center h-7 w-7",
						"rounded-[var(--radius-sm)] border border-[color:var(--color-hairline)]",
						"bg-[color:var(--color-surface)]",
						"transition-[border-color] duration-[var(--duration-fast)]",
						"group-hover:border-[color:var(--color-hairline-strong)]",
					]}
				>
					<svg
						width="11"
						height="11"
						viewBox="0 0 24 24"
						fill="none"
						stroke="currentColor"
						stroke-width="2.25"
						stroke-linecap="round"
						stroke-linejoin="round"
						class="transition-transform duration-[var(--duration-base)] ease-[var(--ease-out-expo)] group-hover:-translate-x-[2px]"
					>
						<path d="m12 19-7-7 7-7"></path>
						<path d="M19 12H5"></path>
					</svg>
				</span>
				<span>{C.backToList}</span>
			</a>

			{/* 档案日期:<xl 为紧凑 mono 行,xl 为大号竖排 */}
			<div class="xl:w-full xl:pt-6 xl:border-t xl:border-[color:var(--color-hairline)]">
				<span class="mono-label text-[10px] leading-none hidden xl:block">{C.entry}</span>
				<time
					datetime={post.date}
					class="font-[var(--font-mono)] text-[11px] leading-none uppercase tracking-[var(--tracking-wider)] tabular-nums text-[color:var(--color-ink-tertiary)] xl:hidden"
				>
					{C.entry} · {postDateCompact}
				</time>
				<time datetime={post.date} class="hidden xl:block mt-4" aria-hidden="true">
					<span class="block font-[var(--font-mono)] text-[11px] leading-none tabular-nums text-[color:var(--color-ink-muted)]">
						{dateYear}
					</span>
					<span class="block mt-2 text-[40px] font-semibold leading-none tracking-[-0.05em] tabular-nums text-[color:var(--color-ink-primary)]">
						{dateMonth}<span class="text-[color:var(--color-signal)]">.</span>{dateDay}
					</span>
				</time>
			</div>

			{sectionCount > 0 && (
				<div class="hidden xl:block xl:w-full xl:pt-6 xl:border-t xl:border-[color:var(--color-hairline)]">
					<span class="mono-label text-[10px] leading-none block">{C.sections}</span>
					<span class="block mt-4 text-[40px] font-semibold leading-none tracking-[-0.05em] tabular-nums text-[color:var(--color-ink-primary)]">
						<span aria-hidden="true" class="font-[var(--font-serif)] italic font-normal text-[color:var(--color-ink-muted)] mr-1">§</span>{String(sectionCount).padStart(2, "0")}
					</span>
				</div>
			)}

			<a
				href="#main-content"
				class:list={[
					"group hidden xl:inline-flex items-center gap-2",
					"font-[var(--font-mono)] text-[10.5px] leading-none uppercase",
					"tracking-[var(--tracking-wider)]",
					"text-[color:var(--color-ink-tertiary)] hover:text-[color:var(--color-ink-primary)]",
				]}
			>
				<svg
					aria-hidden="true"
					width="11"
					height="11"
					viewBox="0 0 24 24"
					fill="none"
					stroke="currentColor"
					stroke-width="2.25"
					stroke-linecap="round"
					stroke-linejoin="round"
					class="transition-transform duration-[var(--duration-base)] ease-[var(--ease-out-expo)] group-hover:-translate-y-[2px] text-[color:var(--color-signal)]"
				>
					<path d="m5 12 7-7 7 7"></path>
					<path d="M12 19V5"></path>
				</svg>
				<span class="link-underline">{C.backToTop}</span>
			</a>
		</aside>

		{/* ---- 正文(版心 68ch) ---- */}
		<div class="order-3 lg:order-2 lg:col-span-8 xl:col-span-7 min-w-0">
			<article
				class="prose blog-post-article max-w-[68ch]"
				data-anchor-label={C.anchor}
			>
				<Content />
			</article>
		</div>

		{/* ---- TOC:<lg 折叠在正文前;lg 起右侧吸顶 ---- */}
		{headings.length > 0 && (
			<div
				class:list={[
					"order-2 lg:order-3 lg:col-span-4 xl:col-span-3 min-w-0",
					"lg:sticky lg:self-start",
					"lg:top-[calc(var(--layout-top-nav-height)+1rem)]",
				]}
			>
				<TableOfContents headings={headings} />
			</div>
		)}
	</div>

	{/* ---- 图片 Lightbox(点击正文图片放大) ---- */}
	<div
		id="image-lightbox"
		class="image-lightbox"
		role="dialog"
		aria-modal="true"
		aria-label={C.imageViewer}
		aria-hidden="true"
		hidden
	>
		<button
			type="button"
			class="image-lightbox__close"
			aria-label={C.close}
		>
			<span class="image-lightbox__close-key" aria-hidden="true">Esc</span>
			<svg
				aria-hidden="true"
				width="14"
				height="14"
				viewBox="0 0 24 24"
				fill="none"
				stroke="currentColor"
				stroke-width="2"
				stroke-linecap="round"
				stroke-linejoin="round"
			>
				<path d="M18 6 6 18"></path>
				<path d="m6 6 12 12"></path>
			</svg>
		</button>
		<figure class="image-lightbox__figure">
			<img class="image-lightbox__img" alt="" />
			<figcaption class="image-lightbox__caption"></figcaption>
		</figure>
	</div>

	{/* ======================= 01 继续阅读 ======================= */}
	{hasAdjacent && (
		<CvSection
			index="01"
			label={C.continueReading}
			sublabel={C.continueSub}
			layout="full"
		>
			<nav
				aria-label={C.postNav}
				class="grid grid-cols-1 md:grid-cols-2 gap-4"
			>
				{prevVM ? (
					<a
						href={tp(`/blog/${prevVM.slug}/`)}
						rel="prev"
						class="post-nav-card surface-card spotlight reveal-scroll group"
						data-spotlight
					>
						<span class="post-nav-card__meta">
							<span class="inline-flex items-center gap-2">
								<svg
									aria-hidden="true"
									width="12"
									height="12"
									viewBox="0 0 24 24"
									fill="none"
									stroke="currentColor"
									stroke-width="2.5"
									stroke-linecap="round"
									stroke-linejoin="round"
									class="post-nav-card__arrow post-nav-card__arrow--prev"
								>
									<path d="m12 19-7-7 7-7"></path>
									<path d="M19 12H5"></path>
								</svg>
								{C.prev}
							</span>
							<time datetime={prevVM.date} class="tabular-nums text-[color:var(--color-ink-muted)]">
								{formatDateCompact(prevVM.date)}
							</time>
						</span>
						<span class="post-nav-card__title line-clamp-3">{prevVM.title}</span>
					</a>
				) : (
					<div aria-hidden="true" class="hidden md:block"></div>
				)}

				{nextVM ? (
					<a
						href={tp(`/blog/${nextVM.slug}/`)}
						rel="next"
						class="post-nav-card post-nav-card--next surface-card spotlight reveal-scroll group"
						data-spotlight
					>
						<span class="post-nav-card__meta">
							<time datetime={nextVM.date} class="tabular-nums text-[color:var(--color-ink-muted)]">
								{formatDateCompact(nextVM.date)}
							</time>
							<span class="inline-flex items-center gap-2">
								{C.next}
								<svg
									aria-hidden="true"
									width="12"
									height="12"
									viewBox="0 0 24 24"
									fill="none"
									stroke="currentColor"
									stroke-width="2.5"
									stroke-linecap="round"
									stroke-linejoin="round"
									class="post-nav-card__arrow post-nav-card__arrow--next"
								>
									<path d="M5 12h14"></path>
									<path d="m12 5 7 7-7 7"></path>
								</svg>
							</span>
						</span>
						<span class="post-nav-card__title line-clamp-3">{nextVM.title}</span>
					</a>
				) : (
					<div aria-hidden="true" class="hidden md:block"></div>
				)}
			</nav>
		</CvSection>
	)}

	{/* ======================= 评论(giscus,未配置时静默跳过) ======================= */}
	<Comments lang={lang} index={commentsIndex} />
</AppShell>

<style>
	.line-clamp-3 {
		display: -webkit-box;
		-webkit-line-clamp: 3;
		-webkit-box-orient: vertical;
		overflow: hidden;
	}

	/* ---------- 上一篇 / 下一篇:大卡片 ---------- */
	.post-nav-card {
		display: flex;
		flex-direction: column;
		justify-content: space-between;
		gap: 2.5rem;
		min-height: 13rem;
		padding: 1.5rem 1.5rem 1.75rem;
	}
	.post-nav-card--next {
		text-align: right;
	}
	.post-nav-card__meta {
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 0.75rem;
		font-family: var(--font-mono);
		font-size: 11px;
		line-height: 1;
		font-weight: 500;
		text-transform: uppercase;
		letter-spacing: var(--tracking-wider);
		color: var(--color-ink-tertiary);
		transition: color var(--duration-fast) var(--ease-standard);
	}
	.post-nav-card:hover .post-nav-card__meta {
		color: var(--color-ink-primary);
	}
	.post-nav-card__arrow {
		flex-shrink: 0;
		transition: transform var(--duration-base) var(--ease-out-expo);
	}
	.post-nav-card:hover .post-nav-card__arrow {
		color: var(--color-signal);
	}
	.post-nav-card:hover .post-nav-card__arrow--prev {
		transform: translateX(-4px);
	}
	.post-nav-card:hover .post-nav-card__arrow--next {
		transform: translateX(4px);
	}
	.post-nav-card__title {
		font-size: clamp(1.375rem, 2.4vw, 2.125rem);
		line-height: 1.12;
		font-weight: 600;
		letter-spacing: -0.035em;
		color: var(--color-ink-primary);
		text-wrap: balance;
	}
	@media (min-width: 1024px) {
		.post-nav-card {
			min-height: 17rem;
			padding: 2rem 2rem 2.25rem;
		}
	}

	/* ---------- 正文图片:可放大提示 ---------- */
	.blog-post-article :global(img) {
		cursor: zoom-in;
		transition:
			transform var(--duration-slow) var(--ease-out-expo),
			opacity var(--duration-base) var(--ease-standard);
	}
	.blog-post-article :global(img:hover) {
		transform: translateY(-2px);
	}

	/* ----------------------------------------------------------------------------
	 * 图片 Lightbox
	 * --------------------------------------------------------------------------
	 * JS 契约不变:去掉 hidden → 下一帧加 data-open="true";关闭时先移除
	 * data-open,220ms 后再 hidden。可见态用 opacity/transform 过渡,
	 * @starting-style 保证"刚从 hidden 出来"那一帧也能播放进场。
	 * -------------------------------------------------------------------------- */
	.image-lightbox {
		position: fixed;
		inset: 0;
		z-index: 100;
		display: flex;
		align-items: center;
		justify-content: center;
		padding: 3.5rem 1.25rem 2rem;
		background-color: color-mix(in oklab, var(--color-paper) 94%, transparent);
		opacity: 0;
		transition: opacity var(--duration-base) var(--ease-standard);
	}
	.image-lightbox[hidden] {
		display: none;
	}
	.image-lightbox[data-open="true"] {
		opacity: 1;
	}
	@starting-style {
		.image-lightbox[data-open="true"] {
			opacity: 0;
		}
	}

	.image-lightbox__close {
		position: absolute;
		top: 1rem;
		right: 1rem;
		display: inline-flex;
		align-items: center;
		gap: 0.5rem;
		height: 32px;
		padding-inline: 0.5rem 0.625rem;
		border-radius: var(--radius-md);
		border: 1px solid var(--color-hairline-strong);
		background-color: var(--color-surface);
		color: var(--color-ink-secondary);
		box-shadow: var(--shadow-card);
		cursor: pointer;
		transition:
			color var(--duration-fast) var(--ease-standard),
			border-color var(--duration-fast) var(--ease-standard);
	}
	.image-lightbox__close:hover {
		color: var(--color-ink-primary);
		border-color: var(--signal-line);
	}
	.image-lightbox__close:focus-visible {
		outline: 2px solid var(--color-signal);
		outline-offset: 2px;
	}
	.image-lightbox__close-key {
		font-family: var(--font-mono);
		font-size: 10px;
		line-height: 1;
		letter-spacing: var(--tracking-wide);
		text-transform: uppercase;
		padding: 3px 5px;
		border-radius: 3px;
		border: 1px solid var(--color-hairline);
		color: var(--color-ink-tertiary);
	}

	.image-lightbox__figure {
		margin: 0;
		display: flex;
		flex-direction: column;
		align-items: center;
		gap: 0.875rem;
		max-width: min(96vw, 1400px);
		max-height: 90vh;
		transform: scale(0.965) translateY(6px);
		transition: transform var(--duration-slow) var(--ease-out-expo);
	}
	.image-lightbox[data-open="true"] .image-lightbox__figure {
		transform: none;
	}
	@starting-style {
		.image-lightbox[data-open="true"] .image-lightbox__figure {
			transform: scale(0.965) translateY(6px);
		}
	}

	.image-lightbox__img {
		display: block;
		max-width: 100%;
		max-height: 80vh;
		width: auto;
		height: auto;
		object-fit: contain;
		border-radius: var(--radius-lg);
		border: 1px solid var(--color-hairline);
		background-color: var(--color-surface);
		box-shadow: var(--shadow-pop);
		cursor: zoom-out;
	}

	.image-lightbox__caption {
		font-family: var(--font-mono);
		font-size: 11.5px;
		letter-spacing: var(--tracking-wide);
		color: var(--color-ink-tertiary);
		text-align: center;
		max-width: 72ch;
	}
	.image-lightbox__caption:empty {
		display: none;
	}

	@media (prefers-reduced-motion: reduce) {
		.image-lightbox,
		.image-lightbox__figure,
		.post-nav-card__arrow,
		.blog-post-article :global(img) {
			transition: none;
		}
	}
</style>

<script>
	/**
	 * ------------------------------------------------------------------------
	 * 博客详情页:图片 Lightbox 交互
	 * ------------------------------------------------------------------------
	 * 绑定对象:.blog-post-article 内所有 <img>
	 * 行为:
	 *   - 点击图片 → 打开 lightbox,填充 src/alt/title
	 *   - 点击遮罩 / 关闭按钮 / 图片本身 / Esc 键 → 关闭
	 *   - 打开时锁定 body 滚动
	 * 使用事件委托,一次绑定在文章容器上,适配 Astro view transitions
	 * ------------------------------------------------------------------------ */
	// 通过 data 属性标记已绑定,避免 ViewTransitions 场景下的重复绑定
	const LIGHTBOX_BOUND_ATTR = "data-lightbox-bound";
	const ESC_HANDLER_KEY = "__zerxLightboxEsc";

	function setupImageLightbox() {
		const article = document.querySelector<HTMLElement>(".blog-post-article");
		const lightbox = document.getElementById("image-lightbox");
		if (!article || !lightbox) return;

		// 幂等:已绑定过就直接返回,防止 astro:page-load 多次注册导致监听重复
		if (article.getAttribute(LIGHTBOX_BOUND_ATTR) === "true") return;
		article.setAttribute(LIGHTBOX_BOUND_ATTR, "true");

		const imgEl = lightbox.querySelector<HTMLImageElement>(
			".image-lightbox__img",
		);
		const captionEl = lightbox.querySelector<HTMLElement>(
			".image-lightbox__caption",
		);
		const closeBtn = lightbox.querySelector<HTMLButtonElement>(
			".image-lightbox__close",
		);
		if (!imgEl || !captionEl || !closeBtn) return;

		let lastFocused: HTMLElement | null = null;

		function open(src: string, alt: string, caption: string) {
			if (!imgEl || !captionEl || !lightbox) return;
			imgEl.src = src;
			imgEl.alt = alt;
			captionEl.textContent = caption;
			lightbox.hidden = false;
			// 下一帧再加 data-open,触发 CSS 过渡
			requestAnimationFrame(() => {
				lightbox.setAttribute("data-open", "true");
				lightbox.setAttribute("aria-hidden", "false");
			});
			document.body.style.overflow = "hidden";
			lastFocused = document.activeElement as HTMLElement | null;
			closeBtn?.focus();
		}

		function close() {
			if (!lightbox) return;
			lightbox.removeAttribute("data-open");
			lightbox.setAttribute("aria-hidden", "true");
			document.body.style.overflow = "";
			// 等过渡结束再 hidden
			window.setTimeout(() => {
				if (!lightbox.hasAttribute("data-open")) {
					lightbox.hidden = true;
					if (imgEl) imgEl.src = "";
				}
			}, 220);
			if (lastFocused && typeof lastFocused.focus === "function") {
				lastFocused.focus();
			}
		}

		article.addEventListener("click", (e) => {
			const target = e.target as HTMLElement | null;
			if (!target) return;
			const img = target.closest("img");
			if (!img || !article.contains(img)) return;
			// 忽略被 <a> 包裹的图片(作者另行指定了跳转意图)
			if (img.closest("a")) return;
			e.preventDefault();
			const src = img.currentSrc || img.src;
			const alt = img.getAttribute("alt") ?? "";
			const title = img.getAttribute("title") ?? "";
			open(src, alt, title || alt);
		});

		closeBtn.addEventListener("click", close);
		lightbox.addEventListener("click", (e) => {
			if (e.target === lightbox || e.target === imgEl) close();
		});

		// Esc 关闭:全局只保留一份,重复初始化时先解绑旧的
		const w = window as unknown as Record<string, unknown>;
		const prevEsc = w[ESC_HANDLER_KEY] as
			| ((e: KeyboardEvent) => void)
			| undefined;
		if (prevEsc) document.removeEventListener("keydown", prevEsc);
		const escHandler = (e: KeyboardEvent) => {
			if (e.key === "Escape" && lightbox.getAttribute("data-open") === "true") {
				close();
			}
		};
		w[ESC_HANDLER_KEY] = escHandler;
		document.addEventListener("keydown", escHandler);

		// 标记图片可点击(供辅助技术识别)
		article.querySelectorAll("img").forEach((img) => {
			if (img.closest("a")) return;
			img.setAttribute("role", "button");
			img.setAttribute("tabindex", "0");
			img.addEventListener("keydown", (e) => {
				const ke = e as KeyboardEvent;
				if (ke.key === "Enter" || ke.key === " ") {
					ke.preventDefault();
					const src = img.currentSrc || img.src;
					const alt = img.getAttribute("alt") ?? "";
					const title = img.getAttribute("title") ?? "";
					open(src, alt, title || alt);
				}
			});
		});
	}

	/**
	 * 标题锚点:给正文 h2–h4 追加 hover 可见的 "#" 链接(纯增强,幂等)。
	 * aria-label 取自文章容器的 data-anchor-label(双语由服务端写入)。
	 */
	function setupHeadingAnchors() {
		const article = document.querySelector<HTMLElement>(".blog-post-article");
		if (!article) return;
		const label = article.dataset.anchorLabel ?? "";
		article
			.querySelectorAll<HTMLHeadingElement>("h2[id], h3[id], h4[id]")
			.forEach((heading) => {
				if (heading.querySelector(".heading-anchor")) return;
				// 脚注区的 sr-only 标题不需要锚点
				if (heading.closest("[data-footnotes]")) return;
				const a = document.createElement("a");
				a.className = "heading-anchor";
				a.href = `#${heading.id}`;
				a.setAttribute("aria-label", label);
				a.textContent = "#";
				heading.appendChild(a);
			});
	}

	function setupPost() {
		setupImageLightbox();
		setupHeadingAnchors();
	}

	// 首次加载 + Astro 客户端导航后(若启用 ViewTransitions)重新初始化
	if (document.readyState === "loading") {
		document.addEventListener("DOMContentLoaded", setupPost);
	} else {
		setupPost();
	}
	document.addEventListener("astro:page-load", setupPost);
</script>
