---
/**
 * ============================================================================
 * BlogSearchBox - 博客列表页搜索入口(客户端搜索)
 * ----------------------------------------------------------------------------
 * 交互:
 *   - 默认态:一个放大镜小图标(与 SectionHeader 右上角 count 对齐)
 *   - 点击 / 聚焦:展开为输入框,自动聚焦
 *   - 输入 ≥ 1 字符:接管页面 —— 隐藏 #post-grid / #blog-pagination /
 *     #blog-category-tabs,把匹配结果渲染进 #search-results(0 命中则显示
 *     #search-empty),这四个容器都由 BlogIndexPage 渲染,本组件只负责按 id 接管
 *   - 清空输入(点击 ✕ / 手动删空 / Esc):恢复默认列表视图
 *   - 按 Esc:输入非空先清空,输入为空则折叠图标
 *   - 点击空白处(outside click):折叠(仅当输入为空)
 *
 * 架构选择(全站切到纯静态构建后,不再有 SSR 可以按 ?q= 重新渲染):
 *   - 搜索索引在构建期由 src/pages/search/[lang].json.ts 产出静态 JSON
 *     (/search/zh.json、/search/en.json),覆盖当前语言下的全部已发布文章
 *   - 首次输入时才 fetch 对应语言的索引,结果缓存在模块作用域(indexCache),
 *     同一语言的索引只下载一次,后续按键仅在内存里过滤
 *   - 搜索不再影响 URL / 不再分页 / 不再受当前分类筛选影响 —— 客户端搜索
 *     覆盖全站该语言下的所有文章,体验上更像"站内检索"而非"列表过滤"
 *   - 高亮复用 @lib/highlight 的 highlight():该函数已完成 HTML 转义,
 *     结果用 innerHTML 写入是安全的;其余字段(分类名、日期等)一律用
 *     textContent 写入,双重保险防 XSS
 *
 * a11y:
 *   - 放大镜按钮有 aria-label 与 aria-expanded
 *   - 输入框有 aria-label;图标用 aria-hidden
 *   - role="search" 标注整个交互区域
 *
 * 视觉约束:
 *   - 编辑派风格:无圆角,1px 发丝边框,展开动画仅宽度过渡
 *   - 与 SectionHeader 的 eyebrow / count 同一基线(11px mono)
 *   - 折叠态图标大小 = 右侧 count 的字号约束,保证不冲击标题行视觉节奏
 * ============================================================================
 */

import { getLangFromUrl } from "@i18n/utils";
import type { Lang } from "@i18n/ui";

interface Props {
	/**
	 * 列表页根路径,不带结尾斜杠,例如 "/blog" 或 "/en/blog"。
	 * 搜索结果链接会拼成 `${listBase}/<slug>/`。
	 */
	listBase: string;
	/** 额外类名 */
	class?: string;
}

const { listBase, class: className = "" } = Astro.props;

// 当前语言(决定 placeholder / aria-label 文案,以及拉取哪份搜索索引)
const lang = getLangFromUrl(Astro.url) as Lang;

const LABELS = {
	zh: {
		openLabel: "打开搜索",
		closeLabel: "关闭搜索",
		inputLabel: "搜索文章",
		clearLabel: "清空搜索",
		placeholder: "搜索标题或内容…",
	},
	en: {
		openLabel: "Open search",
		closeLabel: "Close search",
		inputLabel: "Search posts",
		clearLabel: "Clear search",
		placeholder: "Search title or content…",
	},
} as const;

const L = LABELS[lang] ?? LABELS.zh;
---

<div
	role="search"
	data-blog-search
	data-lang={lang}
	data-list-base={listBase}
	class:list={["blog-search", "relative inline-flex items-center", className]}
>
	{/* ------------------------------------------------------------------
	 *  放大镜按钮(折叠态的视觉主体;展开态隐藏)
	 * ------------------------------------------------------------------ */}
	<button
		type="button"
		data-blog-search-toggle
		aria-label={L.openLabel}
		aria-expanded="false"
		class:list={[
			"blog-search__toggle",
			"inline-flex items-center justify-center",
			"h-7 w-7",
			"text-[color:var(--color-ink-tertiary)]",
			"hover:text-[color:var(--color-ink-primary)]",
			"transition-colors duration-[var(--duration-fast)] ease-[var(--ease-standard)]",
			"cursor-pointer",
			"bg-transparent",
			"border-0",
			"p-0",
			"focus:outline-none focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-[color:var(--color-ink-primary)]",
		]}
	>
		<svg
			aria-hidden="true"
			width="14"
			height="14"
			viewBox="0 0 24 24"
			fill="none"
			stroke="currentColor"
			stroke-width="2"
			stroke-linecap="round"
			stroke-linejoin="round"
		>
			<circle cx="11" cy="11" r="7"></circle>
			<line x1="21" y1="21" x2="16.65" y2="16.65"></line>
		</svg>
	</button>

	{/* ------------------------------------------------------------------
	 *  输入框容器(展开态的视觉主体;折叠态隐藏)
	 *  ------------------------------------------------------------------
	 *  结构:[小放大镜图标(纯装饰,不再是提交按钮)] [input] [可选的清空 ✕]
	 * ------------------------------------------------------------------ */}
	<div
		data-blog-search-panel
		class:list={[
			"blog-search__panel",
			"relative inline-flex items-center",
			"h-7",
			"border border-[color:var(--color-hairline)]",
			"bg-[color:var(--color-paper)]",
			"pl-2 pr-1",
			"gap-1",
			"transition-[width,opacity] duration-[var(--duration-base)] ease-[var(--ease-standard)]",
		]}
	>
		<svg
			aria-hidden="true"
			width="12"
			height="12"
			viewBox="0 0 24 24"
			fill="none"
			stroke="currentColor"
			stroke-width="2"
			stroke-linecap="round"
			stroke-linejoin="round"
			class="shrink-0 text-[color:var(--color-ink-tertiary)]"
		>
			<circle cx="11" cy="11" r="7"></circle>
			<line x1="21" y1="21" x2="16.65" y2="16.65"></line>
		</svg>

		<input
			type="search"
			value=""
			aria-label={L.inputLabel}
			placeholder={L.placeholder}
			autocomplete="off"
			autocorrect="off"
			autocapitalize="off"
			spellcheck="false"
			data-blog-search-input
			class:list={[
				"blog-search__input",
				"h-full",
				// 展开态的实际可输入宽度,JS 会在展开时给父级加 data-expanded
				"w-[160px] sm:w-[200px] lg:w-[220px]",
				"bg-transparent",
				"border-0",
				"p-0",
				"font-[var(--font-sans)]",
				"text-[12px]",
				"leading-none",
				"text-[color:var(--color-ink-primary)]",
				"placeholder:text-[color:var(--color-ink-muted)]",
				"focus:outline-none",
			]}
		/>

		{/* 清空按钮:输入为空时隐藏,由 JS 按 input 值动态切换 */}
		<button
			type="button"
			data-blog-search-clear
			aria-label={L.clearLabel}
			hidden
			class:list={[
				"inline-flex items-center justify-center",
				"h-5 w-5 shrink-0",
				"text-[color:var(--color-ink-muted)]",
				"hover:text-[color:var(--color-ink-primary)]",
				"transition-colors duration-[var(--duration-fast)] ease-[var(--ease-standard)]",
				"bg-transparent border-0 p-0 cursor-pointer",
				"focus:outline-none focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-[color:var(--color-ink-primary)]",
			]}
		>
			<svg
				aria-hidden="true"
				width="11"
				height="11"
				viewBox="0 0 24 24"
				fill="none"
				stroke="currentColor"
				stroke-width="2.2"
				stroke-linecap="round"
				stroke-linejoin="round"
			>
				<line x1="18" y1="6" x2="6" y2="18"></line>
				<line x1="6" y1="6" x2="18" y2="18"></line>
			</svg>
		</button>
	</div>
</div>

{/* ====================================================================
 *                  展开 / 折叠 / 搜索过滤 脚本
 * --------------------------------------------------------------------
 * 本组件不渲染搜索结果的容器 —— #post-grid / #search-results /
 * #search-empty / #blog-pagination / #blog-category-tabs 都由
 * BlogIndexPage 渲染,本脚本只按固定 id 接管它们的可见性 + 内容。
 * 每个 [data-blog-search] 独立工作(本项目只用一个实例)。
 * ==================================================================== */}
<script>
	import { highlight } from "@lib/highlight";
	import { formatDate } from "@i18n/utils";
	import { ui, type Lang } from "@i18n/ui";

	/** src/pages/search/[lang].json.ts 产出的静态索引单条形状 */
	interface SearchIndexItem {
		slug: string;
		title: string;
		excerpt: string;
		category: string;
		categoryName: string;
		date: string;
		readingTime: number;
		coverLabel: string;
		text: string;
	}

	type SearchRoot = HTMLElement & { __blogSearchInitialized?: boolean };

	// 索引缓存:同一语言的 JSON 只 fetch 一次,模块作用域内跨多次按键复用
	const indexCache = new Map<Lang, Promise<readonly SearchIndexItem[]>>();

	function loadIndex(lang: Lang): Promise<readonly SearchIndexItem[]> {
		let promise = indexCache.get(lang);
		if (!promise) {
			promise = fetch(`/search/${lang}.json`)
				.then((res) => (res.ok ? (res.json() as Promise<SearchIndexItem[]>) : []))
				.catch(() => []);
			indexCache.set(lang, promise);
		}
		return promise;
	}

	function dotSeparator(): HTMLSpanElement {
		const span = document.createElement("span");
		span.setAttribute("aria-hidden", "true");
		span.className = "text-[color:var(--color-ink-muted)]";
		span.textContent = "·";
		return span;
	}

	/** 视觉贴近 PostCard 文字区(标题 + 摘要 + 分类/日期/时长),无封面 */
	function buildResultCard(
		item: SearchIndexItem,
		query: string,
		listBase: string,
		lang: Lang,
	): HTMLAnchorElement {
		const card = document.createElement("a");
		card.href = `${listBase}/${item.slug}/`;
		card.className =
			"search-result-card group relative flex flex-col gap-2 " +
			"px-4 sm:px-5 lg:px-6 py-5 lg:py-6 bg-transparent " +
			"hover:bg-[color:var(--color-paper-muted)]/60 " +
			"transition-colors duration-[var(--duration-base)] ease-[var(--ease-standard)] " +
			"no-underline cursor-pointer";

		const title = document.createElement("h3");
		title.className =
			"font-medium text-[color:var(--color-ink-primary)] tracking-[-0.015em] " +
			"leading-[1.35] text-[17px] sm:text-[18px] lg:text-[19px] line-clamp-2";
		title.innerHTML = highlight(item.title, query);

		const excerpt = document.createElement("p");
		excerpt.className =
			"text-[color:var(--color-ink-secondary)] text-[13.5px] sm:text-[14px] " +
			"leading-[1.6] line-clamp-2 max-w-[72ch]";
		excerpt.innerHTML = highlight(item.excerpt, query);

		const meta = document.createElement("div");
		meta.className =
			"flex items-center gap-2 flex-wrap font-[var(--font-mono)] " +
			"text-[10.5px] sm:text-[11px] leading-none tracking-[var(--tracking-wide)] " +
			"text-[color:var(--color-ink-tertiary)] tabular-nums";

		if (item.categoryName) {
			const cat = document.createElement("span");
			cat.className = "uppercase text-[color:var(--color-ink-secondary)]";
			cat.textContent = item.categoryName;
			meta.append(cat, dotSeparator());
		}

		const time = document.createElement("time");
		const dateObj = new Date(item.date);
		if (!Number.isNaN(dateObj.getTime())) {
			time.dateTime = dateObj.toISOString();
		}
		time.textContent = formatDate(item.date, lang);
		meta.append(time);

		if (item.readingTime > 0) {
			const rt = document.createElement("span");
			rt.className = "uppercase";
			rt.textContent = `${item.readingTime} ${ui[lang]["blog.minutes"]}`;
			meta.append(dotSeparator(), rt);
		}

		card.append(title, excerpt, meta);
		return card;
	}

	function initBlogSearch(root: SearchRoot): void {
		if (root.__blogSearchInitialized) return;
		root.__blogSearchInitialized = true;

		const toggleBtn = root.querySelector<HTMLButtonElement>(
			"[data-blog-search-toggle]",
		);
		const panel = root.querySelector<HTMLElement>("[data-blog-search-panel]");
		const input = root.querySelector<HTMLInputElement>(
			"[data-blog-search-input]",
		);
		const clearBtn = root.querySelector<HTMLButtonElement>(
			"[data-blog-search-clear]",
		);

		if (!toggleBtn || !panel || !input) return;

		const lang = (root.getAttribute("data-lang") as Lang | null) ?? "zh";
		const listBase = root.getAttribute("data-list-base") ?? "/blog";

		// 这四个容器都由 BlogIndexPage 渲染,id 全站唯一
		const postGrid = document.getElementById("post-grid");
		const pagination = document.getElementById("blog-pagination");
		const categoryTabs = document.getElementById("blog-category-tabs");
		const resultsContainer = document.getElementById("search-results");
		const emptyContainer = document.getElementById("search-empty");

		function setExpanded(expanded: boolean, focusInput = false): void {
			root.setAttribute("data-expanded", expanded ? "true" : "false");
			toggleBtn!.setAttribute("aria-expanded", expanded ? "true" : "false");
			if (expanded && focusInput) {
				requestAnimationFrame(() => input!.focus());
			}
		}

		function updateClearVisibility(): void {
			if (!clearBtn) return;
			clearBtn.hidden = input!.value.length === 0;
		}

		function showDefaultView(): void {
			resultsContainer?.setAttribute("hidden", "");
			emptyContainer?.setAttribute("hidden", "");
			postGrid?.removeAttribute("hidden");
			pagination?.removeAttribute("hidden");
			categoryTabs?.removeAttribute("hidden");
		}

		function showSearchView(): void {
			postGrid?.setAttribute("hidden", "");
			pagination?.setAttribute("hidden", "");
			categoryTabs?.setAttribute("hidden", "");
		}

		async function runSearch(rawQuery: string): Promise<void> {
			const query = rawQuery.trim();
			if (query.length === 0) {
				showDefaultView();
				return;
			}

			showSearchView();
			const needle = query.toLowerCase();
			const items = await loadIndex(lang);

			// 异步期间用户可能已经改变了输入内容,回填前重新校验,避免竞态覆盖
			if (input!.value.trim().toLowerCase() !== needle) return;
			if (!resultsContainer || !emptyContainer) return;

			const matches = items.filter((item) => item.text.includes(needle));

			resultsContainer.replaceChildren(
				...matches.map((item) => buildResultCard(item, query, listBase, lang)),
			);

			if (matches.length === 0) {
				resultsContainer.setAttribute("hidden", "");
				emptyContainer.removeAttribute("hidden");
			} else {
				resultsContainer.removeAttribute("hidden");
				emptyContainer.setAttribute("hidden", "");
			}
		}

		// 初始状态:折叠 + 隐藏清空按钮 + 默认列表视图
		setExpanded(false);
		updateClearVisibility();

		toggleBtn.addEventListener("click", () => {
			setExpanded(true, true);
		});

		input.addEventListener("input", () => {
			updateClearVisibility();
			void runSearch(input.value);
		});

		clearBtn?.addEventListener("click", () => {
			input.value = "";
			updateClearVisibility();
			void runSearch("");
			input.focus();
		});

		input.addEventListener("keydown", (e: KeyboardEvent) => {
			if (e.key === "Escape") {
				if (input.value.length > 0) {
					input.value = "";
					updateClearVisibility();
					void runSearch("");
					e.preventDefault();
				} else {
					setExpanded(false);
					toggleBtn.focus();
				}
			}
		});

		// 外部点击折叠(仅当 input 为空时;有搜索词保持展开,让用户能继续改)
		document.addEventListener(
			"click",
			(e: MouseEvent) => {
				const target = e.target as Node | null;
				if (!target) return;
				if (root.contains(target)) return;
				if (input.value.length === 0) {
					setExpanded(false);
				}
			},
			{ capture: true },
		);
	}

	function initAll(): void {
		document
			.querySelectorAll<SearchRoot>("[data-blog-search]")
			.forEach(initBlogSearch);
	}

	// 首次加载 + Astro 客户端导航后(若启用 ViewTransitions)重新初始化
	if (document.readyState === "loading") {
		document.addEventListener("DOMContentLoaded", initAll);
	} else {
		initAll();
	}
	document.addEventListener("astro:page-load", initAll);
</script>

<style>
	/* ------------------------------------------------------------------
	 *  展开 / 折叠状态切换
	 *  ------------------------------------------------------------------
	 *  通过根元素上的 data-expanded 属性,让子元素按状态显隐 / 调整宽度。
	 *  CSS 里完成切换意味着 JS 只需翻转一个属性,无需手动增删 class。
	 *  首屏(JS 还没跑)默认折叠 —— 搜索不再由 URL 驱动初始状态。
	 * ------------------------------------------------------------------ */

	/* 折叠态(含首屏无 JS 时):只显示放大镜按钮,panel 隐藏且不占空间 */
	[data-blog-search]:not([data-expanded="true"]) .blog-search__panel {
		display: none;
	}

	/* 展开态:隐藏放大镜按钮,显示输入面板 */
	[data-blog-search][data-expanded="true"] .blog-search__toggle {
		display: none;
	}

	/* 输入框聚焦时,容器边框加深,提供清晰反馈 */
	.blog-search__panel:focus-within {
		border-color: var(--color-ink-primary);
	}

	/* 关闭 input[type=search] 在 Chrome 下自带的 x 清除按钮,
	   使用我们自己的 ✕,风格与站点一致 */
	.blog-search__input::-webkit-search-cancel-button,
	.blog-search__input::-webkit-search-decoration {
		-webkit-appearance: none;
		appearance: none;
	}

	/* ------------------------------------------------------------------
	 *  搜索高亮 <mark class="search-hit">
	 *  ------------------------------------------------------------------
	 *  由 @lib/highlight 的 highlight() 产出,通过 JS innerHTML 写入
	 *  #search-results 里的结果卡片(不经过 PostCard,故这里不能依赖
	 *  PostCard 的 scoped 样式,需要一份 :global() 规则兜底)。
	 *  颜色 / 阴影与 PostCard 里的搜索高亮保持一致。
	 * ------------------------------------------------------------------ */
	:global(mark.search-hit) {
		background-color: rgba(250, 204, 21, 0.32); /* amber-400 / ~32% */
		color: inherit;
		padding: 0 1px;
		border-radius: 1px;
		box-shadow: inset 0 -1px 0 rgba(202, 138, 4, 0.45);
	}

	:global(:root.dark mark.search-hit) {
		background-color: rgba(250, 204, 21, 0.22);
		box-shadow: inset 0 -1px 0 rgba(250, 204, 21, 0.35);
	}
</style>
