---
/**
 * ============================================================================
 * BlogSearchBox - 博客列表页搜索入口(客户端搜索)
 * ----------------------------------------------------------------------------
 * 交互:
 *   - 默认态:紧凑的"搜索"触发按钮(放大镜 + mono 标签)
 *   - 点击:展开为输入框(从右向左 scaleX 淡入),自动聚焦;空输入时右侧
 *     显示 `.kbd` Esc 提示(Esc 确实可折叠 / 清空,见脚本)
 *   - 输入 ≥ 1 字符:接管页面 —— 隐藏 #post-grid / #blog-pagination /
 *     #blog-category-tabs,把匹配结果渲染进 #search-results(0 命中则显示
 *     #search-empty);结果条目分段淡入上浮,命中词用 Signal 柔色底高亮
 *   - 清空输入(✕ / 删空 / Esc):恢复默认列表视图
 *   - Esc:输入非空先清空,输入为空则折叠;外部点击(输入为空时)折叠
 *
 * 架构:
 *   - 索引由 src/pages/search/[lang].json.ts 构建期产出(/search/<lang>.json),
 *     首次输入时才 fetch,按语言缓存在模块作用域
 *   - 搜索覆盖该语言全部文章,不影响 URL / 分页 / 分类筛选
 *   - 高亮复用 @lib/highlight(已转义,可安全 innerHTML);其余字段一律 textContent
 *
 * a11y:触发按钮 aria-label + aria-expanded;输入框 aria-label;role="search"
 * ============================================================================
 */

import { getLangFromUrl } from "@i18n/utils";
import type { Lang } from "@i18n/ui";

interface Props {
	/**
	 * 列表页根路径,不带结尾斜杠,例如 "/blog" 或 "/en/blog"。
	 * 搜索结果链接会拼成 `${listBase}/<slug>/`。
	 */
	listBase: string;
	/** 额外类名 */
	class?: string;
}

const { listBase, class: className = "" } = Astro.props;

// 当前语言(决定 placeholder / aria-label 文案,以及拉取哪份搜索索引)
const lang = getLangFromUrl(Astro.url) as Lang;

const LABELS = {
	zh: {
		openLabel: "打开搜索",
		closeLabel: "关闭搜索",
		inputLabel: "搜索文章",
		clearLabel: "清空搜索",
		placeholder: "搜索标题或内容…",
		triggerText: "搜索",
	},
	en: {
		openLabel: "Open search",
		closeLabel: "Close search",
		inputLabel: "Search posts",
		clearLabel: "Clear search",
		placeholder: "Search title or content…",
		triggerText: "Search",
	},
} as const;

const L = LABELS[lang] ?? LABELS.zh;
---

<div
	role="search"
	data-blog-search
	data-lang={lang}
	data-list-base={listBase}
	class:list={["blog-search", "relative inline-flex items-center", className]}
>
	{/* 折叠态:触发按钮 */}
	<button
		type="button"
		data-blog-search-toggle
		aria-label={L.openLabel}
		aria-expanded="false"
		class="blog-search__toggle"
	>
		<svg aria-hidden="true" width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
			<circle cx="11" cy="11" r="7"></circle>
			<line x1="21" y1="21" x2="16.65" y2="16.65"></line>
		</svg>
		<span aria-hidden="true" class="hidden sm:inline">{L.triggerText}</span>
	</button>

	{/* 展开态:[放大镜] [input] [Esc 提示 | 清空 ✕] */}
	<div data-blog-search-panel class="blog-search__panel">
		<svg aria-hidden="true" width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="blog-search__icon">
			<circle cx="11" cy="11" r="7"></circle>
			<line x1="21" y1="21" x2="16.65" y2="16.65"></line>
		</svg>

		<input
			type="search"
			value=""
			aria-label={L.inputLabel}
			placeholder={L.placeholder}
			autocomplete="off"
			autocorrect="off"
			autocapitalize="off"
			spellcheck="false"
			data-blog-search-input
			class:list={[
				"blog-search__input",
				"h-full min-w-0 w-[150px] sm:w-[200px] lg:w-[220px]",
				"border-0 bg-transparent p-0",
				"font-[var(--font-sans)] text-[13px] leading-none",
				"text-[color:var(--color-ink-primary)]",
				"placeholder:text-[color:var(--color-ink-muted)]",
				"focus:outline-none",
			]}
		/>

		<kbd aria-hidden="true" class="kbd blog-search__esc">Esc</kbd>

		{/* 清空按钮:输入为空时隐藏,由 JS 按 input 值切换 */}
		<button
			type="button"
			data-blog-search-clear
			aria-label={L.clearLabel}
			hidden
			class="blog-search__clear"
		>
			<svg aria-hidden="true" width="10" height="10" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round">
				<line x1="18" y1="6" x2="6" y2="18"></line>
				<line x1="6" y1="6" x2="18" y2="18"></line>
			</svg>
		</button>
	</div>
</div>

{/* ====================================================================
 *                  展开 / 折叠 / 搜索过滤 脚本
 * --------------------------------------------------------------------
 * 本组件不渲染搜索结果的容器 —— #post-grid / #search-results /
 * #search-empty / #blog-pagination / #blog-category-tabs 都由
 * BlogIndexPage 渲染,本脚本只按固定 id 接管它们的可见性 + 内容。
 * 每个 [data-blog-search] 独立工作(本项目只用一个实例)。
 * ==================================================================== */}
<script>
	import { highlight } from "@lib/highlight";
	import { formatDateCompact } from "@i18n/utils";
	import { ui, type Lang } from "@i18n/ui";

	/** src/pages/search/[lang].json.ts 产出的静态索引单条形状 */
	interface SearchIndexItem {
		slug: string;
		title: string;
		excerpt: string;
		category: string;
		categoryName: string;
		date: string;
		readingTime: number;
		coverLabel: string;
		text: string;
	}

	type SearchRoot = HTMLElement & { __blogSearchInitialized?: boolean };

	// 索引缓存:同一语言的 JSON 只 fetch 一次,模块作用域内跨多次按键复用
	const indexCache = new Map<Lang, Promise<readonly SearchIndexItem[]>>();

	function loadIndex(lang: Lang): Promise<readonly SearchIndexItem[]> {
		let promise = indexCache.get(lang);
		if (!promise) {
			promise = fetch(`/search/${lang}.json`)
				.then((res) => (res.ok ? (res.json() as Promise<SearchIndexItem[]>) : []))
				.catch(() => []);
			indexCache.set(lang, promise);
		}
		return promise;
	}

	/** 结构与样式对齐 PostCard 时间线行:左窄列完整日期 + 分类(搜索结果不分月),右侧标题 / 摘要 / 时长 */
	function buildResultCard(
		item: SearchIndexItem,
		query: string,
		listBase: string,
		lang: Lang,
		index: number,
	): HTMLAnchorElement {
		const card = document.createElement("a");
		card.href = `${listBase}/${item.slug}/`;
		card.className = "search-result-card";
		card.style.setProperty("--i", String(Math.min(index, 8)));

		const side = document.createElement("div");
		side.className = "search-result-card__side";

		const time = document.createElement("time");
		time.className = "search-result-card__date";
		const dateObj = new Date(item.date);
		if (!Number.isNaN(dateObj.getTime())) {
			time.dateTime = dateObj.toISOString();
		}
		time.textContent = formatDateCompact(item.date).replaceAll("-", ".");
		side.append(time);

		if (item.categoryName) {
			const cat = document.createElement("span");
			cat.className = "search-result-card__cat";
			cat.textContent = item.categoryName;
			side.append(cat);
		}

		const body = document.createElement("div");
		body.className = "search-result-card__body";

		const title = document.createElement("h3");
		title.className = "search-result-card__title";
		title.innerHTML = highlight(item.title, query);

		const excerpt = document.createElement("p");
		excerpt.className = "search-result-card__excerpt";
		excerpt.innerHTML = highlight(item.excerpt, query);

		body.append(title, excerpt);

		if (item.readingTime > 0) {
			const rt = document.createElement("span");
			rt.className = "search-result-card__meta";
			rt.textContent = `${item.readingTime} ${ui[lang]["blog.minutes"]}`;
			body.append(rt);
		}

		card.append(side, body);
		return card;
	}

	function initBlogSearch(root: SearchRoot): void {
		if (root.__blogSearchInitialized) return;
		root.__blogSearchInitialized = true;

		const toggleBtn = root.querySelector<HTMLButtonElement>(
			"[data-blog-search-toggle]",
		);
		const panel = root.querySelector<HTMLElement>("[data-blog-search-panel]");
		const input = root.querySelector<HTMLInputElement>(
			"[data-blog-search-input]",
		);
		const clearBtn = root.querySelector<HTMLButtonElement>(
			"[data-blog-search-clear]",
		);

		if (!toggleBtn || !panel || !input) return;

		const lang = (root.getAttribute("data-lang") as Lang | null) ?? "zh";
		const listBase = root.getAttribute("data-list-base") ?? "/blog";

		// 这四个容器都由 BlogIndexPage 渲染,id 全站唯一
		const postGrid = document.getElementById("post-grid");
		const pagination = document.getElementById("blog-pagination");
		const categoryTabs = document.getElementById("blog-category-tabs");
		const resultsContainer = document.getElementById("search-results");
		const emptyContainer = document.getElementById("search-empty");

		function setExpanded(expanded: boolean, focusInput = false): void {
			root.setAttribute("data-expanded", expanded ? "true" : "false");
			toggleBtn!.setAttribute("aria-expanded", expanded ? "true" : "false");
			if (expanded && focusInput) {
				requestAnimationFrame(() => input!.focus());
			}
		}

		function updateClearVisibility(): void {
			if (!clearBtn) return;
			clearBtn.hidden = input!.value.length === 0;
		}

		function showDefaultView(): void {
			resultsContainer?.setAttribute("hidden", "");
			emptyContainer?.setAttribute("hidden", "");
			postGrid?.removeAttribute("hidden");
			pagination?.removeAttribute("hidden");
			categoryTabs?.removeAttribute("hidden");
		}

		function showSearchView(): void {
			postGrid?.setAttribute("hidden", "");
			pagination?.setAttribute("hidden", "");
			categoryTabs?.setAttribute("hidden", "");
		}

		async function runSearch(rawQuery: string): Promise<void> {
			const query = rawQuery.trim();
			if (query.length === 0) {
				showDefaultView();
				return;
			}

			showSearchView();
			const needle = query.toLowerCase();
			const items = await loadIndex(lang);

			// 异步期间用户可能已经改变了输入内容,回填前重新校验,避免竞态覆盖
			if (input!.value.trim().toLowerCase() !== needle) return;
			if (!resultsContainer || !emptyContainer) return;

			const matches = items.filter((item) => item.text.includes(needle));

			resultsContainer.replaceChildren(
				...matches.map((item, i) => buildResultCard(item, query, listBase, lang, i)),
			);

			if (matches.length === 0) {
				resultsContainer.setAttribute("hidden", "");
				emptyContainer.removeAttribute("hidden");
			} else {
				resultsContainer.removeAttribute("hidden");
				emptyContainer.setAttribute("hidden", "");
			}
		}

		// 初始状态:折叠 + 隐藏清空按钮 + 默认列表视图
		setExpanded(false);
		updateClearVisibility();

		toggleBtn.addEventListener("click", () => {
			setExpanded(true, true);
		});

		input.addEventListener("input", () => {
			updateClearVisibility();
			void runSearch(input.value);
		});

		clearBtn?.addEventListener("click", () => {
			input.value = "";
			updateClearVisibility();
			void runSearch("");
			input.focus();
		});

		input.addEventListener("keydown", (e: KeyboardEvent) => {
			if (e.key === "Escape") {
				if (input.value.length > 0) {
					input.value = "";
					updateClearVisibility();
					void runSearch("");
					e.preventDefault();
				} else {
					setExpanded(false);
					toggleBtn.focus();
				}
			}
		});

		// 外部点击折叠(仅当 input 为空时;有搜索词保持展开,让用户能继续改)
		document.addEventListener(
			"click",
			(e: MouseEvent) => {
				const target = e.target as Node | null;
				if (!target) return;
				if (root.contains(target)) return;
				if (input.value.length === 0) {
					setExpanded(false);
				}
			},
			{ capture: true },
		);
	}

	function initAll(): void {
		document
			.querySelectorAll<SearchRoot>("[data-blog-search]")
			.forEach(initBlogSearch);
	}

	// 首次加载 + Astro 客户端导航后(若启用 ViewTransitions)重新初始化
	if (document.readyState === "loading") {
		document.addEventListener("DOMContentLoaded", initAll);
	} else {
		initAll();
	}
	document.addEventListener("astro:page-load", initAll);
</script>

<style>
	/* ---------------- 折叠 / 展开(JS 只翻转根元素 data-expanded) ---------------- */
	[data-blog-search]:not([data-expanded="true"]) .blog-search__panel {
		display: none;
	}
	[data-blog-search][data-expanded="true"] .blog-search__toggle {
		display: none;
	}

	.blog-search__toggle {
		display: inline-flex;
		align-items: center;
		gap: 0.45rem;
		height: 2.125rem;
		min-width: 2.125rem;
		justify-content: center;
		padding-inline: 0.625rem;
		font-family: var(--font-mono);
		font-size: 10.5px;
		font-weight: 500;
		line-height: 1;
		text-transform: uppercase;
		letter-spacing: var(--tracking-wide);
		color: var(--color-ink-secondary);
		background-color: color-mix(in oklab, var(--color-surface) 60%, transparent);
		border: 1px solid var(--color-hairline-strong);
		border-radius: var(--radius-md);
		cursor: pointer;
		transition:
			color var(--duration-fast) var(--ease-standard),
			border-color var(--duration-fast) var(--ease-standard),
			background-color var(--duration-fast) var(--ease-standard);
	}
	.blog-search__toggle:hover {
		color: var(--color-ink-primary);
		border-color: var(--color-ink-muted);
		background-color: var(--color-surface-raised);
	}

	.blog-search__panel {
		position: relative;
		display: inline-flex;
		align-items: center;
		gap: 0.5rem;
		height: 2.125rem;
		padding-inline: 0.625rem 0.375rem;
		background-color: var(--color-surface-raised);
		border: 1px solid var(--color-hairline-strong);
		border-radius: var(--radius-md);
		transform-origin: right center;
		animation: search-open var(--duration-slow) var(--ease-out-expo) both;
		transition:
			border-color var(--duration-fast) var(--ease-standard),
			box-shadow var(--duration-base) var(--ease-standard);
	}
	.blog-search__panel:focus-within {
		border-color: var(--signal-line);
		box-shadow: 0 0 0 3px var(--signal-soft);
	}
	.blog-search__icon {
		flex-shrink: 0;
		color: var(--color-ink-tertiary);
		transition: color var(--duration-fast) var(--ease-standard);
	}
	.blog-search__panel:focus-within .blog-search__icon {
		color: var(--color-signal);
	}

	@keyframes search-open {
		from {
			opacity: 0;
			transform: scaleX(0.9);
		}
	}

	/* Esc 提示:仅在输入为空时显示,输入后让位给清空按钮 */
	.blog-search__esc {
		flex-shrink: 0;
		transition: opacity var(--duration-fast) var(--ease-standard);
	}
	.blog-search__panel:has(.blog-search__input:not(:placeholder-shown)) .blog-search__esc {
		display: none;
	}

	.blog-search__clear {
		display: inline-flex;
		align-items: center;
		justify-content: center;
		flex-shrink: 0;
		width: 1.25rem;
		height: 1.25rem;
		padding: 0;
		color: var(--color-ink-tertiary);
		background-color: var(--color-paper-muted);
		border: 0;
		border-radius: var(--radius-sm);
		cursor: pointer;
		animation: search-pop var(--duration-base) var(--ease-spring) both;
		transition: color var(--duration-fast) var(--ease-standard);
	}
	.blog-search__clear[hidden] {
		display: none;
	}
	.blog-search__clear:hover {
		color: var(--color-ink-primary);
	}

	@keyframes search-pop {
		from {
			opacity: 0;
			transform: scale(0.6);
		}
	}

	/* 关闭浏览器自带的 search 清除按钮,使用自己的 ✕ */
	.blog-search__input::-webkit-search-cancel-button,
	.blog-search__input::-webkit-search-decoration {
		-webkit-appearance: none;
		appearance: none;
	}

	/* ---------------- 搜索结果条目(JS 生成,需 :global) ----------------
	 * 与 PostCard 时间线行同一套尺度:行距、标题字号、hover 底色外扩一致;
	 * 结果不按月分组,因此左列放完整日期。counter-increment 供 BlogIndexPage
	 * 的结果栏用 CSS 计数器显示命中数(纯展示,不影响脚本)。 */
	:global(.search-result-card) {
		position: relative;
		isolation: isolate;
		display: grid;
		grid-template-columns: minmax(0, 1fr);
		gap: 0.625rem 2rem;
		padding-block: 1.5rem;
		counter-increment: search-hits;
		animation: search-result-in var(--duration-slow) var(--ease-out-expo) backwards;
		animation-delay: calc(var(--i, 0) * 40ms);
	}
	@media (min-width: 640px) {
		:global(.search-result-card) {
			grid-template-columns: 7rem minmax(0, 1fr);
		}
	}
	@media (min-width: 1024px) {
		:global(.search-result-card) {
			padding-block: 1.75rem;
		}
	}
	:global(.search-result-card)::before {
		content: "";
		position: absolute;
		inset: 0.375rem -0.875rem;
		z-index: -1;
		border-radius: var(--radius-md);
		background-color: var(--color-surface);
		box-shadow: 0 0 0 1px var(--color-hairline);
		opacity: 0;
		transition: opacity var(--duration-base) var(--ease-standard);
	}
	:global(.search-result-card:hover)::before,
	:global(.search-result-card:focus-visible)::before {
		opacity: 1;
	}
	:global(.search-result-card__side) {
		display: flex;
		align-items: baseline;
		gap: 0.5rem 0.75rem;
	}
	@media (min-width: 640px) {
		:global(.search-result-card__side) {
			flex-direction: column;
			align-items: flex-start;
			padding-top: 3px;
		}
	}
	:global(.search-result-card__date) {
		font-family: var(--font-mono);
		font-size: 12px;
		line-height: 1;
		letter-spacing: 0.02em;
		font-variant-numeric: tabular-nums;
		color: var(--color-ink-secondary);
		transition: color var(--duration-fast) var(--ease-standard);
	}
	:global(.search-result-card:hover .search-result-card__date) {
		color: var(--color-signal);
	}
	:global(.search-result-card__cat),
	:global(.search-result-card__meta) {
		font-family: var(--font-mono);
		font-size: 10.5px;
		line-height: 1;
		text-transform: uppercase;
		letter-spacing: var(--tracking-wide);
		color: var(--color-ink-muted);
	}
	:global(.search-result-card__meta) {
		margin-top: 0.375rem;
		color: var(--color-ink-tertiary);
	}
	:global(.search-result-card__body) {
		display: flex;
		min-width: 0;
		flex-direction: column;
		gap: 0.5rem;
	}
	:global(.search-result-card__title),
	:global(.search-result-card__excerpt) {
		display: -webkit-box;
		-webkit-box-orient: vertical;
		-webkit-line-clamp: 2;
		overflow: hidden;
	}
	:global(.search-result-card__title) {
		font-size: 18px;
		font-weight: 600;
		line-height: 1.3;
		letter-spacing: -0.022em;
		color: var(--color-ink-primary);
	}
	@media (min-width: 1024px) {
		:global(.search-result-card__title) {
			font-size: 20px;
		}
	}
	:global(.search-result-card__excerpt) {
		max-width: 68ch;
		font-size: 14px;
		line-height: 1.6;
		color: var(--color-ink-tertiary);
	}

	@keyframes search-result-in {
		from {
			opacity: 0;
			transform: translate3d(0, 8px, 0);
		}
	}

	/* ---------------- 命中高亮:Signal 柔色底 ---------------- */
	:global(mark.search-hit) {
		color: inherit;
		background-color: color-mix(in oklab, var(--color-signal) 16%, transparent);
		box-shadow: inset 0 -1px 0 var(--signal-line);
		border-radius: 2px;
		padding: 0 1px;
	}
</style>
