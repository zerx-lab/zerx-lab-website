---
/**
 * ============================================================================
 * TableOfContents - 博客文章目录(TOC)
 * ----------------------------------------------------------------------------
 * Dossier 风格:mono 眉标 + 实线发丝;列表左侧一条细轨道,当前章节在轨道上
 * 亮起 Signal 渐变竖条(scaleY 生长)并高亮文字。桌面端顶部额外一条阅读
 * 进度线(CSS scroll-driven animation,不支持的浏览器直接隐藏)。
 *
 * 布局:
 *   桌面端 (≥ lg):文章网格右栏 sticky(sticky 与顶部让位由外层 wrapper 负责),
 *                  高度受限、独立滚动
 *   < lg:正文上方的可折叠卡片(默认折叠)
 *
 * 用法:
 *   <TableOfContents headings={headings} defaultOpen />
 *
 * 约束:
 *   - 默认 H2 / H3;maxDepth=4 可启用 H4;条目为 0 时整体不渲染
 *   - 激活态由脚本写 <a data-toc-link> 的 data-active="true",样式只读属性
 * ============================================================================
 */

import { getLangFromUrl } from "@i18n/utils";
import type { MarkdownHeading } from "astro";

interface Props {
	/** 标题列表(来自 astro:content render() 的返回值) */
	headings: readonly MarkdownHeading[];
	/** 最小层级(默认 2,即从 H2 开始) */
	minDepth?: number;
	/** 最大层级(默认 3,即到 H3 为止) */
	maxDepth?: number;
	/** 自定义 eyebrow 文字(默认从 i18n 推导为"在本页" / "On this page") */
	eyebrow?: string;
	/**
	 * 作为移动端/平板的默认展开状态(默认 false)
	 *
	 * 说明:移动端默认折叠更友好 —— 目录会把正文推到屏幕下方,
	 * 而手机上用户通常是顺序阅读,不需要一上来就看到完整目录。
	 * 桌面端(lg+)通过 CSS 强制展开,不受此 prop 影响。
	 */
	defaultOpen?: boolean;
	/** 额外类名 */
	class?: string;
	/** sticky 偏移(距离视口顶部的距离,默认跟随 top-nav 高度) */
	stickyTopOffset?: string;
}

const {
	headings,
	minDepth = 2,
	maxDepth = 3,
	eyebrow,
	defaultOpen = false,
	class: className = "",
	stickyTopOffset,
} = Astro.props;

// ----------------------------------------------------------------------------
// 过滤 + 层级归一化
// ----------------------------------------------------------------------------
// 只保留 [minDepth, maxDepth] 区间的标题;
// 把绝对层级映射到"相对缩进层级"(0, 1, 2),方便样式控制:
//   - level == minDepth   → indent 0
//   - level == minDepth+1 → indent 1
//   - level >= maxDepth   → indent 2 (最深)
// ----------------------------------------------------------------------------

interface TocItem {
	level: number;
	indent: 0 | 1 | 2;
	text: string;
	slug: string;
}

const items: readonly TocItem[] = headings
	.filter(
		(h: MarkdownHeading) =>
			h.depth >= minDepth && h.depth <= maxDepth && h.slug,
	)
	.map((h: MarkdownHeading): TocItem => {
		const offset = h.depth - minDepth;
		const indent = (offset >= 2 ? 2 : offset) as 0 | 1 | 2;
		return {
			level: h.depth,
			indent,
			text: h.text,
			slug: h.slug,
		};
	});

// ----------------------------------------------------------------------------
// i18n
// ----------------------------------------------------------------------------

const lang = getLangFromUrl(Astro.url);

const LABELS = {
	zh: {
		eyebrow: "在本页",
		toggleExpand: "展开目录",
		toggleCollapse: "收起目录",
		empty: "本文无子标题",
	},
	en: {
		eyebrow: "On this page",
		toggleExpand: "Expand table of contents",
		toggleCollapse: "Collapse table of contents",
		empty: "No subheadings in this article",
	},
} as const;

const L = LABELS[lang] ?? LABELS.zh;
const resolvedEyebrow = eyebrow ?? L.eyebrow;

// 条目为 0 时组件整体不渲染,也不占位(让外部布局收回空间)
const shouldRender = items.length > 0;

// sticky 顶部偏移:默认 = 顶部导航高度 + 一点呼吸
const resolvedStickyTop =
	stickyTopOffset ?? "calc(var(--layout-top-nav-height) + 1rem)";
---

{
	shouldRender && (
		<nav
			aria-label={resolvedEyebrow}
			class:list={[
				"toc",
				"w-full",
				// < lg:折叠卡片
				"max-lg:rounded-[var(--radius-lg)] max-lg:border max-lg:border-[color:var(--color-hairline)]",
				"max-lg:bg-[color:var(--color-surface)] max-lg:px-4 max-lg:py-1.5",
				// 桌面端:高度限制 + 独立滚动
				"lg:max-h-[calc(100vh-var(--layout-top-nav-height)-2rem)]",
				"lg:overflow-y-auto lg:overscroll-contain",
				"scroll-thin",
				className,
			]}
			style={`--toc-sticky-top: ${resolvedStickyTop};`}
			data-toc-root
		>
			<details
				class="toc-details"
				open={defaultOpen || undefined}
				data-toc-details
			>
				<summary
					class:list={[
						"toc-summary",
						"flex items-center justify-between gap-3",
						"py-2.5 lg:pt-0.5 lg:pb-3",
						"cursor-pointer select-none list-none",
						"lg:cursor-default",
					]}
				>
					<span class="eyebrow text-[10.5px] text-[color:var(--color-ink-secondary)]">
						{resolvedEyebrow}
					</span>

					<span class="flex items-center gap-2">
						<span class="mono-num text-[10.5px] leading-none">
							{String(items.length).padStart(2, "0")}
						</span>
						<svg
							aria-hidden="true"
							width="10"
							height="10"
							viewBox="0 0 24 24"
							fill="none"
							stroke="currentColor"
							stroke-width="2.5"
							stroke-linecap="round"
							stroke-linejoin="round"
							class:list={[
								"toc-chevron",
								"shrink-0",
								"text-[color:var(--color-ink-tertiary)]",
								"lg:hidden",
							]}
						>
							<path d="m6 9 6 6 6-6" />
						</svg>
					</span>
				</summary>

				{/* 分割线 + 阅读进度(桌面) */}
				<div class="toc-rule" aria-hidden="true">
					<span class="toc-progress"></span>
				</div>

				<ol
					class:list={[
						"toc-list",
						"relative flex flex-col",
						"list-none m-0 p-0",
						"mt-3 mb-2",
					]}
					data-toc-list
				>
					{items.map((item) => (
						<li
							class:list={[
								"toc-item",
								"relative",
								`toc-item--indent-${item.indent}`,
							]}
							data-toc-item
							data-slug={item.slug}
						>
							<a
								href={`#${item.slug}`}
								data-toc-link={item.slug}
								class:list={[
									"toc-link",
									"relative block",
									"py-[5px] pr-2",
									item.indent === 0 && "pl-3.5",
									item.indent === 1 && "pl-6",
									item.indent === 2 && "pl-8",
									item.indent === 0
										? "text-[13px] text-[color:var(--color-ink-secondary)]"
										: "text-[12.5px] text-[color:var(--color-ink-tertiary)]",
									"leading-[1.45] tracking-[-0.005em]",
									"truncate",
								]}
								title={item.text}
							>
								<span aria-hidden="true" class="toc-link__marker" />
								{item.text}
							</a>
						</li>
					))}
				</ol>
			</details>
		</nav>
	)
}

<style>
	/* ---------- summary:隐藏原生三角 ---------- */
	.toc-summary::-webkit-details-marker {
		display: none;
	}
	.toc-summary::marker {
		content: "";
	}

	.toc-chevron {
		transition: transform var(--duration-base) var(--ease-out-expo);
	}
	.toc-details[open] .toc-chevron {
		transform: rotate(180deg);
	}

	/* ---------- 桌面端强制展开 ----------
	 * 新版 Chromium 把 details 内容放进 ::details-content(closed 时
	 * content-visibility: hidden),需一并放开;两条规则分开写,避免
	 * 不认识该伪元素的浏览器丢弃整条规则。 */
	@media (min-width: 1024px) {
		.toc-details > :not(.toc-summary) {
			display: block !important;
		}
		.toc-details::details-content {
			content-visibility: visible;
			block-size: auto;
		}
	}

	/* ---------- 分割线 + 阅读进度 ---------- */
	.toc-rule {
		position: relative;
		height: 1px;
		background-color: var(--color-hairline);
		overflow: hidden;
	}
	.toc-progress {
		display: none;
		position: absolute;
		inset: 0;
		background: var(--gradient-signal);
		transform-origin: 0 50%;
		transform: scaleX(0);
	}
	@supports (animation-timeline: scroll()) {
		@media (min-width: 1024px) {
			.toc-progress {
				display: block;
				animation: toc-progress linear both;
				animation-timeline: scroll(root block);
			}
		}
	}
	@keyframes toc-progress {
		to {
			transform: scaleX(1);
		}
	}

	/* ---------- 左侧轨道 ---------- */
	.toc-list::before {
		content: "";
		position: absolute;
		top: 0;
		bottom: 0;
		left: 0;
		width: 1px;
		background-color: var(--color-hairline);
	}

	/* ---------- 条目 ---------- */
	.toc-link {
		transition:
			color var(--duration-fast) var(--ease-standard),
			opacity var(--duration-fast) var(--ease-standard);
	}
	.toc-link:hover {
		color: var(--color-ink-primary);
	}
	.toc-link:focus-visible {
		outline: 2px solid var(--color-signal);
		outline-offset: -2px;
		border-radius: var(--radius-sm);
	}

	/* 子层级的细刻度 */
	.toc-item--indent-1 > .toc-link::before,
	.toc-item--indent-2 > .toc-link::before {
		content: "";
		position: absolute;
		top: 50%;
		width: 6px;
		height: 1px;
		background: var(--color-hairline-strong);
	}
	.toc-item--indent-1 > .toc-link::before {
		left: 12px;
	}
	.toc-item--indent-2 > .toc-link::before {
		left: 20px;
	}

	/* ---------- 激活态:Signal 竖条落在轨道上 + 文字高亮 ---------- */
	.toc-link__marker {
		position: absolute;
		left: 0;
		top: 3px;
		bottom: 3px;
		width: 2px;
		border-radius: 2px;
		background: linear-gradient(
			180deg,
			var(--color-signal),
			var(--color-signal-2)
		);
		opacity: 0;
		transform: scaleY(0.2);
		transition:
			transform var(--duration-slow) var(--ease-out-expo),
			opacity var(--duration-base) var(--ease-standard);
	}
	.toc-link[data-active="true"] {
		color: var(--color-ink-primary);
	}
	.toc-link[data-active="true"] .toc-link__marker {
		opacity: 1;
		transform: scaleY(1);
	}
	.toc-link[data-active="true"]::before {
		background: var(--color-signal);
	}

	@media (prefers-reduced-motion: reduce) {
		.toc-chevron,
		.toc-link,
		.toc-link__marker {
			transition: none !important;
		}
		.toc-progress {
			display: none !important;
		}
	}

	/* ---------- 细滚动条(仅 toc 内部) ---------- */
	.toc.scroll-thin {
		scrollbar-width: thin;
		scrollbar-color: transparent transparent;
	}
	.toc.scroll-thin:hover {
		scrollbar-color: var(--color-hairline-strong) transparent;
	}
	.toc.scroll-thin::-webkit-scrollbar {
		width: 6px;
	}
	.toc.scroll-thin::-webkit-scrollbar-track {
		background: transparent;
	}
	.toc.scroll-thin::-webkit-scrollbar-thumb {
		background: transparent;
		border-radius: 3px;
	}
	.toc.scroll-thin:hover::-webkit-scrollbar-thumb {
		background: var(--color-hairline-strong);
	}
</style>

<script>
	/**
	 * =========================================================================
	 * 滚动联动 —— 当前阅读到的章节对应的 TOC 条目高亮
	 * -------------------------------------------------------------------------
	 * 策略:
	 *   1. 页面加载后,收集文章区内所有 <h*>(与 TOC 的 slug 一一对应)
	 *   2. 用 IntersectionObserver 监听这些标题进入"关注区间"(视口中上 1/3)
	 *   3. 维护一个"当前激活 slug"栈,取栈顶作为 active
	 *   4. 通过给对应 <a data-toc-link="slug"> 加 data-active 属性驱动样式
	 *
	 * 兼容性:
	 *   - Astro View Transitions:在 astro:after-swap 重新初始化,
	 *     避免切页后旧 observer 留在内存
	 *   - prefers-reduced-motion:不影响此逻辑(只是观察,无动效)
	 * ========================================================================= */

	interface TocController {
		destroy(): void;
	}

	function initToc(): TocController | null {
		const root = document.querySelector<HTMLElement>("[data-toc-root]");
		if (!root) return null;

		const links = Array.from(
			root.querySelectorAll<HTMLAnchorElement>("[data-toc-link]"),
		);
		if (links.length === 0) return null;

		// 收集所有 slug → 对应的 heading 元素
		const slugToHeading = new Map<string, HTMLElement>();
		for (const link of links) {
			const slug = link.getAttribute("data-toc-link");
			if (!slug) continue;
			// heading 的 id 由 renderMarkdown 注入,与 slug 完全一致
			const heading = document.getElementById(slug);
			if (heading) {
				slugToHeading.set(slug, heading);
			}
		}

		if (slugToHeading.size === 0) return null;

		// 记录每个 slug 是否"当前可见"
		const visibleSet = new Set<string>();

		/** 根据 visibleSet 计算当前激活的 slug(取文档顺序中第一个可见) */
		function getActiveSlug(): string | null {
			// 按照 slugToHeading 的插入顺序(= 文档顺序)找第一个 visible
			for (const slug of slugToHeading.keys()) {
				if (visibleSet.has(slug)) return slug;
			}
			return null;
		}

		/** 应用激活态 */
		function applyActive(slug: string | null): void {
			for (const link of links) {
				const isActive = link.getAttribute("data-toc-link") === slug;
				if (isActive) {
					link.setAttribute("data-active", "true");
				} else {
					link.removeAttribute("data-active");
				}
			}
		}

		// 当页面加载时,默认激活第一个标题
		const initialSlug = slugToHeading.keys().next().value ?? null;
		applyActive(initialSlug);

		// IntersectionObserver:视口中上 1/3 作为"关注区域"
		// rootMargin: "0px 0px -70% 0px" 意味着只有当标题进入视口顶部 30%
		// 范围内才算 visible
		const observer = new IntersectionObserver(
			(entries) => {
				for (const entry of entries) {
					const id = entry.target.id;
					if (!id) continue;
					if (entry.isIntersecting) {
						visibleSet.add(id);
					} else {
						visibleSet.delete(id);
					}
				}
				const active = getActiveSlug();
				if (active !== null) {
					applyActive(active);
				} else {
					// 所有标题都不在关注区域内时,取最近一次滚过的那个
					// 降级:用 scrollY 找到最后一个在视口上方的 heading
					const scrollTop = window.scrollY + 120;
					let lastPassed: string | null = null;
					for (const [slug, heading] of slugToHeading) {
						const top =
							heading.getBoundingClientRect().top + window.scrollY;
						if (top <= scrollTop) {
							lastPassed = slug;
						} else {
							break;
						}
					}
					applyActive(lastPassed ?? initialSlug);
				}
			},
			{
				rootMargin: "0px 0px -70% 0px",
				threshold: 0,
			},
		);

		for (const heading of slugToHeading.values()) {
			observer.observe(heading);
		}

		// 平滑滚动(点击 TOC 链接时)—— 交给浏览器原生 scroll-behavior: smooth 处理,
		// 这里额外拦截一下,避免 hash 变化导致 history 堆积
		function onClick(e: MouseEvent): void {
			const target = e.target as HTMLElement | null;
			if (!target) return;
			const link = target.closest<HTMLAnchorElement>("[data-toc-link]");
			if (!link) return;

			const slug = link.getAttribute("data-toc-link");
			if (!slug) return;
			const heading = slugToHeading.get(slug);
			if (!heading) return;

			e.preventDefault();
			heading.scrollIntoView({ behavior: "smooth", block: "start" });
			// 手动更新 hash,不触发 scroll
			history.replaceState(null, "", `#${slug}`);
			// 立刻把激活态切过去,免去等 observer 回调
			applyActive(slug);
		}

		root.addEventListener("click", onClick);

		return {
			destroy(): void {
				observer.disconnect();
				root.removeEventListener("click", onClick);
			},
		};
	}

	// 单例控制器,View Transitions 切页时重建
	let controller: TocController | null = null;

	function setup(): void {
		if (controller) {
			controller.destroy();
			controller = null;
		}
		controller = initToc();
	}

	// 首次加载
	setup();

	// Astro View Transitions 兼容:每次页面切换后重新初始化
	document.addEventListener("astro:after-swap", setup);
</script>
