---
/**
 * ============================================================================
 * BlogIndexPage - 博客列表页共享组件
 * ----------------------------------------------------------------------------
 * 为什么抽成独立组件:
 *   中英文、全部文章 / 按分类筛选、任意页码,一共 8 个静态路由文件
 *   (blog/index、blog/page/[page]、blog/cat/[cat]/index、
 *    blog/cat/[cat]/page/[page] × 2 语言)全部复用同一套渲染逻辑,
 *   路由文件只负责用 getStaticPaths 枚举参数,再把 lang/page/categorySlug
 *   转成 props 传进来。纯 props 驱动(不读 Astro.url.searchParams)。
 *
 * 版式:
 *
 *   PageHero   超大标题 + 描述 | aside: BlogMark(写作分布)
 *              SpecStrip: POSTS / CATEGORIES / LAST UPDATE / RSS
 *   ─────────────────────────────────────────────────────────────
 *   Dock       吸顶工具条(悬浮导航下方):分类分段控件 | 视图区间 | 搜索
 *   ─────────────────────────────────────────────────────────────
 *   01 精选    (仅第 1 页)封面式 Bento:1 张全宽 split / 2 张 7+5 / 3 张 7 + 5×2
 *              没有精选时用最新一篇
 *   02 履历    按月分组:左 3/12 吸顶超大月份,右 9/12 时间线行
 *   分页       三栏翻页带
 *
 * 搜索:
 *   - 客户端搜索由 BlogSearchBox 接管:输入词后 fetch 静态索引
 *     (/search/<lang>.json),在浏览器里过滤 + 高亮,接管本组件渲染的
 *     #post-grid / #search-results / #search-empty / #blog-pagination /
 *     #blog-category-tabs 这五个固定 id 容器的可见性
 *   - 搜索视图 .blog-search-view 自身不被脚本触碰:用 :has() 跟随
 *     #search-results / #search-empty 的 hidden 状态显示;结果数用 CSS 计数器
 *
 * 分页:每页 PAGE_SIZE = 10 篇;第 1 页 = 干净路径,第 N 页 = `.../page/N/`
 * ============================================================================
 */

import AppShell from "@layouts/AppShell.astro";
import PageHero from "@components/layout/PageHero.astro";
import type { SpecItem } from "@components/layout/SpecStrip.astro";
import PostCard from "@components/ui/PostCard.astro";
import Pagination from "@components/ui/Pagination.astro";
import BlogMark from "@components/ui/BlogMark.astro";
import BlogSearchBox from "@components/blog/BlogSearchBox.astro";
import BlogCategoryTabs from "@components/blog/BlogCategoryTabs.astro";
import { useTranslations, useTranslatedPath, formatDateCompact } from "@i18n/utils";
import type { Lang } from "@i18n/ui";
import { loadCounts } from "@lib/content";
import {
	listPostsPaged,
	listCategoryCounts,
	listCategories,
	type PostVM,
	type CategoryVM,
} from "@lib/queries/posts";

interface Props {
	/** 当前语言 */
	lang: Lang;
	/** 当前页码(1-indexed,由调用方的 getStaticPaths 保证合法) */
	page: number;
	/** 分类 slug 过滤;缺省或空串表示"全部分类" */
	categorySlug?: string;
}

const { lang, page, categorySlug = "" } = Astro.props;

const t = useTranslations(lang);
const tp = useTranslatedPath(lang);

const PAGE_SIZE = 10;
const activeCatSlug = categorySlug;
const hasCatFilter = activeCatSlug.length > 0;

/* ----------------------------------------------------------------------------
 * 拉取数据
 * ----------------------------------------------------------------------------
 * 额外单独拉一次"全站第 1 页第 1 条"(不带分类筛选)只为拿到全站真实的最新
 * 发布日期 —— LAST UPDATE 是"站点属性",必须与当前分页/分类视图解耦。
 * -------------------------------------------------------------------------- */

const [pageResult, categoryCounts, categoriesList, siteCounts, latestPageResult] =
	await Promise.all([
		listPostsPaged({
			lang,
			page,
			pageSize: PAGE_SIZE,
			categorySlug: activeCatSlug,
		}),
		listCategoryCounts(),
		listCategories(lang),
		loadCounts(),
		listPostsPaged({ lang, page: 1, pageSize: 1 }),
	]);

const posts: readonly PostVM[] = pageResult.items;

/* ----------------------------------------------------------------------------
 * 规格条数据(站点属性,不随分类筛选变化)
 * -------------------------------------------------------------------------- */

const postCount = hasCatFilter ? categoryCounts.total : pageResult.total;
const categoryCount = siteCounts.categories;
const latestPostDate = latestPageResult.items[0]?.date ?? null;
const lastUpdateText = latestPostDate
	? formatDateCompact(latestPostDate).replaceAll("-", ".")
	: "—";

const rssHref = tp("/rss.xml");

const spec: SpecItem[] = [
	{ label: t("meta.posts"), count: postCount },
	{ label: t("meta.categories"), count: categoryCount },
	{ label: t("meta.lastUpdate"), value: lastUpdateText, live: latestPostDate !== null },
	{ label: t("meta.rss"), value: "rss.xml", href: rssHref },
];

/* ----------------------------------------------------------------------------
 * 页面级文案
 * -------------------------------------------------------------------------- */

const MONTHS_EN = ["JAN", "FEB", "MAR", "APR", "MAY", "JUN", "JUL", "AUG", "SEP", "OCT", "NOV", "DEC"];
const MONTHS_EN_LONG = [
	"January", "February", "March", "April", "May", "June",
	"July", "August", "September", "October", "November", "December",
];

const PAGE_COPY = {
	zh: {
		eyebrow: "博客",
		title: "文章、发布与洞见",
		titleLead: "文章、发布与",
		titleAccent: "洞见",
		description:
			"记录构建过程、技术决策与开源探索。不追热点,只写能帮到明年自己的东西。",
		empty: "还没有文章,敬请期待。",
		featured: "精选",
		latest: "最新",
		spotlightNote: "值得先读的几篇。",
		latestNote: "最近发布的一篇。",
		archive: "写作履历",
		archiveSub: "ARCHIVE",
		archiveNote: "按发布时间倒序,按月归档。",
		monthLabel: (y: string, m: number) => `${y} 年 ${m} 月`,
		monthShort: (m: number) => `${m} 月`,
		postsUnit: "篇",
		viewAll: "全部",
		viewRange: "本页",
		searchScope: "搜索全部文章 · 忽略分类与分页",
		results: "搜索结果",
		resultsSub: "RESULTS",
		resultsNote: "覆盖全部分类与页码;清空输入或按 Esc 返回列表。",
		hits: "条命中",
		noResults: "NO RESULTS",
	},
	en: {
		eyebrow: "Blog",
		title: "Articles, releases, and insights",
		titleLead: "Articles, releases, and ",
		titleAccent: "insights",
		description:
			"Notes on what I build, the decisions behind them, and open-source explorations. No hot takes — only things that will help future me.",
		empty: "No posts yet. Stay tuned.",
		featured: "Featured",
		latest: "Latest",
		spotlightNote: "Worth reading first.",
		latestNote: "The most recent post.",
		archive: "Writing log",
		archiveSub: "ARCHIVE",
		archiveNote: "Newest first, filed by month.",
		monthLabel: (y: string, m: number) =>
			`${MONTHS_EN_LONG[m - 1] ?? ""} ${y}`,
		monthShort: (m: number) => MONTHS_EN[m - 1] ?? "",
		postsUnit: "posts",
		viewAll: "All",
		viewRange: "Showing",
		searchScope: "Searching all posts · ignores category & page",
		results: "Search results",
		resultsSub: "RESULTS",
		resultsNote: "Across every category and page. Clear the input or press Esc to go back.",
		hits: "hits",
		noResults: "NO RESULTS",
	},
} as const;

const copy = PAGE_COPY[lang] ?? PAGE_COPY.zh;

/* ----------------------------------------------------------------------------
 * 分组策略
 * ----------------------------------------------------------------------------
 *   - 第 1 页:本页的精选(最多 3 篇)进 Bento;本页没有精选时用最新一篇
 *   - 其余文章按日期降序进履历,按"年-月"分组
 *   - 第 2+ 页:不做 Bento(避免跨页重复强调)
 * -------------------------------------------------------------------------- */

const SPOTLIGHT_MAX = 3;
const isFirstPage = pageResult.page === 1;
const featuredOnPage = isFirstPage ? posts.filter((p) => p.featured).slice(0, SPOTLIGHT_MAX) : [];
const spotlightIsFeatured = featuredOnPage.length > 0;
const spotlightPosts: readonly PostVM[] = isFirstPage
	? spotlightIsFeatured
		? featuredOnPage
		: posts.slice(0, 1)
	: [];
const spotlightSlugs = new Set(spotlightPosts.map((p) => p.slug));
const archivePosts = posts.filter((p) => !spotlightSlugs.has(p.slug));

interface MonthGroup {
	readonly key: string;
	readonly year: string;
	readonly month: number;
	readonly posts: PostVM[];
}

const monthGroups: MonthGroup[] = [];
for (const post of archivePosts) {
	const ymd = formatDateCompact(post.date); // YYYY-MM-DD
	const key = ymd.slice(0, 7);
	const last = monthGroups[monthGroups.length - 1];
	if (last && last.key === key) {
		last.posts.push(post);
	} else {
		monthGroups.push({
			key,
			year: ymd.slice(0, 4),
			month: Number(ymd.slice(5, 7)),
			posts: [post],
		});
	}
}

const spotlightIndex = "01";
const archiveIndex = spotlightPosts.length > 0 ? "02" : "01";

/* ----------------------------------------------------------------------------
 * 路径构造
 * ----------------------------------------------------------------------------
 *   - listBase   列表页根路径("/blog" / "/en/blog")
 *   - catBase    当前视图(可能带分类)的分页基础路径,传给 Pagination
 * -------------------------------------------------------------------------- */

const listBase = tp("/blog");
const catBase = hasCatFilter ? `${listBase}/cat/${activeCatSlug}` : listBase;

/* 分类切换器计数:byCategory + "__all__" 特殊键 */
const categoryCountsForTabs: Record<string, number> = {
	__all__: categoryCounts.total,
	...categoryCounts.byCategory,
};

/* 当前视图区间:如 11–20 / 49 */
const rangeStart = posts.length > 0 ? (pageResult.page - 1) * pageResult.pageSize + 1 : 0;
const rangeEnd = posts.length > 0 ? rangeStart + posts.length - 1 : 0;
const pad2 = (n: number) => String(n).padStart(2, "0");

/* ----------------------------------------------------------------------------
 * BlogMark(hero aside):分类按计数降序,只展示前 N 项
 * -------------------------------------------------------------------------- */

const BLOG_MARK_MAX_ROWS = 6;

const blogMarkCategories = categoriesList
	.map((c: CategoryVM) => ({
		slug: c.slug,
		name: c.name,
		count: categoryCounts.byCategory[c.slug] ?? 0,
	}))
	.sort((a, b) => b.count - a.count)
	.slice(0, BLOG_MARK_MAX_ROWS);
---

<AppShell title={copy.title} description={copy.description}>
	<PageHero eyebrow={copy.eyebrow} description={copy.description} spec={spec}>
		<Fragment slot="title">
			{copy.titleLead}<span class="serif-accent">{copy.titleAccent}</span>
		</Fragment>
		<Fragment slot="aside">
			<BlogMark
				categories={blogMarkCategories}
				total={categoryCounts.total}
				activeSlug={activeCatSlug}
			/>
		</Fragment>
	</PageHero>

	<div class="blog-index relative pb-8">
		{/* ================= 吸顶工具条 ================= */}
		<div class="blog-dock-bar sticky top-[var(--layout-top-nav-height)] z-30">
			<div class="wrap">
				<div class="blog-dock flex items-center gap-2 p-1.5">
					<div id="blog-category-tabs" class="min-w-0 flex-1">
						<BlogCategoryTabs
							listBase={listBase}
							categories={categoriesList}
							activeSlug={activeCatSlug}
							counts={categoryCountsForTabs}
						/>
					</div>

					<p class="blog-dock__scope m-0 min-w-0 flex-1 truncate px-2 font-[var(--font-mono)] text-[10.5px] uppercase leading-none tracking-[var(--tracking-wide)] text-[color:var(--color-ink-tertiary)]">
						<span aria-hidden="true" class="mr-2 inline-block h-[5px] w-[5px] rounded-[1px] bg-[color:var(--color-signal)] align-middle" />
						{copy.searchScope}
					</p>

					{posts.length > 0 && (
						<span class="blog-dock__range hidden shrink-0 px-2 font-[var(--font-mono)] text-[10.5px] uppercase leading-none tracking-[var(--tracking-wide)] tabular-nums text-[color:var(--color-ink-tertiary)] lg:inline">
							{copy.viewRange}{" "}
							<span class="text-[color:var(--color-ink-primary)]">
								{pad2(rangeStart)}–{pad2(rangeEnd)}
							</span>
							<span class="text-[color:var(--color-ink-faint)]"> / </span>
							{pad2(pageResult.total)}
						</span>
					)}

					<span aria-hidden="true" class="hidden h-5 w-px shrink-0 bg-[color:var(--color-hairline)] lg:block" />

					<div class="flex shrink-0 items-center">
						<BlogSearchBox listBase={listBase} />
					</div>
				</div>
			</div>
		</div>

		{/* ================= 默认列表(搜索态整体隐藏) ================= */}
		<div id="post-grid">
			{
				posts.length === 0 ? (
					<div class="wrap mt-12 lg:mt-16">
						<div class="blog-empty flex flex-col items-center justify-center px-6 py-20 text-center lg:py-28">
							<span aria-hidden="true" class="mono-label mb-3 text-[11px] text-[color:var(--color-ink-muted)]">
								— EMPTY —
							</span>
							<p class="text-[15px] leading-[1.6] text-[color:var(--color-ink-secondary)]">
								{copy.empty}
							</p>
						</div>
					</div>
				) : (
					<>
						{/* ---------- 01 精选 / 最新:封面式 Bento ---------- */}
						{spotlightPosts.length > 0 && (
							<section
								aria-labelledby="blog-spotlight-title"
								class="wrap mt-12 lg:mt-16"
							>
								<div class="mb-6 flex flex-wrap items-end justify-between gap-x-8 gap-y-2 lg:mb-8">
									<div>
										<div class="flex items-center gap-3 font-[var(--font-mono)] text-[11px] leading-none tabular-nums">
											<span class="font-medium text-[color:var(--color-signal)]">{spotlightIndex}</span>
											<span aria-hidden="true" class="h-px w-6 bg-[color:var(--color-hairline-strong)]" />
											<span class="uppercase tracking-[var(--tracking-wider)] text-[color:var(--color-ink-muted)]">
												{spotlightIsFeatured ? "FEATURED" : "LATEST"}
											</span>
										</div>
										<h2 id="blog-spotlight-title" class="mt-3 text-[22px] font-semibold leading-tight tracking-[-0.03em] lg:text-[24px]">
											{spotlightIsFeatured ? copy.featured : copy.latest}
										</h2>
									</div>
									<p class="m-0 text-[13.5px] leading-[1.6] text-[color:var(--color-ink-tertiary)]">
										{spotlightIsFeatured ? copy.spotlightNote : copy.latestNote}
									</p>
								</div>

								<div class="grid gap-4 lg:grid-cols-12 lg:gap-5">
									{spotlightPosts.map((post, i) => {
										const n = spotlightPosts.length;
										const span =
											n === 1
												? "lg:col-span-12"
												: i === 0
													? n === 3
														? "lg:col-span-7 lg:row-span-2"
														: "lg:col-span-7"
													: "lg:col-span-5";
										return (
											<PostCard
												variant="feature"
												layout={n === 1 ? "split" : "stack"}
												href={tp(`/blog/${post.slug}/`)}
												title={post.title}
												excerpt={post.excerpt}
												cover={post.cover}
												coverLabel={post.coverLabel}
												authorName={post.authorName ?? undefined}
												categoryName={post.categoryName ?? undefined}
												date={post.date}
												tags={post.tags}
												readingTime={post.readingTime}
												badge={spotlightIsFeatured ? t("blog.featured") : copy.latest}
												badgeSignal={spotlightIsFeatured}
												class={`reveal ${span}`}
												style={`--i: ${i + 7}`}
											/>
										);
									})}
								</div>
							</section>
						)}

						{/* ---------- 02 写作履历:按月分组时间线 ---------- */}
						{monthGroups.length > 0 && (
							<section
								aria-labelledby="blog-archive-title"
								class:list={["wrap", spotlightPosts.length > 0 ? "mt-20 lg:mt-28" : "mt-12 lg:mt-16"]}
							>
								<div class="mb-6 flex flex-wrap items-end justify-between gap-x-8 gap-y-2 lg:mb-8">
									<div>
										<div class="flex items-center gap-3 font-[var(--font-mono)] text-[11px] leading-none tabular-nums">
											<span class="font-medium text-[color:var(--color-signal)]">{archiveIndex}</span>
											<span aria-hidden="true" class="h-px w-6 bg-[color:var(--color-hairline-strong)]" />
											<span class="uppercase tracking-[var(--tracking-wider)] text-[color:var(--color-ink-muted)]">
												{copy.archiveSub} · {pad2(archivePosts.length)}
											</span>
										</div>
										<h2 id="blog-archive-title" class="mt-3 text-[22px] font-semibold leading-tight tracking-[-0.03em] lg:text-[24px]">
											{copy.archive}
										</h2>
									</div>
									<p class="m-0 text-[13.5px] leading-[1.6] text-[color:var(--color-ink-tertiary)]">
										{copy.archiveNote}
									</p>
								</div>

								<div class="flex flex-col">
									{monthGroups.map((group) => {
										const headingId = `blog-month-${group.key}`;
										return (
											<section
												aria-labelledby={headingId}
												class="blog-month grid border-t border-[color:var(--color-hairline-strong)] lg:grid-cols-12 lg:gap-x-10"
											>
												<header class="blog-month__head flex items-end gap-4 pt-6 pb-2 lg:col-span-3 lg:block lg:self-start lg:pt-8 lg:pb-8">
													<h3 id={headingId} class="m-0">
														<span class="sr-only">{copy.monthLabel(group.year, group.month)}</span>
														<span aria-hidden="true" class="blog-month__num block tabular-nums">
															{pad2(group.month)}
														</span>
													</h3>
													<div aria-hidden="true" class="flex flex-col gap-1.5 pb-1 font-[var(--font-mono)] text-[10.5px] uppercase leading-none tracking-[var(--tracking-wider)] lg:mt-4 lg:pb-0">
														<span class="text-[color:var(--color-ink-secondary)]">
															{group.year} · {copy.monthShort(group.month)}
														</span>
														<span class="tabular-nums text-[color:var(--color-ink-muted)]">
															{pad2(group.posts.length)} {copy.postsUnit}
														</span>
													</div>
												</header>

												<ol class="m-0 list-none divide-y divide-[color:var(--color-hairline)] p-0 lg:col-span-9">
													{group.posts.map((post) => (
														<li>
															<PostCard
																href={tp(`/blog/${post.slug}/`)}
																title={post.title}
																excerpt={post.excerpt}
																categoryName={post.categoryName ?? undefined}
																date={post.date}
																tags={post.tags}
																readingTime={post.readingTime}
																class="reveal-scroll"
															/>
														</li>
													))}
												</ol>
											</section>
										);
									})}
								</div>
							</section>
						)}
					</>
				)
			}
		</div>

		{/* ================= 搜索视图(跟随 #search-results / #search-empty 显隐) ================= */}
		<section aria-labelledby="blog-results-title" class="blog-search-view wrap mt-12 lg:mt-16">
			<div class="grid border-t border-[color:var(--color-hairline-strong)] lg:grid-cols-12 lg:gap-x-10">
				{/* 结果容器(脚本写入 .search-result-card);DOM 在结果栏之前,以便计数器累加 */}
				<div
					id="search-results"
					class="divide-y divide-[color:var(--color-hairline)] lg:col-span-9 lg:col-start-4 lg:row-start-1"
					hidden
				/>

				<div
					id="search-empty"
					class="lg:col-span-9 lg:col-start-4 lg:row-start-1 lg:py-8"
					hidden
				>
					<div class="blog-empty flex flex-col items-center justify-center px-6 py-20 text-center">
						<span aria-hidden="true" class="mono-label mb-3 text-[11px] text-[color:var(--color-ink-muted)]">
							— {copy.noResults} —
						</span>
						<p class="text-[15px] leading-[1.6] text-[color:var(--color-ink-secondary)]">
							{t("search.empty")}
						</p>
					</div>
				</div>

				<header class="blog-search-view__head order-first pt-6 pb-2 lg:order-none lg:col-span-3 lg:col-start-1 lg:row-start-1 lg:self-start lg:pt-8">
					<div class="flex items-center gap-3 font-[var(--font-mono)] text-[11px] leading-none">
						<span class="font-medium text-[color:var(--color-signal)]">Q</span>
						<span aria-hidden="true" class="h-px w-6 bg-[color:var(--color-hairline-strong)]" />
						<span class="uppercase tracking-[var(--tracking-wider)] text-[color:var(--color-ink-muted)]">
							{copy.resultsSub}
						</span>
					</div>
					<h2 id="blog-results-title" class="mt-3 text-[22px] font-semibold leading-tight tracking-[-0.03em] lg:text-[24px]">
						{copy.results}
					</h2>
					<p aria-hidden="true" class="mt-4 flex items-baseline gap-2">
						<span class="blog-search-view__hits text-[48px] font-semibold leading-none tracking-[-0.045em] tabular-nums lg:text-[64px]" />
						<span class="font-[var(--font-mono)] text-[10.5px] uppercase tracking-[var(--tracking-wider)] text-[color:var(--color-ink-muted)]">
							{copy.hits}
						</span>
					</p>
					<p class="mt-4 max-w-[30ch] text-[13.5px] leading-[1.65] text-[color:var(--color-ink-tertiary)]">
						{copy.resultsNote}
					</p>
				</header>
			</div>
		</section>

		{/* ================= 分页(搜索态整体隐藏) ================= */}
		{
			pageResult.totalPages > 1 && (
				<div id="blog-pagination" class="wrap mt-16 lg:mt-24">
					<Pagination
						currentPage={pageResult.page}
						totalPages={pageResult.totalPages}
						totalItems={pageResult.total}
						basePath={catBase}
					/>
				</div>
			)
		}
