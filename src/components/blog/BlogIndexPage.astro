---
/**
 * ============================================================================
 * BlogIndexPage - 博客列表页共享组件
 * ----------------------------------------------------------------------------
 * 为什么抽成独立组件:
 *   中英文、全部文章 / 按分类筛选、任意页码,一共 8 个静态路由文件
 *   (blog/index、blog/page/[page]、blog/cat/[cat]/index、
 *    blog/cat/[cat]/page/[page] × 2 语言)全部复用同一套渲染逻辑,
 *   路由文件只负责用 getStaticPaths 枚举参数,再把 lang/page/categorySlug
 *   转成 props 传进来。
 *
 * 纯 props 驱动(不读 Astro.url.searchParams):
 *   - lang / page / categorySlug 全部由调用方(路由文件)在构建期算好传入
 *   - 分页与分类筛选因此变成"构建期已知的静态路径",不再是运行时查询参数
 *
 * 搜索:
 *   - 服务端不再做任何搜索相关的数据获取或高亮
 *   - 客户端搜索由 BlogSearchBox 接管:输入词后 fetch 静态索引
 *     (/search/<lang>.json),在浏览器里过滤 + 高亮,接管本组件渲染的
 *     #post-grid / #search-results / #search-empty / #blog-pagination /
 *     #blog-category-tabs 这五个固定 id 容器的可见性
 *
 * 左栏 meta 字段说明:
 *   - POSTS        全站已发布文章总数(始终显示全量,不随分类筛选变化)
 *   - CATEGORIES   分类总数(来自 loadCounts(),含尚无文章的分类)
 *   - LAST UPDATE  全站最新文章的发布日期(与当前分页/分类视图解耦)
 *   - RSS          /rss.xml 外链
 *
 * 分页:
 *   - 每页 PAGE_SIZE = 10 篇
 *   - 路径式分页:第 1 页 = 干净路径,第 N 页 = `.../page/N/`
 *     (具体拼接见 Pagination 组件,由调用方传入 basePath)
 *   - 单页时不渲染 Pagination(组件内部已处理)
 * ============================================================================
 */

import AppShell from "@layouts/AppShell.astro";

import MetaRow from "@components/ui/MetaRow.astro";
import PostCard from "@components/ui/PostCard.astro";
import Pagination from "@components/ui/Pagination.astro";
import BlogMark from "@components/ui/BlogMark.astro";
import BlogSearchBox from "@components/blog/BlogSearchBox.astro";
import BlogCategoryTabs from "@components/blog/BlogCategoryTabs.astro";
import { useTranslations, useTranslatedPath, formatDateCompact } from "@i18n/utils";
import type { Lang } from "@i18n/ui";
import { loadCounts } from "@lib/content";
import {
	listPostsPaged,
	listCategoryCounts,
	listCategories,
	type PostVM,
	type CategoryVM,
} from "@lib/queries/posts";

interface Props {
	/** 当前语言 */
	lang: Lang;
	/** 当前页码(1-indexed,由调用方的 getStaticPaths 保证合法) */
	page: number;
	/** 分类 slug 过滤;缺省或空串表示"全部分类" */
	categorySlug?: string;
}

const { lang, page, categorySlug = "" } = Astro.props;

const t = useTranslations(lang);
const tp = useTranslatedPath(lang);

const PAGE_SIZE = 10;
const activeCatSlug = categorySlug;
const hasCatFilter = activeCatSlug.length > 0;

/* ----------------------------------------------------------------------------
 * 拉取数据
 * ----------------------------------------------------------------------------
 * 额外单独拉一次"全站第 1 页第 1 条"(不带分类筛选)只为拿到全站真实的最新
 * 发布日期 —— LAST UPDATE 是"站点属性",必须与当前分页/分类视图解耦,
 * 不能直接用 posts[0](分类筛选或翻页后 posts[0] 不是全站最新文章)。
 * -------------------------------------------------------------------------- */

const [pageResult, categoryCounts, categoriesList, siteCounts, latestPageResult] =
	await Promise.all([
		listPostsPaged({
			lang,
			page,
			pageSize: PAGE_SIZE,
			categorySlug: activeCatSlug,
		}),
		listCategoryCounts(),
		listCategories(lang),
		loadCounts(),
		listPostsPaged({ lang, page: 1, pageSize: 1 }),
	]);

const posts: readonly PostVM[] = pageResult.items;

/* ----------------------------------------------------------------------------
 * 左栏 meta 数据计算
 * ----------------------------------------------------------------------------
 * POSTS:有分类筛选时仍展示全站总数(categoryCounts.total),保持"站点属性"
 * 语义;无筛选时就是 pageResult.total(两者其实同值,写法上更直白)。
 * -------------------------------------------------------------------------- */

const postCount = hasCatFilter ? categoryCounts.total : pageResult.total;
const categoryCount = siteCounts.categories;
const latestPostDate = latestPageResult.items[0]?.date ?? null;
const lastUpdateText = latestPostDate ? formatDateCompact(latestPostDate) : "—";

/* ----------------------------------------------------------------------------
 * 页面级文案(本页不通过 i18n 字典管理,因为是单页专属)
 * -------------------------------------------------------------------------- */

const PAGE_COPY = {
	zh: {
		eyebrow: "博客",
		title: "文章、发布与洞见",
		description:
			"记录构建过程、技术决策与开源探索。不追热点,只写能帮到明年自己的东西。",
		empty: "还没有文章,敬请期待。",
		sectionTitle: "BLOG",
	},
	en: {
		eyebrow: "Blog",
		title: "Articles, releases, and insights",
		description:
			"Notes on what I build, the decisions behind them, and open-source explorations. No hot takes — only things that will help future me.",
		empty: "No posts yet. Stay tuned.",
		sectionTitle: "BLOG",
	},
} as const;

const copy = PAGE_COPY[lang] ?? PAGE_COPY.zh;

/* ----------------------------------------------------------------------------
 * 分组策略
 * ----------------------------------------------------------------------------
 *   - 第 1 页(无论是否有分类筛选):featured 排前,其余按日期降序
 *   - 第 2+ 页:featured 不再强调,直接按日期排(避免跨页重复置顶)
 * -------------------------------------------------------------------------- */

const isFirstPage = pageResult.page === 1;
const featuredPosts = isFirstPage ? posts.filter((p) => p.featured) : [];
const regularPosts = isFirstPage ? posts.filter((p) => !p.featured) : posts;

/* ----------------------------------------------------------------------------
 * 路径构造
 * ----------------------------------------------------------------------------
 *   - listBase   列表页根路径("/blog" / "/en/blog"),分类 tabs 与搜索结果
 *                链接都基于它拼 `${listBase}/<slug>/`
 *   - catBase    当前视图(可能带分类)的分页基础路径,传给 Pagination
 * -------------------------------------------------------------------------- */

const listBase = tp("/blog");
const catBase = hasCatFilter ? `${listBase}/cat/${activeCatSlug}` : listBase;

/* 分类切换器需要知道每分类的计数。把 listCategoryCounts 返回的 byCategory
 * 与 ALL 计数合并成单个对象传给组件(组件用 "__all__" 特殊键取 ALL)。 */
const categoryCountsForTabs: Record<string, number> = {
	__all__: categoryCounts.total,
	...categoryCounts.byCategory,
};

/* ----------------------------------------------------------------------------
 * BlogMark 左栏装置数据
 * ----------------------------------------------------------------------------
 * 把真实分类列表和每分类计数折成 BlogMark 需要的形状:
 *   { slug, name, count }[],按 count 降序(条形图"重"的排在上面,视觉更稳)。
 * 只展示前 N 项,避免左栏被极长的分类列表撑开。
 * -------------------------------------------------------------------------- */

const BLOG_MARK_MAX_ROWS = 6;

const blogMarkCategories = categoriesList
	.map((c: CategoryVM) => ({
		slug: c.slug,
		name: c.name,
		count: categoryCounts.byCategory[c.slug] ?? 0,
	}))
	.sort((a, b) => b.count - a.count)
	.slice(0, BLOG_MARK_MAX_ROWS);
---

<AppShell
	title={copy.title}
	description={copy.description}
	maxContentWidth="none"
>
	{/* ---------- 左栏:视觉装置(分类分布条形图) ----------
	 * 博客列表页专属装置,替代首页的 LabMark。
	 * 传入 left-visual slot 后,AppShell 走"页面自定义装置"分支,
	 * 不再渲染默认 LabMark。
	 * ------------------------------------------------------------ */}
	<Fragment slot="left-visual">
		<BlogMark
			categories={blogMarkCategories}
			total={categoryCounts.total}
		/>
	</Fragment>

	{/* ---------- 左栏:社交(仅 RSS) ---------- */}
	<Fragment slot="left-social">
		<a
			href={tp("/rss.xml")}
			aria-label="RSS"
			class="transition-colors hover:text-[color:var(--color-ink-primary)]"
		>
			<svg
				width="15"
				height="15"
				viewBox="0 0 24 24"
				fill="none"
				stroke="currentColor"
				stroke-width="2"
				stroke-linecap="round"
				stroke-linejoin="round"
				aria-hidden="true"
			>
				<path d="M4 11a9 9 0 0 1 9 9"></path>
				<path d="M4 4a16 16 0 0 1 16 16"></path>
				<circle cx="5" cy="19" r="1"></circle>
			</svg>
		</a>
		<a
			href="https://github.com/zerx-lab"
			target="_blank"
			rel="noopener noreferrer"
			aria-label="GitHub"
			class="transition-colors hover:text-[color:var(--color-ink-primary)]"
		>
			<svg
				width="16"
				height="16"
				viewBox="0 0 24 24"
				fill="currentColor"
				aria-hidden="true"
			>
				<path
					d="M12 .3a12 12 0 0 0-3.8 23.4c.6.1.8-.3.8-.6v-2c-3.3.7-4-1.6-4-1.6-.6-1.4-1.4-1.8-1.4-1.8-1-.7.1-.7.1-.7 1.2 0 1.9 1.2 1.9 1.2 1 1.8 2.8 1.3 3.5 1 0-.8.4-1.3.7-1.6-2.7-.3-5.5-1.3-5.5-6 0-1.2.5-2.3 1.3-3.1-.1-.4-.6-1.6.1-3.2 0 0 1-.3 3.3 1.2a11.5 11.5 0 0 1 6 0C17.3 4.7 18.3 5 18.3 5c.7 1.6.2 2.8.1 3.2.8.8 1.3 1.9 1.3 3.1 0 4.6-2.8 5.6-5.5 5.9.5.4.8 1.1.8 2.2v3.3c0 .3.2.7.8.6A12 12 0 0 0 12 .3"
				></path>
			</svg>
		</a>
	</Fragment>

	{/* ---------- 左栏:Meta ---------- */}
	<Fragment slot="left-meta">
		<MetaRow label={t("meta.posts")} value={String(postCount)} />
		<MetaRow
			label={t("meta.categories")}
			value={String(categoryCount)}
		/>
		<MetaRow label={t("meta.lastUpdate")} value={lastUpdateText} />
		<MetaRow
			label={t("meta.rss")}
			value={tp("/rss.xml")}
			href={tp("/rss.xml")}
		/>
	</Fragment>

	{/* ================================================================
	 *                          右栏主内容
	 * ================================================================ */}

	{/* ---------- 顶行:eyebrow + 分类切换 + 搜索框,三段一行 ---------- */}
	{/*
	 * 为什么不再复用 SectionHeader 的内置顶行:
	 *   SectionHeader 的顶行只支持 [eyebrow] — [count|link] 两段布局,
	 *   插不进"分类切换"这种占据剩余宽度且需横向滚动的交互组件。
	 *   这里自己写一个 3 段 flex 顶行,视觉上保留同样的虚线分隔与节奏:
	 *
	 *     [ BLOG · 6 ]  [ 全部 · 工程 · 发布 · 笔记 … ]  [ 🔍 ]
	 *          ↑固定          ↑flex-1 + 横向滚动          ↑固定
	 *
	 *   - 左右两端 shrink-0,永不被压缩
	 *   - 中间 min-w-0 + flex-1 + overflow-x-auto,分类过多时横向滚动,
	 *     两端渐变蒙版暗示"此处可滚动",绝不会挤压搜索框与 count
	 *   - 小屏(<sm)依旧是同一行;若分类极多,滚动条隐藏,手指滑动即可
	 *
	 *   分类 tabs 套一层 id="blog-category-tabs" 的容器,搜索态下由
	 *   BlogSearchBox 的脚本整体隐藏(见组件内注释)。
	 */}
	<header class="pt-6 lg:pt-8">
		<div class="flex items-center gap-3 sm:gap-4 mb-3">
			{/* 左:eyebrow + count */}
			<div class="shrink-0 flex items-baseline gap-2">
				<span
					class:list={[
						"mono-label",
						"text-[11px] sm:text-xs",
						"leading-none",
						"tracking-[var(--tracking-wider)]",
						"text-[color:var(--color-ink-secondary)]",
						"font-medium",
					]}
				>
					{copy.sectionTitle}
				</span>
			</div>

			{/* 中:分类切换(占据剩余宽度,超出横向滚动) */}
			<div id="blog-category-tabs" class="flex-1 min-w-0">
				<BlogCategoryTabs
					listBase={listBase}
					categories={categoriesList}
					activeSlug={activeCatSlug}
					counts={categoryCountsForTabs}
				/>
			</div>

			{/* 右:搜索框 */}
			<div class="shrink-0 flex items-center">
				<BlogSearchBox listBase={listBase} />
			</div>
		</div>

		{/* 虚线分割(与 SectionHeader 一致的节奏) */}
		<hr
			aria-hidden="true"
			class:list={[
				"border-0 border-t border-dashed",
				"border-[color:var(--color-hairline)]",
				"m-0",
			]}
		/>
	</header>

	{/* ---------- 文章列表(id="post-grid" 供客户端搜索脚本整体接管隐藏) ---------- */}
	<div id="post-grid">
		{
			posts.length === 0 ? (
				<div
					class:list={[
						"mt-8 lg:mt-10 mb-16",
						"flex flex-col items-center justify-center",
						"py-16 lg:py-20",
						"border border-dashed border-[color:var(--color-hairline)]",
						"text-center",
					]}
				>
					<span
						aria-hidden="true"
						class:list={[
							"mono-label",
							"text-[11px]",
							"text-[color:var(--color-ink-muted)]",
							"mb-3",
						]}
					>
						— EMPTY —
					</span>
					<p
						class:list={[
							"text-[color:var(--color-ink-secondary)]",
							"text-[14px]",
							"leading-[1.6]",
						]}
					>
						{copy.empty}
					</p>
				</div>
			) : (
				<div
					class:list={[
						"mt-6 lg:mt-8 mb-8",
						// 整个列表包在一个虚线边框里,每篇文章用虚线分隔
						"border border-dashed border-[color:var(--color-hairline)]",
						"divide-y divide-dashed divide-[color:var(--color-hairline)]",
					]}
				>
					{/* Featured 优先(仅第 1 页) */}
					{featuredPosts.map((post) => (
						<PostCard
							href={tp(`/blog/${post.slug}/`)}
							title={post.title}
							excerpt={post.excerpt}
							cover={post.cover}
							coverLabel={post.coverLabel}
							authorName={post.authorName ?? undefined}
							categoryName={post.categoryName ?? undefined}
							date={post.date}
							tags={post.tags}
							readingTime={post.readingTime}
							featured
						/>
					))}

					{/* 其余按日期降序 */}
					{regularPosts.map((post) => (
						<PostCard
							href={tp(`/blog/${post.slug}/`)}
							title={post.title}
							excerpt={post.excerpt}
							cover={post.cover}
							coverLabel={post.coverLabel}
							authorName={post.authorName ?? undefined}
							categoryName={post.categoryName ?? undefined}
							date={post.date}
							tags={post.tags}
							readingTime={post.readingTime}
						/>
					))}
				</div>
			)
		}
	</div>

	{/* ---------- 客户端搜索结果容器(默认隐藏,由 BlogSearchBox 的脚本接管) ---------- */}
	<div
		id="search-results"
		class:list={[
			"mt-6 lg:mt-8 mb-8",
			"border border-dashed border-[color:var(--color-hairline)]",
			"divide-y divide-dashed divide-[color:var(--color-hairline)]",
		]}
		hidden
	/>

	{/* ---------- 客户端搜索"无结果"提示(默认隐藏) ---------- */}
	<div
		id="search-empty"
		class:list={[
			"mt-8 lg:mt-10 mb-16",
			"flex flex-col items-center justify-center",
			"py-16 lg:py-20",
			"border border-dashed border-[color:var(--color-hairline)]",
			"text-center",
		]}
		hidden
	>
		<span
			aria-hidden="true"
			class:list={[
				"mono-label",
				"text-[11px]",
				"text-[color:var(--color-ink-muted)]",
				"mb-3",
			]}
		>
			— NO RESULTS —
		</span>
		<p
			class:list={[
				"text-[color:var(--color-ink-secondary)]",
				"text-[14px]",
				"leading-[1.6]",
			]}
		>
			{t("search.empty")}
		</p>
	</div>

	{/* ---------- 分页(id="blog-pagination" 供客户端搜索脚本整体接管隐藏) ---------- */}
	{
		pageResult.totalPages > 1 && (
			<div id="blog-pagination" class="mb-16">
				<Pagination
					currentPage={pageResult.page}
					totalPages={pageResult.totalPages}
					totalItems={pageResult.total}
					basePath={catBase}
				/>
			</div>
		)
	}
</AppShell>
