---
/**
 * ============================================================================
 * AurPage - AUR 软件包列表页共享组件
 * ----------------------------------------------------------------------------
 * 为什么抽成独立组件:
 *   中文 /aur 与英文 /en/aur 两个入口页面 95% 的逻辑相同,
 *   只有语言推导与少量默认文案不同。本组件负责:
 *     1. 用 @lib/content 的 loadAurPackages() 在构建期读取 src/content/data/aur.json
 *     2. 把 Bilingual 字段按当前 lang 解包
 *     3. 顶部展示"一行安装命令"示例(yay / paru 双 tab)
 *     4. 列表展示每个包,带 badges、版本、上游/AUR 链接、复制安装命令
 *
 * 版式(PageHero + CvSection):
 *   - PageHero:超大标题 + AUR / GitHub CTA;aside 为快速安装终端卡
 *     (paru / yay 分段 tab + Signal 指示条 + 提示符 + 闪烁光标 + 复制按钮);
 *     spec 规格条 = 包数 / 维护中 / 发行版 / helper / 许可证
 *   - 01 全部软件包(layout=full):全宽条目 —— 左列编号 + 维护状态,
 *     中列 mono 大字包名 + 版本 + 描述 + badges,右列单包安装终端条 + 外链
 * ============================================================================
 */

import AppShell from "@layouts/AppShell.astro";
import PageHero from "@components/layout/PageHero.astro";
import CvSection from "@components/layout/CvSection.astro";
import type { SpecItem } from "@components/layout/SpecStrip.astro";
import {
	getLangFromUrl,
	useTranslations,
} from "@i18n/utils";
import type { Lang } from "@i18n/ui";
import {
	loadAurPackages,
	pickLang,
	type AurPackageData,
} from "@lib/content";
import { getAurInfoBatch } from "@lib/aur-rpc";

/* ----------------------------------------------------------------------------
 * 当前语言 / 翻译工具
 * -------------------------------------------------------------------------- */

const lang = getLangFromUrl(Astro.url) as Lang;
const t = useTranslations(lang);

/* ----------------------------------------------------------------------------
 * 数据适配器
 * -------------------------------------------------------------------------- */

interface AurVM {
	slug: string;
	name: string;
	version: string;
	description: string;
	badges: readonly string[];
	aurUrl: string;
	upstreamUrl: string | null;
	maintained: boolean;
}

/** 把 AurPackageData 转成 ViewModel(按当前 lang 解包 Bilingual) */
function toVM(pkg: AurPackageData, currentLang: Lang): AurVM {
	return {
		slug: pkg.slug,
		name: pkg.name,
		version: pkg.version,
		description: pickLang(pkg.description, currentLang),
		badges: pkg.badges,
		aurUrl: pkg.aurUrl,
		upstreamUrl: pkg.upstreamUrl,
		maintained: pkg.maintained,
	};
}

/**
 * 用 AUR RPC 的实时版本号覆盖 VM 数组里的 version 字段。
 *
 * 为什么单独做一次覆盖:
 *   - 内容仓库里的 version 是撰写文章时手填的快照,作为"最后兜底"保留,
 *     AUR RPC 拿不到时展示不会崩
 *
 * 失败策略(由 getAurInfoBatch 内部处理):
 *   - 网络超时 / RPC 整体挂:返回空 Map 或旧 stale 数据,不抛错
 *   - 单个包在 AUR 找不到:Map 里不出现该键,当前函数保留内容仓库原值
 *
 * 性能:
 *   - AUR RPC v5 一次请求支持多个 arg[],所以总是 1 次 HTTP
 *   - 命中 24h 缓存时零网络开销
 */
async function mergeAurVersions(
	packages: readonly AurVM[],
): Promise<readonly AurVM[]> {
	if (packages.length === 0) return packages;

	try {
		const names = packages.map((p) => p.name).filter((n) => n);
		const info = await getAurInfoBatch(names);
		if (info.size === 0) return packages;

		return packages.map((p) => {
			const hit = info.get(p.name);
			if (!hit) return p;
			return { ...p, version: hit.version };
		});
	} catch (err) {
		// getAurInfoBatch 本身已经静默失败,这里再兜一层保险
		console.warn(
			"[aur] AUR RPC 合并失败,使用内容仓库版本号。原因:",
			(err as Error)?.message ?? err,
		);
		return packages;
	}
}

async function loadPackages(): Promise<readonly AurVM[]> {
	const base = (await loadAurPackages()).map((p) => toVM(p, lang));
	return mergeAurVersions(base);
}

const packages = await loadPackages();

/* ----------------------------------------------------------------------------
 * 页头规格条数据
 * -------------------------------------------------------------------------- */

const maintainedCount = packages.filter((p) => p.maintained).length;

/* ----------------------------------------------------------------------------
 * 页面级文案
 * -------------------------------------------------------------------------- */

const COPY = {
	zh: {
		eyebrow: "AUR",
		title: "AUR 软件包",
		description:
			"为 Arch Linux 用户维护的 AUR 软件包。所有包都以预编译二进制方式分发,一行命令即装即用。",
		empty: "暂无包。",
		titleLead: "AUR",
		titleAccent: "软件包",
		sectionQuickInstall: "快速安装",
		sectionAllPackages: "全部软件包",
		sectionAllSub: "All packages",
		sectionAllNote: "每个包都跟随上游发布自动更新,版本号取自 AUR 实时数据。",
		ctaAur: "AUR 主页",
		quickInstallNote: "一次装齐全部维护中的包",
		aurPage: "AUR 页面",
		upstream: "官网",
		installCmd: "安装命令",
		copyCmd: "复制",
		copiedCmd: "已复制",
		maintained: "维护中",
		deprecated: "已弃用",
		version: "版本",
		helperNote:
			"提示:以下命令假设你已安装 AUR 助手(yay / paru)。未安装时请参考 Arch Wiki。",
		distroLabel: "发行版",
		helperLabel: "助手",
		packagesLabel: "软件包",
		maintainedLabel: "维护中",
		helperSelector: "安装器选择",
		badgesLabel: "标签",
	},
	en: {
		eyebrow: "AUR",
		title: "AUR Packages",
		description:
			"AUR packages maintained for Arch Linux users. All shipped as prebuilt binaries — one command to install.",
		empty: "No packages yet.",
		titleLead: "AUR",
		titleAccent: "packages",
		sectionQuickInstall: "Quick install",
		sectionAllPackages: "All packages",
		sectionAllSub: "Registry",
		sectionAllNote: "Every package tracks upstream releases; versions come live from the AUR.",
		ctaAur: "AUR profile",
		quickInstallNote: "Install every maintained package at once",
		aurPage: "AUR Page",
		upstream: "Website",
		installCmd: "Install command",
		copyCmd: "Copy",
		copiedCmd: "Copied",
		maintained: "Maintained",
		deprecated: "Deprecated",
		version: "Version",
		helperNote:
			"Note: commands below assume an AUR helper (yay / paru) is installed. See Arch Wiki otherwise.",
		distroLabel: "Distro",
		helperLabel: "Helper",
		packagesLabel: "Packages",
		maintainedLabel: "Maintained",
		helperSelector: "Helper selector",
		badgesLabel: "Tags",
	},
} as const;

const C = COPY[lang] ?? COPY.zh;

/* ----------------------------------------------------------------------------
 * 快速安装:生成"安装全部"命令示例
 * ----------------------------------------------------------------------------
 * 选中全部已维护的包名,拼成一条命令,两种 helper 各生成一条。
 * 在 tab 切换时分别展示,带"复制"按钮。
 * -------------------------------------------------------------------------- */

const maintainedNames = packages
	.filter((p) => p.maintained && p.name)
	.map((p) => p.name);

const yayInstall = maintainedNames.length
	? `yay -S ${maintainedNames.join(" ")}`
	: "yay -S zerx-lab-pencil-bin";

const paruInstall = maintainedNames.length
	? `paru -S ${maintainedNames.join(" ")}`
	: "paru -S zerx-lab-pencil-bin";

const spec: SpecItem[] = [
	{ label: C.packagesLabel, count: packages.length },
	{ label: C.maintainedLabel, count: maintainedCount, live: maintainedCount > 0 },
	{ label: C.distroLabel, value: "Arch Linux" },
	{ label: C.helperLabel, value: "yay / paru" },
	{ label: t("meta.license"), value: "MIT" },
];

const AUR_PROFILE = "https://aur.archlinux.org/packages?K=zerx-lab&SB=p";
---

<AppShell title={C.title} description={C.description}>
	<PageHero eyebrow={C.eyebrow} description={C.description} spec={spec}>
		<Fragment slot="title">
			{C.titleLead}{" "}<span class="serif-accent">{C.titleAccent}</span>
		</Fragment>

		<Fragment slot="actions">
			<a href={AUR_PROFILE} target="_blank" rel="noopener noreferrer" class="btn btn-primary ext-link">
				<svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
					<path d="M21 16V8a2 2 0 0 0-1-1.73l-7-4a2 2 0 0 0-2 0l-7 4A2 2 0 0 0 3 8v8a2 2 0 0 0 1 1.73l7 4a2 2 0 0 0 2 0l7-4A2 2 0 0 0 21 16z" />
					<polyline points="3.27 6.96 12 12.01 20.73 6.96" />
					<line x1="12" y1="22.08" x2="12" y2="12" />
				</svg>
				<span>{C.ctaAur}</span>
				<svg aria-hidden="true" width="9" height="9" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" class="ext-link__arrow"><path d="M7 17L17 7" /><path d="M8 7h9v9" /></svg>
			</a>
			<a href="https://github.com/zerx-lab" target="_blank" rel="noopener noreferrer" class="btn btn-ghost ext-link">
				<span>GitHub</span>
				<svg aria-hidden="true" width="9" height="9" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" class="ext-link__arrow"><path d="M7 17L17 7" /><path d="M8 7h9v9" /></svg>
			</a>
		</Fragment>

		{/* aside:快速安装终端卡(paru / yay) */}
		{packages.length > 0 && (
			<div slot="aside">
				<section aria-label={C.sectionQuickInstall}>
					<div class="surface-card overflow-hidden" data-install-tabs>
						{/* 标题栏:tab 切换 + 会话信息 */}
						<div class="flex items-stretch border-b border-[color:var(--color-hairline)]">
							<div role="tablist" aria-label={C.helperSelector} class="flex items-stretch">
								<button
									type="button"
									role="tab"
									data-install-tab="paru"
									aria-selected="true"
									aria-controls="install-panel-paru"
									id="install-tab-paru"
									class="install-tab relative inline-flex items-center gap-2 px-4 h-11 mono-label text-[11px] leading-none cursor-pointer"
								>
									<span aria-hidden="true" class="install-tab__dot"></span>
									PARU
								</button>
								<button
									type="button"
									role="tab"
									data-install-tab="yay"
									aria-selected="false"
									aria-controls="install-panel-yay"
									id="install-tab-yay"
									class="install-tab relative inline-flex items-center gap-2 px-4 h-11 mono-label text-[11px] leading-none cursor-pointer"
								>
									<span aria-hidden="true" class="install-tab__dot"></span>
									YAY
								</button>
							</div>
							<span class="ml-auto flex items-center gap-2 px-4 mono-label text-[10px] leading-none text-[color:var(--color-ink-muted)]">
								<span aria-hidden="true" class="dot-live"></span>
								bash
							</span>
						</div>

						{/* 命令面板 */}
						<div class="terminal__body">
							<div
								role="tabpanel"
								id="install-panel-yay"
								aria-labelledby="install-tab-yay"
								data-install-panel="yay"
								class="install-panel"
								hidden
							>
								<div class="flex items-start gap-3 px-4 pt-5 pb-3 lg:px-5">
									<span aria-hidden="true" class="term-prompt shrink-0 font-[var(--font-mono)] text-[13px] leading-[1.65] select-none">
										~ <span class="text-[color:var(--color-signal)]">❯</span>
									</span>
									<p class="flex-1 min-w-0 m-0 font-[var(--font-mono)] text-[13px] leading-[1.65]">
										<code class="bg-transparent border-0 p-0 text-[1em] text-[color:var(--color-ink-primary)] break-all whitespace-pre-wrap">{yayInstall}</code><span aria-hidden="true" class="term-caret"></span>
									</p>
								</div>
								<div class="flex items-center gap-3 px-4 pb-4 lg:px-5">
									<span class="font-[var(--font-mono)] text-[10.5px] leading-[1.4] text-[color:var(--color-ink-muted)]">
										# {C.quickInstallNote}
									</span>
									<button
										type="button"
										data-copy-btn
										data-copy-text={yayInstall}
										aria-label={C.copyCmd}
										class="copy-btn btn btn-ghost btn-sm ml-auto shrink-0 cursor-pointer"
									>
										<span class="copy-btn__icons" aria-hidden="true">
											<svg class="copy-btn__icon copy-btn__icon--copy" width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
												<rect x="9" y="9" width="13" height="13" rx="2" ry="2" />
												<path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1" />
											</svg>
											<svg class="copy-btn__icon copy-btn__icon--done" width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
												<path d="M20 6 9 17l-5-5" />
											</svg>
										</span>
										<span data-copy-label data-default-label={C.copyCmd} data-copied-label={C.copiedCmd} aria-live="polite">{C.copyCmd}</span>
									</button>
								</div>
							</div>
							<div
								role="tabpanel"
								id="install-panel-paru"
								aria-labelledby="install-tab-paru"
								data-install-panel="paru"
								class="install-panel"
							>
								<div class="flex items-start gap-3 px-4 pt-5 pb-3 lg:px-5">
									<span aria-hidden="true" class="term-prompt shrink-0 font-[var(--font-mono)] text-[13px] leading-[1.65] select-none">
										~ <span class="text-[color:var(--color-signal)]">❯</span>
									</span>
									<p class="flex-1 min-w-0 m-0 font-[var(--font-mono)] text-[13px] leading-[1.65]">
										<code class="bg-transparent border-0 p-0 text-[1em] text-[color:var(--color-ink-primary)] break-all whitespace-pre-wrap">{paruInstall}</code><span aria-hidden="true" class="term-caret"></span>
									</p>
								</div>
								<div class="flex items-center gap-3 px-4 pb-4 lg:px-5">
									<span class="font-[var(--font-mono)] text-[10.5px] leading-[1.4] text-[color:var(--color-ink-muted)]">
										# {C.quickInstallNote}
									</span>
									<button
										type="button"
										data-copy-btn
										data-copy-text={paruInstall}
										aria-label={C.copyCmd}
										class="copy-btn btn btn-ghost btn-sm ml-auto shrink-0 cursor-pointer"
									>
										<span class="copy-btn__icons" aria-hidden="true">
											<svg class="copy-btn__icon copy-btn__icon--copy" width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
												<rect x="9" y="9" width="13" height="13" rx="2" ry="2" />
												<path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1" />
											</svg>
											<svg class="copy-btn__icon copy-btn__icon--done" width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
												<path d="M20 6 9 17l-5-5" />
											</svg>
										</span>
										<span data-copy-label data-default-label={C.copyCmd} data-copied-label={C.copiedCmd} aria-live="polite">{C.copyCmd}</span>
									</button>
								</div>
							</div>
						</div>
					</div>

					{/* 提示条 */}
					<p class="mt-3 font-[var(--font-mono)] text-[11px] leading-[1.6] text-[color:var(--color-ink-tertiary)]">
						<span aria-hidden="true" class="text-[color:var(--color-signal)] mr-1.5">//</span>
						{C.helperNote}
					</p>
				</section>
			</div>
		)}
	</PageHero>

	{
		packages.length === 0 ? (
			<CvSection index="01" label={C.sectionAllPackages} sublabel={C.sectionAllSub} class="mb-24 lg:mb-32">
				{/* 空状态:虚线仅用于"占位"语义 */}
				<div class="flex flex-col items-center justify-center gap-3 py-16 lg:py-20 rounded-[var(--radius-lg)] border border-dashed border-[color:var(--color-hairline-strong)] text-center">
					<span aria-hidden="true" class="mono-label text-[11px] text-[color:var(--color-ink-muted)]">— EMPTY —</span>
					<p class="text-[color:var(--color-ink-secondary)] text-[14px] leading-[1.6]">{C.empty}</p>
				</div>
			</CvSection>
		) : (
			<CvSection
				index="01"
				label={C.sectionAllPackages}
				sublabel={`${C.sectionAllSub} · ${String(packages.length).padStart(2, "0")}`}
				note={C.sectionAllNote}
				linkText={C.ctaAur}
				linkHref={AUR_PROFILE}
				layout="full"
				id="packages"
				class="mb-24 lg:mb-32"
			>
				{/* 列头:宽屏出现,像规格表的栏目名 */}
				<div aria-hidden="true" class="hidden lg:grid pkg-grid px-5 pb-3 mono-label text-[10px] leading-none text-[color:var(--color-ink-muted)]">
					<span>No. / {lang === "zh" ? "状态" : "Status"}</span>
					<span>{lang === "zh" ? "软件包" : "Package"}</span>
					<span>{C.installCmd}</span>
				</div>

				<ul class="list-none m-0 p-0 border-t border-[color:var(--color-hairline-strong)]">
					{packages.map((pkg, idx) => {
						// 单包安装命令默认使用 paru(与页头默认 tab 一致);
						// yay 用户可在快速安装卡切换查看整体命令,单包不重复暴露两份。
						const singleInstall = `paru -S ${pkg.name}`;
						return (
							<li class="reveal-scroll border-b border-[color:var(--color-hairline)]">
								<article class="pkg group grid pkg-grid gap-y-5 px-3 sm:px-5 py-7 lg:py-9">
									{/* 左列:档案编号 + 维护状态 */}
									<div class="flex lg:flex-col items-center lg:items-start gap-3 lg:gap-4">
										<span aria-hidden="true" class="pkg__num mono-num text-[12px] leading-none">
											AUR-{String(idx + 1).padStart(3, "0")}
										</span>
										<span aria-hidden="true" class="lg:hidden h-px flex-1 bg-[color:var(--color-hairline)]"></span>
										<span
											class:list={[
												"inline-flex items-center gap-2 mono-label text-[10px] leading-none",
												pkg.maintained ? "text-[color:var(--color-ink-secondary)]" : "text-[color:var(--color-ink-muted)]",
											]}
										>
											{pkg.maintained ? (
												<span aria-hidden="true" class="dot-live"></span>
											) : (
												<span aria-hidden="true" class="inline-block h-[7px] w-[7px] rounded-full border border-[color:var(--color-ink-muted)]"></span>
											)}
											{pkg.maintained ? C.maintained : C.deprecated}
										</span>
									</div>

									{/* 中列:包名 + 版本 + 描述 + badges */}
									<div class="min-w-0">
										<div class="flex items-center gap-x-3 gap-y-2 flex-wrap">
											<h3 class="pkg__name font-[var(--font-mono)] text-[20px] sm:text-[24px] lg:text-[26px] leading-[1.1] font-semibold tracking-[-0.03em] text-[color:var(--color-ink-primary)] break-all">
												{pkg.name}
											</h3>
											<span class="chip chip-signal tabular-nums" title={C.version}>
												<span class="sr-only">{C.version} </span>v{pkg.version}
											</span>
										</div>
										{pkg.description && (
											<p class="mt-3 text-[color:var(--color-ink-secondary)] text-[14px] lg:text-[15px] leading-[1.65] max-w-[62ch]">
												{pkg.description}
											</p>
										)}
										{pkg.badges.length > 0 && (
											<ul class="mt-4 flex flex-wrap gap-1.5 list-none m-0 p-0" aria-label={C.badgesLabel}>
												{pkg.badges.map((badge) => (
													<li class="chip uppercase">{badge}</li>
												))}
											</ul>
										)}
									</div>

									{/* 右列:单包安装终端条 + 外链 */}
									<div class="min-w-0 flex flex-col gap-3 lg:pt-1">
										<div class="terminal-strip flex items-center gap-2 pl-3 pr-1.5 py-1.5 rounded-[var(--radius-md)] border border-[color:var(--color-hairline)]">
											<span class="sr-only">{C.installCmd}</span>
											<span aria-hidden="true" class="shrink-0 font-[var(--font-mono)] text-[12px] leading-none text-[color:var(--color-signal)] select-none">❯</span>
											<code class="flex-1 min-w-0 bg-transparent border-0 p-0 font-[var(--font-mono)] text-[12px] leading-none text-[color:var(--color-ink-primary)] whitespace-nowrap overflow-x-auto scroll-hidden py-1">
												{singleInstall}
											</code>
											<button
												type="button"
												data-copy-btn
												data-copy-text={singleInstall}
												aria-label={C.copyCmd}
												class="copy-btn btn btn-ghost btn-sm shrink-0 h-[26px] px-2.5 cursor-pointer"
											>
												<span class="copy-btn__icons" aria-hidden="true">
													<svg class="copy-btn__icon copy-btn__icon--copy" width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
														<rect x="9" y="9" width="13" height="13" rx="2" ry="2" />
														<path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1" />
													</svg>
													<svg class="copy-btn__icon copy-btn__icon--done" width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
														<path d="M20 6 9 17l-5-5" />
													</svg>
												</span>
												<span data-copy-label data-default-label={C.copyCmd} data-copied-label={C.copiedCmd} aria-live="polite">{C.copyCmd}</span>
											</button>
										</div>

										{(pkg.aurUrl || pkg.upstreamUrl) && (
											<div class="flex items-center gap-1.5 flex-wrap">
												{pkg.aurUrl && (
													<a
														href={pkg.aurUrl}
														target="_blank"
														rel="noopener noreferrer"
														aria-label={`${pkg.name} — ${C.aurPage}`}
														class="btn btn-ghost btn-sm ext-link"
													>
														<span>{C.aurPage}</span>
														<svg aria-hidden="true" width="9" height="9" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" class="ext-link__arrow"><path d="M7 17L17 7" /><path d="M8 7h9v9" /></svg>
													</a>
												)}
												{pkg.upstreamUrl && (
													<a
														href={pkg.upstreamUrl}
														target="_blank"
														rel="noopener noreferrer"
														aria-label={`${pkg.name} — ${C.upstream}`}
														class="btn btn-ghost btn-sm ext-link"
													>
														<span>{C.upstream}</span>
														<svg aria-hidden="true" width="9" height="9" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" class="ext-link__arrow"><path d="M7 17L17 7" /><path d="M8 7h9v9" /></svg>
													</a>
												)}
											</div>
										)}
									</div>
								</article>
							</li>
						);
					})}
				</ul>
			</CvSection>
		)
	}
</AppShell>

<style>
	/* ------------------------------------------------------------------------
	 * 终端卡片
