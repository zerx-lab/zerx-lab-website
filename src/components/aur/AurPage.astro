	.terminal-strip:hover,
	.terminal-strip:focus-within {
		border-color: var(--signal-line);
	}

	/* ------------------------------------------------------------------------
	 * 复制按钮:data-copied="true" 时图标弹性切换为对勾,文字转绿
	 * ~1.6s 后由脚本还原
	 * ---------------------------------------------------------------------- */
	.copy-btn {
		color: var(--color-ink-secondary);
	}
	.copy-btn__icons {
		position: relative;
		display: inline-grid;
		width: 11px;
		height: 11px;
	}
	.copy-btn__icon {
		grid-area: 1 / 1;
		transition:
			opacity var(--duration-fast) var(--ease-standard),
			transform var(--duration-slow) var(--ease-spring);
	}
	.copy-btn__icon--done {
		opacity: 0;
		transform: scale(0.4) rotate(-20deg);
	}
	.copy-btn[data-copied="true"] {
		color: var(--color-live);
		border-color: color-mix(in oklab, var(--color-live) 45%, transparent);
	}
