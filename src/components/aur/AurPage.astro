	.pkg {
		position: relative;
		isolation: isolate;
	}
	/* hover 底色:独立层淡入,只动 opacity */
	.pkg::before {
		content: "";
		position: absolute;
		inset: 0;
		z-index: -1;
		background: linear-gradient(90deg, var(--signal-soft), transparent 65%);
		opacity: 0;
		transition: opacity var(--duration-base) var(--ease-standard);
	}
	/* 左侧 Signal 刻度线:纵向生长 */
	.pkg::after {
		content: "";
		position: absolute;
		left: 0;
		top: 0;
		bottom: 0;
		width: 2px;
		background: var(--gradient-signal);
