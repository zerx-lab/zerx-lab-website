		background-color: color-mix(in oklab, var(--color-paper-muted) 55%, transparent);
	}
	.term-prompt {
		color: var(--color-ink-muted);
	}
	/* 闪烁光标 */
	.term-caret {
		display: inline-block;
		width: 0.55em;
		height: 1.1em;
		margin-left: 0.3em;
		vertical-align: -0.2em;
		background-color: var(--color-signal);
		opacity: 0.85;
		animation: var(--animate-blink);
	}

	/* ------------------------------------------------------------------------
	 * Tab:aria-selected 驱动;底部 Signal 指示条 scaleX 生长
	 * ---------------------------------------------------------------------- */
	.install-tab {
		color: var(--color-ink-tertiary);
		border-right: 1px solid var(--color-hairline);
		transition: color var(--duration-fast) var(--ease-standard);
	}
	.install-tab:hover {
		color: var(--color-ink-primary);
	}
	.install-tab[aria-selected="true"] {
		color: var(--color-ink-primary);
	}
	.install-tab::after {
		content: "";
		position: absolute;
		left: 0;
		right: 0;
		bottom: -1px;
		height: 2px;
		background: var(--gradient-signal);
		transform: scaleX(0);
		transform-origin: left center;
		transition: transform var(--duration-slow) var(--ease-out-expo);
	}
	.install-tab[aria-selected="true"]::after {
		transform: scaleX(1);
	}
	.install-tab:focus-visible {
		outline-offset: -2px;
	}
	.install-tab__dot {
		width: 6px;
		height: 6px;
		border-radius: 999px;
		background-color: var(--color-ink-faint);
		transition:
			background-color var(--duration-base) var(--ease-standard),
			transform var(--duration-slow) var(--ease-spring);
	}
	.install-tab[aria-selected="true"] .install-tab__dot {
		background-color: var(--color-signal);
		transform: scale(1.15);
	}

	/* Tab 面板默认不显示,JS 切换时移除 hidden 属性;显示时淡入 */
	.install-panel[hidden] {
		display: none;
	}
	.install-panel:not([hidden]) {
		animation: panel-in var(--duration-slow) var(--ease-out-expo) both;
	}
	@keyframes panel-in {
		from {
			opacity: 0;
			transform: translate3d(0, 4px, 0);
		}
	}

	/* ------------------------------------------------------------------------
	 * 单包终端条
	 * ---------------------------------------------------------------------- */
	.terminal-strip {
		background-color: color-mix(in oklab, var(--color-paper-muted) 65%, transparent);
		transition: border-color var(--duration-base) var(--ease-standard);
