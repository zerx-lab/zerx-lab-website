---
/**
 * ============================================================================
 * SiteHeader - 悬浮胶囊导航
 * ----------------------------------------------------------------------------
 *   ( ▣ ZERX|LAB      首页  项目  榜单  AUR  博客  关于      ZH·EN ☼ ⌂ )
 *
 * - fixed 悬浮在视口顶部居中;页面在顶部时胶囊透明,滚动 0→120px 期间
 *   由 scroll-driven animation 逐渐凝结为磨砂胶囊(边框 + 阴影),零 JS;
 *   不支持的浏览器始终显示磨砂态。
 * - 激活项底片带 view-transition-name,跨页时滑移到新位置。
 * - 视口顶端一条 1px Signal 渐变阅读进度线。
 * - < lg:胶囊只保留 Logo + 菜单钮,点开全屏抽屉(编号大字导航逐项进场)。
 * ============================================================================
 */

import {
	getLangFromUrl,
	useTranslatedPath,
	useTranslations,
	stripLangFromPath,
} from "@i18n/utils";
import Logo from "@components/ui/Logo.astro";
import LanguageToggle from "@components/ui/LanguageToggle.astro";
import ThemeToggle from "@components/ui/ThemeToggle.astro";

interface NavItem {
	labelKey: "nav.home" | "nav.projects" | "nav.benchmarks" | "nav.aur" | "nav.blog" | "nav.about";
	path: string;
	matchPrefix: string;
}

const NAV_ITEMS: readonly NavItem[] = [
	{ labelKey: "nav.home", path: "/", matchPrefix: "/" },
	{ labelKey: "nav.projects", path: "/projects", matchPrefix: "/projects" },
	{ labelKey: "nav.benchmarks", path: "/benchmarks", matchPrefix: "/benchmarks" },
	{ labelKey: "nav.aur", path: "/aur", matchPrefix: "/aur" },
	{ labelKey: "nav.blog", path: "/blog", matchPrefix: "/blog" },
	{ labelKey: "nav.about", path: "/about", matchPrefix: "/about" },
] as const;

const GITHUB_URL = "https://github.com/zerx-lab";
const GITHUB_PATH =
	"M12 .3a12 12 0 0 0-3.8 23.4c.6.1.8-.3.8-.6v-2c-3.3.7-4-1.6-4-1.6-.6-1.4-1.4-1.8-1.4-1.8-1-.7.1-.7.1-.7 1.2 0 1.9 1.2 1.9 1.2 1 1.8 2.8 1.3 3.5 1 0-.8.4-1.3.7-1.6-2.7-.3-5.5-1.3-5.5-6 0-1.2.5-2.3 1.3-3.1-.1-.4-.6-1.6.1-3.2 0 0 1-.3 3.3 1.2a11.5 11.5 0 0 1 6 0C17.3 4.7 18.3 5 18.3 5c.7 1.6.2 2.8.1 3.2.8.8 1.3 1.9 1.3 3.1 0 4.6-2.8 5.6-5.5 5.9.5.4.8 1.1.8 2.2v3.3c0 .3.2.7.8.6A12 12 0 0 0 12 .3";

const lang = getLangFromUrl(Astro.url);
const tp = useTranslatedPath(lang);
const t = useTranslations(lang);
const neutralPath = stripLangFromPath(Astro.url.pathname);

function isActive(item: NavItem): boolean {
	if (item.matchPrefix === "/") return neutralPath === "/";
	return neutralPath === item.matchPrefix || neutralPath.startsWith(`${item.matchPrefix}/`);
}
---

<span aria-hidden="true" class="site-progress"></span>

<header class="site-header">
	<nav aria-label={lang === "zh" ? "主导航" : "Main navigation"} class="site-header__capsule">
		<Logo size="sm" class="pl-1.5 shrink-0" />

		<ul class="hidden lg:flex items-center justify-center gap-0.5 list-none m-0 p-0">
			{
				NAV_ITEMS.map((item) => {
					const active = isActive(item);
					return (
						<li class="flex">
							<a
								href={tp(item.path)}
								aria-current={active ? "page" : undefined}
								data-active={active ? "true" : undefined}
								class="site-header__link"
							>
								{active && <span aria-hidden="true" class="site-header__indicator" />}
								<span class="relative">{t(item.labelKey)}</span>
							</a>
						</li>
					);
				})
			}
		</ul>

		<div class="flex items-center justify-end gap-1.5 shrink-0">
			<div class="hidden lg:flex items-center gap-1.5">
				<LanguageToggle />
				<ThemeToggle />
				<a href={GITHUB_URL} target="_blank" rel="noopener noreferrer" aria-label={t("nav.github")} title={t("nav.github")} class="site-header__icon">
					<svg aria-hidden="true" width="15" height="15" viewBox="0 0 24 24" fill="currentColor"><path d={GITHUB_PATH} /></svg>
				</a>
			</div>
			<button
				type="button"
				data-mobile-menu-open
				aria-label={t("nav.openMenu")}
				aria-controls="mobile-menu-drawer"
				aria-expanded="false"
				class="site-header__icon site-header__burger cursor-pointer"
			>
				<span aria-hidden="true"></span>
				<span aria-hidden="true"></span>
			</button>
		</div>
	</nav>
</header>

{/* ===================== 移动端抽屉 ===================== */}
<div
	id="mobile-menu-drawer"
	data-mobile-menu
	data-open="false"
	aria-hidden="true"
	role="dialog"
	aria-modal="true"
	aria-label={t("nav.menu")}
	class="mobile-menu lg:hidden"
>
	<div data-mobile-menu-backdrop class="mobile-menu__backdrop" aria-hidden="true"></div>

	<div class="mobile-menu__panel" role="document">
		<div class="flex items-center justify-between h-16 px-5 border-b border-[color:var(--color-hairline)]">
			<Logo size="sm" />
			<button type="button" data-mobile-menu-close aria-label={t("nav.closeMenu")} class="site-header__icon cursor-pointer">
				<svg aria-hidden="true" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
					<path d="M18 6 6 18" />
					<path d="m6 6 12 12" />
				</svg>
			</button>
		</div>

		<ul class="list-none m-0 px-5 pt-4 pb-2">
			{
				NAV_ITEMS.map((item, idx) => {
					const active = isActive(item);
					return (
						<li class="mobile-menu__item border-b border-[color:var(--color-hairline)]" style={`--i: ${idx}`}>
							<a
								href={tp(item.path)}
								aria-current={active ? "page" : undefined}
								data-mobile-menu-link
								class:list={[
									"flex items-baseline gap-4 py-4",
									"text-[30px] font-semibold tracking-[-0.035em] leading-none",
									active ? "text-[color:var(--color-ink-primary)]" : "text-[color:var(--color-ink-tertiary)] hover:text-[color:var(--color-ink-primary)]",
								]}
							>
								<span aria-hidden="true" class:list={["font-[var(--font-mono)] text-[11px] font-medium tracking-normal tabular-nums", active ? "text-[color:var(--color-signal)]" : "text-[color:var(--color-ink-muted)]"]}>
									{String(idx + 1).padStart(2, "0")}
								</span>
								<span>{t(item.labelKey)}</span>
								{active && <span aria-hidden="true" class="ml-auto self-center dot-live" />}
							</a>
						</li>
					);
				})
			}
		</ul>

		<div class="mt-4 px-5 flex flex-col gap-3">
			<div class="flex items-center justify-between gap-4 h-12 px-3 rounded-[var(--radius-md)] border border-[color:var(--color-hairline)] bg-[color:var(--color-surface)]">
				<span class="mono-label text-[10.5px]">{t("action.toggleLanguage")}</span>
				<LanguageToggle />
			</div>
			<div class="flex items-center justify-between gap-4 h-12 px-3 rounded-[var(--radius-md)] border border-[color:var(--color-hairline)] bg-[color:var(--color-surface)]">
				<span class="mono-label text-[10.5px]">{t("action.toggleTheme")}</span>
				<ThemeToggle />
			</div>
		</div>

		<div class="mt-auto p-5">
			<a href={GITHUB_URL} target="_blank" rel="noopener noreferrer" class="btn btn-primary w-full h-12">
				<svg aria-hidden="true" width="14" height="14" viewBox="0 0 24 24" fill="currentColor"><path d={GITHUB_PATH} /></svg>
				<span>{t("nav.github")}</span>
			</a>
		</div>
	</div>
</div>

<style>
	/* ---------- 阅读进度线 ---------- */
	.site-progress {
		display: none;
	}

	@supports (animation-timeline: scroll()) {
		.site-progress {
			display: block;
			position: fixed;
			top: 0;
			left: 0;
			right: 0;
			height: 2px;
			z-index: 60;
			background: var(--gradient-signal);
			transform-origin: left center;
			animation: scroll-progress linear both;
			animation-timeline: scroll(root block);
		}
	}

	/* ---------- 胶囊 ---------- */
	.site-header {
		position: fixed;
		top: 12px;
		left: 0;
		right: 0;
		z-index: 50;
		padding-inline: 12px;
		pointer-events: none;
	}

	.site-header__capsule {
		pointer-events: auto;
		margin-inline: auto;
		max-width: 1180px;
		height: 56px;
		display: grid;
		grid-template-columns: 1fr auto;
		align-items: center;
		gap: 12px;
		padding-inline: 10px;
		border-radius: 999px;
		border: 1px solid var(--color-hairline);
		background-color: color-mix(in oklab, var(--color-paper) 72%, transparent);
		backdrop-filter: saturate(1.5) blur(14px);
		-webkit-backdrop-filter: saturate(1.5) blur(14px);
		box-shadow: var(--shadow-pop);
	}

	@media (min-width: 1024px) {
		.site-header__capsule {
			grid-template-columns: 1fr auto 1fr;
		}
	}

	/* 页面在顶部时透明,滚动时凝结 */
	@supports (animation-timeline: scroll()) {
		.site-header__capsule {
			animation: capsule-condense linear both;
			animation-timeline: scroll(root block);
			animation-range: 0 120px;
		}
	}

	@keyframes capsule-condense {
		from {
			background-color: transparent;
			border-color: transparent;
			box-shadow: none;
			backdrop-filter: none;
			-webkit-backdrop-filter: none;
		}
	}

	/* ---------- 链接 ---------- */
	.site-header__link {
		position: relative;
		display: inline-flex;
		align-items: center;
		height: 36px;
		padding-inline: 0.85rem;
		font-family: var(--font-mono);
		font-size: 11.5px;
		font-weight: 500;
		letter-spacing: var(--tracking-wide);
		text-transform: uppercase;
		white-space: nowrap;
		color: var(--color-ink-tertiary);
		border-radius: 999px;
		transition:
			color var(--duration-fast) var(--ease-standard),
			background-color var(--duration-fast) var(--ease-standard);
	}

	.site-header__link:hover {
		color: var(--color-ink-primary);
		background-color: color-mix(in oklab, var(--color-ink-primary) 5%, transparent);
	}

	.site-header__link[data-active="true"] {
		color: var(--color-paper);
	}

	.site-header__link[data-active="true"]:hover {
		background-color: transparent;
		color: var(--color-paper);
	}

	/* 激活底片:墨色实心胶囊,跨页滑移 */
	.site-header__indicator {
		position: absolute;
		inset: 0;
		border-radius: inherit;
		background-color: var(--color-ink-primary);
		view-transition-name: vt-nav-indicator;
	}

	.site-header__indicator::after {
		content: "";
		position: absolute;
		top: 50%;
		left: 9px;
		width: 4px;
		height: 4px;
		margin-top: -2px;
		border-radius: 50%;
		background: var(--color-signal-2);
		box-shadow: 0 0 8px var(--color-signal-2);
	}

	.site-header__link[data-active="true"] > span:last-child {
		padding-left: 6px;
	}

	/* ---------- 图标钮 ---------- */
	.site-header__icon {
		display: inline-flex;
		align-items: center;
		justify-content: center;
		width: 36px;
		height: 36px;
		border-radius: 999px;
		color: var(--color-ink-tertiary);
		transition:
			color var(--duration-fast) var(--ease-standard),
			background-color var(--duration-fast) var(--ease-standard);
	}

	.site-header__icon:hover {
		color: var(--color-ink-primary);
		background-color: color-mix(in oklab, var(--color-ink-primary) 6%, transparent);
	}

	.site-header__burger {
		flex-direction: column;
		gap: 5px;
	}

	.site-header__burger > span {
		display: block;
		width: 18px;
		height: 1.5px;
		border-radius: 2px;
		background-color: var(--color-ink-primary);
		transition: transform var(--duration-base) var(--ease-out-expo);
	}

	.site-header__burger > span:last-child {
		width: 12px;
		margin-left: 6px;
	}

	.site-header__burger:hover > span:last-child {
		transform: translateX(-6px) scaleX(1.5);
	}

	/* ---------- 抽屉 ---------- */
	.mobile-menu {
		position: fixed;
		inset: 0;
		z-index: 100;
		pointer-events: none;
	}

	.mobile-menu[data-open="true"] {
		pointer-events: auto;
	}

	.mobile-menu__backdrop {
		position: absolute;
		inset: 0;
		background-color: rgba(8, 8, 10, 0.4);
		opacity: 0;
		transition: opacity var(--duration-base) var(--ease-standard);
	}

	.mobile-menu[data-open="true"] .mobile-menu__backdrop {
		opacity: 1;
	}

	.mobile-menu__panel {
		position: absolute;
		inset: 0;
		display: flex;
		flex-direction: column;
		background-color: var(--color-paper);
		transform: translate3d(0, -16px, 0);
		opacity: 0;
		transition:
			transform var(--duration-slow) var(--ease-out-expo),
			opacity var(--duration-base) var(--ease-standard);
		overflow-y: auto;
		overscroll-behavior: contain;
	}

	.mobile-menu[data-open="true"] .mobile-menu__panel {
		transform: none;
		opacity: 1;
	}

	.mobile-menu__item {
		opacity: 0;
		transform: translate3d(0, 10px, 0);
		transition:
			opacity var(--duration-slow) var(--ease-out-expo),
			transform var(--duration-slow) var(--ease-out-expo);
	}

	.mobile-menu[data-open="true"] .mobile-menu__item {
		opacity: 1;
		transform: none;
		transition-delay: calc(var(--i) * 40ms + 80ms);
	}

	:global(body.mobile-menu-open) {
		overflow: hidden;
		touch-action: none;
	}
</style>

<script>
	/**
	 * 移动端抽屉:菜单钮打开;关闭钮 / 背景 / 导航项 / ESC 关闭;
	 * 打开时锁定 body 滚动;视口 ≥ lg 时自动关闭。
	 */
	function initMobileMenu(): void {
		const drawer = document.querySelector<HTMLElement>("[data-mobile-menu]");
		if (!drawer) return;

		const openBtns = document.querySelectorAll<HTMLButtonElement>("[data-mobile-menu-open]");
		const closeBtns = drawer.querySelectorAll<HTMLButtonElement>("[data-mobile-menu-close]");
		const backdrop = drawer.querySelector<HTMLElement>("[data-mobile-menu-backdrop]");
		const links = drawer.querySelectorAll<HTMLAnchorElement>("[data-mobile-menu-link]");

		const isOpen = (): boolean => drawer.getAttribute("data-open") === "true";

		const open = (): void => {
			drawer.setAttribute("data-open", "true");
			drawer.setAttribute("aria-hidden", "false");
			document.body.classList.add("mobile-menu-open");
			openBtns.forEach((b) => b.setAttribute("aria-expanded", "true"));
			closeBtns[0]?.focus();
		};

		const close = (): void => {
			if (!isOpen()) return;
			drawer.setAttribute("data-open", "false");
			drawer.setAttribute("aria-hidden", "true");
			document.body.classList.remove("mobile-menu-open");
			openBtns.forEach((b) => b.setAttribute("aria-expanded", "false"));
			openBtns[0]?.focus();
		};

		openBtns.forEach((btn) => btn.addEventListener("click", open));
		closeBtns.forEach((btn) => btn.addEventListener("click", close));
		backdrop?.addEventListener("click", close);
		links.forEach((link) => link.addEventListener("click", close));

		document.addEventListener("keydown", (e) => {
			if (e.key === "Escape") close();
		});

		const mq = window.matchMedia("(min-width: 1024px)");
		mq.addEventListener("change", () => {
			if (mq.matches) close();
		});
	}

	initMobileMenu();
	document.addEventListener("astro:after-swap", initMobileMenu);
</script>
