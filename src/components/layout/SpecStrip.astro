---
/**
 * ============================================================================
 * SpecStrip - 横向规格条(页头下方的关键数据)
 * ----------------------------------------------------------------------------
 *   ┌────────────┬────────────┬────────────┬────────────┐
 *   │ REPOS      │ STARS      │ LANGUAGES  │ ● STATUS   │
 *   │ 27         │ 6.1k       │ Go · Rust  │ Active     │
 *   └────────────┴────────────┴────────────┴────────────┘
 *
 * - 自适应列数(每格最小 9.5rem),格间 1px 发丝线;
 *   分隔线用 "左边框 + 容器裁切" 实现,不依赖固定列数
 * - item.count 为整数时数字从 0 滚动到目标(CSS @property),附 sr-only 真值
 * - item.href 时整格可点;item.live 在 label 前加在线点
 * ============================================================================
 */

export interface SpecItem {
	/** 标签(自动大写) */
	label: string;
	/** 显示值;若提供 count 则被 count 动画替代 */
	value?: string | number;
	/** 整数:以滚动计数显示 */
	count?: number;
	/** 数值后缀,如 "k" / "+" */
	suffix?: string;
	/** 整格链接 */
	href?: string;
	/** label 前显示在线点 */
	live?: boolean;
}

interface Props {
	items: readonly SpecItem[];
	/** 额外类名 */
	class?: string;
}

const { items, class: className = "" } = Astro.props;
---

<dl class:list={["spec-strip", className]}>
	{
		items.map((item, i) => {
			const external = item.href ? /^https?:\/\//i.test(item.href) : false;
			const Tag = item.href ? "a" : "div";
			return (
				<Tag
					href={item.href}
					target={external ? "_blank" : undefined}
					rel={external ? "noopener noreferrer" : undefined}
					class:list={["spec-strip__cell group", item.href && "spec-strip__cell--link"]}
				>
					<dt class="flex items-center gap-2 font-[var(--font-mono)] text-[10.5px] font-medium uppercase tracking-[var(--tracking-wider)] text-[color:var(--color-ink-tertiary)]">
						{item.live && <span class="dot-live" aria-hidden="true" />}
						{item.label}
						{item.href && (
							<svg aria-hidden="true" width="9" height="9" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" class="ml-auto opacity-0 -translate-x-1 transition-all duration-[var(--duration-base)] ease-[var(--ease-out-expo)] group-hover:opacity-100 group-hover:translate-x-0 text-[color:var(--color-signal)]">
								{external ? (
									<>
										<path d="M7 17L17 7" />
										<path d="M8 7h9v9" />
									</>
								) : (
									<>
										<path d="M5 12h14" />
										<path d="m12 5 7 7-7 7" />
									</>
								)}
							</svg>
						)}
					</dt>
					<dd class="mt-3 text-[22px] lg:text-[26px] font-semibold leading-none tracking-[-0.035em] tabular-nums truncate">
						{typeof item.count === "number" ? (
							<>
								<span class="sr-only">{item.count}{item.suffix}</span>
								<span aria-hidden="true">
									<span class="count-up" style={`--to: ${item.count}; --i: ${i}`} />
									{item.suffix}
								</span>
							</>
						) : (
							item.value
						)}
					</dd>
				</Tag>
			);
		})
	}
</dl>

<style>
	.spec-strip {
		display: grid;
		grid-template-columns: repeat(auto-fit, minmax(9.5rem, 1fr));
		overflow: hidden;
		border-top: 1px solid var(--color-hairline-strong);
	}

	.spec-strip__cell {
		display: block;
		min-width: 0;
		margin-left: -1px;
		padding: 1.1rem 1.25rem 1.3rem;
		border-left: 1px solid var(--color-hairline);
		border-bottom: 1px solid var(--color-hairline);
		transition: background-color var(--duration-base) var(--ease-standard);
	}

	.spec-strip__cell--link:hover {
		background-color: color-mix(in oklab, var(--color-signal) 5%, transparent);
	}
</style>
