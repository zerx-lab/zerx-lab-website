---
/**
 * 404 —— "信号丢失"全屏页
 *
 * 静态产物 /404.html,由 web 服务器(nginx)对未匹配路径回落。
 * 使用 AppShell(悬浮导航由 SiteHeader 提供,关闭页脚,noindex)。
 *
 *   ┌───────────────────────────────────────────────────────────────┐
 *   │ ■ 信号丢失 · SIGNAL LOST ──────────────────────── ERR_404 ▂▄▆█  │
 *   │                                                               │
 *   │  4 0 4  (超大,跨 7/12)               ┌ diagnostics.log ┐       │
 *   │  页面未找到。…                          │ $ curl -I /path │       │
 *   │  Page not found, signal lost. …        │ 状态/方法/路径… │       │
 *   │  [返回首页] [阅读博客] [浏览项目]        └─────────────────┘       │
 *   │ ───────────────────────────────────────────────────────────── │
 *   │ // 脚注(中 / 英)                                  GitHub 反馈 ↗ │
 *   └───────────────────────────────────────────────────────────────┘
 *
 * 路径无语言前缀,文案中英并列;唯一内联脚本负责填入真实路径与时间。
 */

import AppShell from "@layouts/AppShell.astro";

// 页面文案:中英并列,不做语言推导
const COPY = {
	zh: {
		eyebrow: "信号丢失",
		title: "页面未找到",
		description: "你访问的路径不存在,或者已被移除。",
		pathLabel: "请求路径",
		methodLabel: "方法",
		timeLabel: "时间",
		statusLabel: "状态",
		causeLabel: "诊断",
		cause: "路由表中没有匹配项",
		suggestionTitle: "可用出口",
		actionHome: "返回首页",
		actionBlog: "阅读博客",
		actionProjects: "浏览项目",
		actionGithub: "在 GitHub 反馈",
		footnote: "如果你是通过外部链接到达这里的,这条路径可能已永久失效。欢迎告诉我们从哪里来,我们会尽量修复。",
	},
	en: {
		eyebrow: "Signal lost",
		title: "Page not found",
		description: "The path you visited does not exist or has been removed.",
		pathLabel: "Path",
		methodLabel: "Method",
		timeLabel: "Time",
		statusLabel: "Status",
		causeLabel: "Trace",
		cause: "no match in route table",
		suggestionTitle: "Available exits",
		actionHome: "Back to home",
		actionBlog: "Read the blog",
		actionProjects: "Browse projects",
		actionGithub: "Report on GitHub",
		footnote: "If you arrived from an external link, the path may be permanently broken. Tell us where you came from and we will try to fix it.",
	},
} as const;

// 品牌/仓库链接(与站点其他位置保持一致)
const GITHUB_URL = "https://github.com/zerx-lab";
const arrow = "M5 12h14M12 5l7 7-7 7";
const exits = [
	{ href: "/", label: `${COPY.zh.actionHome} / ${COPY.en.actionHome}`, primary: true },
	{ href: "/blog", label: `${COPY.zh.actionBlog} / ${COPY.en.actionBlog}`, primary: false },
	{ href: "/projects", label: `${COPY.zh.actionProjects} / ${COPY.en.actionProjects}`, primary: false },
];
---

<AppShell title={`404 · ${COPY.zh.title} / ${COPY.en.title}`} description={COPY.zh.description} noindex footer={false}>
	<section class="err relative isolate flex min-h-[100svh] flex-col overflow-hidden pt-28 pb-10 lg:pt-32" aria-labelledby="err-title">
		<div class="err__grid dot-grid" aria-hidden="true"></div>
		<div class="err__glow" aria-hidden="true"></div>

		<div class="wrap flex flex-1 flex-col">
			{/* 顶部标尺:眉标 ── ERR_404 + 信号格 */}
			<div class="reveal flex items-center gap-4" style="--i: 0">
				<span class="eyebrow">{COPY.zh.eyebrow} · {COPY.en.eyebrow}</span>
				<span aria-hidden="true" class="h-px flex-1 bg-[color:var(--color-hairline-strong)]"></span>
				<span class="mono-num text-[11px] text-[color:var(--color-ink-secondary)]">ERR_404</span>
				<span class="err__bars" aria-hidden="true">
					<span></span><span></span><span></span><span></span>
				</span>
			</div>

			<div class="grid flex-1 content-center gap-12 py-12 lg:grid-cols-12 lg:items-end lg:gap-10 lg:py-16">
				{/* 左 7/12:超大 404 + 双语标题 + 出口 */}
				<div class="min-w-0 lg:col-span-7">
					<h1 id="err-title" class="err__code display reveal select-none tabular-nums" style="--i: 1">
						<span class="sr-only">404 · {COPY.zh.title} / {COPY.en.title}</span>
						<span aria-hidden="true">4<span class="text-signal">0</span>4</span>
						<span class="err__scan" aria-hidden="true"></span>
					</h1>

					<div class="reveal mt-6 flex max-w-[46ch] flex-col gap-2" style="--i: 2">
						<p lang="zh-CN" class="text-[22px] font-semibold leading-snug tracking-[-0.02em] lg:text-[28px]">
							{COPY.zh.title}。<span class="font-normal text-[color:var(--color-ink-secondary)]">{COPY.zh.description}</span>
						</p>
						<p lang="en" class="text-[15px] leading-relaxed text-[color:var(--color-ink-tertiary)] lg:text-[16px]">
							{COPY.en.title}, <span class="serif-accent text-[18px] text-[color:var(--color-ink-secondary)]">signal lost</span>. {COPY.en.description}
						</p>
					</div>

					<nav class="reveal mt-10" aria-labelledby="err-suggest" style="--i: 3">
						<h2 id="err-suggest" class="mono-label text-[11px] text-[color:var(--color-ink-secondary)]">
							{COPY.zh.suggestionTitle} / {COPY.en.suggestionTitle}
						</h2>
						<div class="mt-4 flex flex-wrap gap-2.5">
							{exits.map((exit) => (
								<a href={exit.href} class:list={["btn group", exit.primary ? "btn-primary" : "btn-ghost"]}>
									{exit.label}
									<svg aria-hidden="true" width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="err__arrow"><path d={arrow} /></svg>
								</a>
							))}
						</div>
					</nav>
				</div>

				{/* 右 5/12:终端诊断单 */}
				<div class="min-w-0 lg:col-span-5">
					<div class="reveal surface-card crop-marks overflow-hidden" style="--i: 4">
						<div class="flex items-center gap-3 border-b border-[color:var(--color-hairline)] px-4 py-2.5">
							<span class="flex items-center gap-1.5" aria-hidden="true">
								<span class="h-2 w-2 rounded-full bg-[color:var(--color-hairline-strong)]"></span>
								<span class="h-2 w-2 rounded-full bg-[color:var(--color-hairline-strong)]"></span>
								<span class="h-2 w-2 rounded-full bg-[color:var(--color-hairline-strong)]"></span>
							</span>
							<span class="mono-label text-[10.5px] text-[color:var(--color-ink-tertiary)]">diagnostics.log</span>
							<span class="chip ml-auto" aria-hidden="true">R/O</span>
						</div>

						<div class="px-4 py-4 font-[var(--font-mono)] text-[12.5px] leading-[1.7] lg:px-5 lg:py-5">
							<p class="flex min-w-0 items-baseline gap-2">
								<span aria-hidden="true" class="select-none text-[color:var(--color-signal)]">$</span>
								<span class="text-[color:var(--color-ink-tertiary)]">curl -I</span>
								<span class="min-w-0 break-all text-[color:var(--color-ink-primary)]" aria-hidden="true" data-err-echo>/unknown</span>
							</p>
							<dl class="err__log mt-3 border-t border-[color:var(--color-hairline)] pt-3">
								<div>
									<dt>{COPY.zh.statusLabel} / {COPY.en.statusLabel}</dt>
									<dd><span class="err__badge">404</span> NOT_FOUND</dd>
								</div>
								<div>
									<dt>{COPY.zh.methodLabel} / {COPY.en.methodLabel}</dt>
									<dd>GET</dd>
								</div>
								<div>
									<dt>{COPY.zh.pathLabel} / {COPY.en.pathLabel}</dt>
									<dd><code data-err-path class="break-all border-0 bg-transparent p-0 text-[color:var(--color-ink-primary)]">/unknown</code></dd>
								</div>
								<div>
									<dt>{COPY.zh.timeLabel} / {COPY.en.timeLabel}</dt>
									<dd data-err-time class="tabular-nums text-[color:var(--color-ink-secondary)]">—</dd>
								</div>
								<div>
									<dt>{COPY.zh.causeLabel} / {COPY.en.causeLabel}</dt>
									<dd class="text-[color:var(--color-ink-secondary)]">{COPY.zh.cause} · {COPY.en.cause}</dd>
								</div>
							</dl>
							<p class="mt-3 flex items-center gap-2 text-[color:var(--color-ink-muted)]" aria-hidden="true">
								<span class="text-[color:var(--color-signal)]">$</span><span class="err__caret"></span>
							</p>
						</div>
					</div>
				</div>
			</div>

			{/* 底部:脚注 + 反馈 */}
			<footer class="reveal grid gap-4 border-t border-[color:var(--color-hairline)] pt-5 lg:grid-cols-12 lg:items-start" style="--i: 5">
				<div class="grid gap-1.5 lg:col-span-9">
					<p lang="zh-CN" class="text-[12.5px] leading-[1.7] text-[color:var(--color-ink-tertiary)]">
						<span aria-hidden="true" class="mr-1 select-none text-[color:var(--color-ink-muted)]">//</span>{COPY.zh.footnote}
					</p>
					<p lang="en" class="font-[var(--font-mono)] text-[11.5px] leading-[1.6] text-[color:var(--color-ink-muted)]">
						<span aria-hidden="true" class="mr-1 select-none">//</span>{COPY.en.footnote}
					</p>
				</div>
				<p class="font-[var(--font-mono)] text-[11.5px] lg:col-span-3 lg:text-right">
					<a href={GITHUB_URL} target="_blank" rel="noopener noreferrer" class="link-underline text-[color:var(--color-ink-secondary)] hover:text-[color:var(--color-ink-primary)]">
						{COPY.zh.actionGithub} / {COPY.en.actionGithub} ↗
					</a>
				</p>
			</footer>
		</div>
	</section>
</AppShell>

<style>
	/* 背景:点阵 + 径向遮罩,左上(404 所在)清晰、四周淡出 */
	.err__grid {
		position: absolute;
		inset: 0;
		z-index: -2;
		-webkit-mask-image: radial-gradient(ellipse 70% 60% at 35% 45%, #000 0%, transparent 75%);
		mask-image: radial-gradient(ellipse 70% 60% at 35% 45%, #000 0%, transparent 75%);
	}
	.err__glow {
		position: absolute;
		left: 30%;
		top: 20%;
		z-index: -1;
		width: 52rem;
		height: 34rem;
		translate: -50% 0;
		border-radius: 50%;
		background: radial-gradient(closest-side, var(--signal-soft), transparent);
		pointer-events: none;
	}

	/* 超大 404 + 一条慢速扫描线(只动 transform / opacity) */
	.err__code {
		position: relative;
		display: inline-block;
		font-size: clamp(8rem, 30vw, 22rem);
		line-height: 0.82;
		letter-spacing: -0.06em;
		overflow: hidden;
	}
	.err__scan {
		position: absolute;
		inset: 0 0 auto;
		height: 2px;
		background: var(--gradient-signal);
		opacity: 0;
		animation: err-scan 4.8s var(--ease-standard) 1.2s infinite;
	}
	@keyframes err-scan {
		0% { transform: translateY(0); opacity: 0; }
		8% { opacity: 0.7; }
		60% { opacity: 0.35; }
		72%, 100% { transform: translateY(clamp(6.5rem, 24vw, 18rem)); opacity: 0; }
	}

	/* 信号格:四格全暗,首格短暂闪一下 */
	.err__bars {
		display: inline-flex;
		align-items: flex-end;
		gap: 3px;
		height: 18px;
	}
	.err__bars > span {
		width: 4px;
		border-radius: 1px;
		background: var(--color-ink-faint);
	}
	.err__bars > span:nth-child(1) { height: 5px; background: var(--color-ink-muted); animation: err-flicker 2.4s steps(1) infinite; }
	.err__bars > span:nth-child(2) { height: 9px; }
	.err__bars > span:nth-child(3) { height: 13px; }
	.err__bars > span:nth-child(4) { height: 18px; }
	@keyframes err-flicker {
		0%, 70% { opacity: 1; }
		72% { opacity: 0.15; }
		78% { opacity: 1; }
		82%, 100% { opacity: 0.25; }
	}

	/* 诊断行 */
	.err__log { display: grid; gap: 0.375rem; }
	.err__log > div {
		display: grid;
		grid-template-columns: 8.5rem minmax(0, 1fr);
		align-items: baseline;
		gap: 0.75rem;
	}
	.err__log dt {
		font-size: 10.5px;
		letter-spacing: 0.06em;
		text-transform: uppercase;
		color: var(--color-ink-tertiary);
	}
	.err__log dd { margin: 0; color: var(--color-ink-primary); min-width: 0; }
	.err__badge {
		display: inline-block;
		margin-right: 0.375rem;
		padding: 0 0.375rem;
		font-weight: 600;
		color: var(--color-signal);
		background: var(--signal-soft);
		border: 1px solid var(--signal-line);
		border-radius: var(--radius-sm);
	}
	.err__caret {
		display: inline-block;
		width: 0.55em;
		height: 1.1em;
		background: var(--color-ink-secondary);
		animation: var(--animate-blink);
	}
	@media (max-width: 480px) {
		.err__log > div { grid-template-columns: minmax(0, 1fr); gap: 0; }
	}

	.err__arrow { transition: transform var(--duration-fast) var(--ease-out-expo); }
	.group:hover .err__arrow { transform: translateX(2px); }

	@media (prefers-reduced-motion: reduce) {
		.err__scan,
		.err__bars > span { animation: none; }
	}
</style>

{/* ---------- 客户端脚本:填充真实请求路径与时间 ---------- */}
<script is:inline>
	(function () {
		try {
			var pathEl = document.querySelector("[data-err-path]");
			if (pathEl) {
				var path =
					window.location.pathname +
					(window.location.search || "") +
					(window.location.hash || "");
				// 限制显示长度,防止超长 URL 破坏布局
				if (path.length > 140) {
					path = path.slice(0, 137) + "...";
				}
				pathEl.textContent = path || "/";
				var echoEl = document.querySelector("[data-err-echo]");
				if (echoEl) echoEl.textContent = path || "/";
			}

			var timeEl = document.querySelector("[data-err-time]");
			if (timeEl) {
				// ISO 8601 日期时间,到秒;与伪终端美学一致
				var now = new Date();
				var pad = function (n) {
					return (n < 10 ? "0" : "") + n;
				};
				var formatted =
					now.getFullYear() +
					"-" +
					pad(now.getMonth() + 1) +
					"-" +
					pad(now.getDate()) +
					" " +
					pad(now.getHours()) +
					":" +
					pad(now.getMinutes()) +
					":" +
					pad(now.getSeconds());
				timeEl.textContent = formatted;
			}
		} catch (_) {
			/* 静默降级:出错时保留占位 "/unknown" 与 "—" */
		}
	})();
</script>
