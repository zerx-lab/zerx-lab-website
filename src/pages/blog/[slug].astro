---
/**
 * ============================================================================
 * 博客详情页 (中文,默认无前缀)
 * ----------------------------------------------------------------------------
 * 路由:
 *   /blog/:slug        → 本文件(zh)
 *   /en/blog/:slug     → src/pages/en/blog/[slug].astro(英文)
 *
 * 实现(静态构建,全站 output: "static"):
 *   - getStaticPaths 用 listPublishedPostSlugs() 在构建期枚举全部已发布
 *     文章 slug,产出与文章数一一对应的静态页面。
 *   - 页面只查一次文章(loadPostBySlug),查询结果作为 prop 直接传给
 *     BlogPostPage —— 避免"页面查一次、组件再查一次"的重复查询。
 *
 * 为什么不做 404 兜底跳转:
 *   getStaticPaths 枚举出的 slug 与 loadPostBySlug 用的是同一份
 *   Content Collection 索引,静态构建下二者不可能不一致。若真的查到
 *   null,说明索引/枚举出现了 bug,应当让构建直接失败并暴露问题,
 *   而不是像 SSR 时代那样静默重定向到 404。
 *
 * 维护约定:
 *   页面结构 / 正文渲染都在 BlogPostPage.astro,
 *   本文件只负责:枚举路由 → 查询文章 → 转交渲染。
 * ============================================================================
 */

import BlogPostPage from "@components/blog/BlogPostPage.astro";
import { listPublishedPostSlugs, loadPostBySlug } from "@lib/queries/posts";

export async function getStaticPaths() {
	const slugs = await listPublishedPostSlugs();
	return slugs.map((slug) => ({ params: { slug } }));
}

const { slug } = Astro.params;
const post = await loadPostBySlug(slug, "zh");

if (!post) {
	throw new Error(
		`[blog/${slug}] getStaticPaths 已枚举该 slug,但 loadPostBySlug 查不到对应文章 —— 索引与枚举不一致,构建失败。`,
	);
}
---

<BlogPostPage post={post} />
