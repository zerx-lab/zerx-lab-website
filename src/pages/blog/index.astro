---
/**
 * ============================================================================
 * 博客列表页 (中文,默认无前缀) —— 第 1 页 / 全部分类
 * ----------------------------------------------------------------------------
 * 路由:
 *   /blog/           → 本文件(zh,第 1 页)
 *   /blog/page/N/    → src/pages/blog/page/[page].astro(zh,第 N ≥ 2 页)
 *   /blog/cat/<c>/   → src/pages/blog/cat/[cat]/index.astro(zh,分类第 1 页)
 *   /en/blog/        → src/pages/en/blog/index.astro(英文)
 *
 * 实现:
 *   全部逻辑抽到 BlogIndexPage 共享组件,本文件仅做入口,直接传入
 *   固定的 lang="zh" page={1}(无分类筛选)。
 *
 * 与首页的关系:
 *   布局骨架完全复用 AppShell + LeftPane,但左栏视觉装置与首页不同:
 *     - 首页: LabMark(ASCII 几何矩阵 + 宣言)——实验室主视觉宣言
 *     - 博客: BlogMark(分类分布条形图)——档案的分类索引
 *   meta 区展示博客专属计数(POSTS / CATEGORIES / LAST UPDATE / RSS)。
 * ============================================================================
 */

import BlogIndexPage from "@components/blog/BlogIndexPage.astro";
---

<BlogIndexPage lang="zh" page={1} />
