---
/**
 * ============================================================================
 * AppShell - 全站外壳
 * ----------------------------------------------------------------------------
 *   ┌────────────────────────────────────────────────────────────┐
 *   │        ( Logo   首页 项目 榜单 AUR 博客 关于   ZH ☼ GH )     │ ← SiteHeader:悬浮胶囊,fixed
 *   │                                                            │
 *   │   <slot />   页面自行组合:                                   │
 *   │     PageHero   全宽大标题 + SpecStrip 横向规格条              │
 *   │     CvSection  简历分节:左侧吸顶章节栏 / 右侧内容             │
 *   │                                                            │
 *   │   SiteFooter   联系 CTA + 站点地图 + 超大描边字标              │
 *   └────────────────────────────────────────────────────────────┘
 *
 * 没有全局侧栏:版心由 `.wrap`(global.css)统一控制,页面按需全宽。
 * 背景环境光层固定在视口顶部,只做 transform 动画。
 * ============================================================================
 */

import BaseHead from "@components/layout/BaseHead.astro";
import SiteHeader from "@components/layout/SiteHeader.astro";
import SiteFooter from "@components/layout/SiteFooter.astro";
import { getLangFromUrl } from "@i18n/utils";
import { languageTags } from "@i18n/ui";
import "@styles/global.css";

interface Props {
	/** 页面 title(不含品牌后缀,BaseHead 会拼接) */
	title?: string;
	/** 页面 meta description */
	description?: string;
	/** OG 分享图 URL;未配置传 null 或不传 */
	ogImage?: string | null;
	/** OG 类型 */
	ogType?: "website" | "article";
	/** 文章专用:发布时间 */
	articlePublishedTime?: string;
	/** 文章专用:修改时间 */
	articleModifiedTime?: string;
	/** 文章专用:作者 */
	articleAuthor?: string;
	/** 是否 noindex */
	noindex?: boolean;
	/** 是否渲染页脚(404 等极简页可关闭) */
	footer?: boolean;
	/** 额外传给 <body> 的类名 */
	bodyClass?: string;
}

const {
	title,
	description,
	ogImage,
	ogType,
	articlePublishedTime,
	articleModifiedTime,
	articleAuthor,
	noindex,
	footer = true,
	bodyClass = "",
} = Astro.props;

const lang = getLangFromUrl(Astro.url);
const htmlLang = languageTags[lang];
---

<!doctype html>
<html lang={htmlLang}>
	<head>
		<BaseHead
			title={title}
			description={description}
			ogImage={ogImage}
			ogType={ogType}
			articlePublishedTime={articlePublishedTime}
			articleModifiedTime={articleModifiedTime}
			articleAuthor={articleAuthor}
			noindex={noindex}
		/>
		<slot name="head" />
	</head>

	<body
		class:list={[
			"app-body min-h-screen antialiased",
			"bg-[color:var(--color-paper)] text-[color:var(--color-ink-primary)]",
			bodyClass,
		]}
	>
		<a href="#main-content" class="skip-link">
			{lang === "zh" ? "跳转到主内容" : "Skip to main content"}
		</a>

		<div class="ambient" aria-hidden="true">
			<div class="ambient__glow ambient__glow--a"></div>
			<div class="ambient__glow ambient__glow--b"></div>
		</div>

		<SiteHeader />

		<main id="main-content" tabindex="-1" class="relative z-[1] outline-none">
			<slot />
		</main>

		{footer && <SiteFooter />}

		<script>
			/**
			 * 鼠标聚光:给 [data-spotlight] 写入指针相对坐标 --mx / --my,
			 * 由 .spotlight::after 消费。单个委托监听,仅精确指针设备,每帧最多一次。
			 */
			if (window.matchMedia("(pointer: fine)").matches) {
				let frame = 0;
				let lastEvent: PointerEvent | null = null;

				const flush = (): void => {
					frame = 0;
					const e = lastEvent;
					if (!e) return;
					const target = e.target instanceof Element ? e.target.closest<HTMLElement>("[data-spotlight]") : null;
					if (!target) return;
					const rect = target.getBoundingClientRect();
					target.style.setProperty("--mx", `${e.clientX - rect.left}px`);
					target.style.setProperty("--my", `${e.clientY - rect.top}px`);
				};

				document.addEventListener(
					"pointermove",
					(e) => {
						lastEvent = e;
						if (!frame) frame = requestAnimationFrame(flush);
					},
					{ passive: true },
				);
			}
		</script>
	</body>
</html>

<style>
	.ambient {
		position: fixed;
		inset: 0;
		z-index: 0;
		pointer-events: none;
		overflow: hidden;
		contain: strict;
	}

	.ambient__glow {
		position: absolute;
		border-radius: 50%;
		will-change: transform;
		animation: ambient-drift 38s ease-in-out infinite;
	}

	.ambient__glow--a {
		width: 70vmax;
		height: 70vmax;
		top: -46vmax;
		left: 50%;
		margin-left: -35vmax;
		background: radial-gradient(
			closest-side,
			color-mix(in oklab, var(--color-signal) 12%, transparent),
			transparent
		);
	}

	.ambient__glow--b {
		width: 46vmax;
		height: 46vmax;
		top: -18vmax;
		right: -20vmax;
		background: radial-gradient(
			closest-side,
			color-mix(in oklab, var(--color-signal-2) 9%, transparent),
			transparent
		);
		animation-duration: 46s;
		animation-direction: reverse;
	}

	:global(:root.dark) .ambient__glow--a {
		background: radial-gradient(
			closest-side,
			color-mix(in oklab, var(--color-signal) 17%, transparent),
			transparent
		);
	}

	.skip-link {
		position: fixed;
		top: 0.75rem;
		left: 0.75rem;
		z-index: 1000;
		padding: 0.5rem 0.875rem;
		background-color: var(--color-ink-primary);
		color: var(--color-paper);
		font-family: var(--font-mono);
		font-size: var(--text-xs);
		letter-spacing: var(--tracking-wider);
		text-transform: uppercase;
		border-radius: var(--radius-md);
		transform: translateY(-160%);
		transition: transform var(--duration-base) var(--ease-out-expo);
	}

	.skip-link:focus-visible {
		transform: translateY(0);
		color: var(--color-paper);
	}

	.app-body {
		overflow-x: clip;
	}

	@media (prefers-reduced-motion: reduce) {
		.ambient__glow {
			animation: none;
		}
	}
</style>
